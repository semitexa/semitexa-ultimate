{
    "name": "semitexa/ultimate",
    "description": "Semitexa Ultimate - full-stack project skeleton for SSR applications with docs and core modules",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Registry\\": "src/registry/",
            "Semitexa\\Ultimate\\": "src/"
        },
        "exclude-from-classmap": [
            "/src/modules/"
        ]
    },
    "require": {
        "php": "^8.4",
        "semitexa/core": "2026.10.29.1052",
        "semitexa/update": "2026.10.29.1052",
        "semitexa/docs": "2026.10.29.1052",
        "semitexa/auth": "2026.10.29.1052",
        "semitexa/authorization": "2026.10.29.1052",
        "semitexa/rbac": "2026.10.29.1052",
        "semitexa/api": "2026.10.29.1052",
        "semitexa/webhooks": "2026.10.29.1052",
        "semitexa/workflow": "2026.10.29.1052",
        "semitexa/cache": "2026.10.29.1052",
        "semitexa/storage": "2026.10.29.1052",
        "semitexa/ssr": "2026.10.29.1052",
        "semitexa/dev": "2026.10.29.1052",
        "semitexa/tenancy": "2026.10.29.1052",
        "semitexa/locale": "2026.10.29.1052",
        "semitexa/orm": "2026.10.29.1052",
        "semitexa/search": "2026.10.29.1052",
        "semitexa/mail": "2026.10.29.1052",
        "semitexa/media": "2026.10.29.1052",
        "semitexa/llm": "2026.10.29.1052",
        "semitexa/prompt": "2026.10.08.0620",
        "semitexa/scheduler": "2026.10.29.1052",
        "semitexa/ledger": "2026.10.29.1052",
        "semitexa/project-graph": "2026.10.29.1052",
        "semitexa/theme": "2026.10.29.1052",
        "semitexa/platform-ui": "2026.10.29.1052",
        "semitexa/platform-user": "2026.10.29.1052",
        "semitexa/platform-settings": "2026.10.29.1052",
        "semitexa/crud": "2026.10.29.1052"
    },
    "require-dev": {
        "phpstan/phpstan": "2.1.40",
        "phpunit/phpunit": "^10.5",
        "semitexa/testing": "2026.10.29.1052"
    },
    "config": {
        "allow-plugins": {
            "semitexa/core": true
        }
    },
    "keywords": [
        "semitexa",
        "ultimate",
        "project-skeleton",
        "ssr",
        "twig",
        "frontend",
        "starter-kit"
    ],
    "scripts": {
        "phpstan": "docker compose exec -T app ./vendor/bin/phpstan analyse --memory-limit=1G",
        "phpstan:strict": "docker compose exec -T app ./vendor/bin/phpstan analyse --memory-limit=1G -c phpstan-strict.neon"
    },
    "scripts-descriptions": {
        "phpstan": "Analyse src/ at level max with Semitexa's architecture rules. Runs in the app container: a host PHP differs from the runtime, and the rules resolve framework classes out of vendor/.",
        "phpstan:strict": "The same analysis with reportUnmatchedIgnoredErrors. Fails when a phpstan-baseline.neon entry no longer matches a real error, which is what stops a baseline from becoming a place new errors land."
    }
}
