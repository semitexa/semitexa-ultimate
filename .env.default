# Environment: dev, test, prod
APP_ENV=dev
APP_DEBUG=1
APP_NAME="Semitexa App"

# Swoole server
SWOOLE_HOST=0.0.0.0
SWOOLE_PORT={{ default_swoole_port }}
SWOOLE_WORKER_NUM=4
SWOOLE_MAX_REQUEST=10000
SWOOLE_MAX_COROUTINE=100000
SWOOLE_LOG_FILE=var/log/swoole.log
SWOOLE_LOG_LEVEL=1
# Log rotation. Preferred named values: single|monthly|daily|hourly|every-minute.
# Swoole's own numeric form (0-4) and 'off' are accepted as aliases.
# Anything but 'single' makes Swoole write to <SWOOLE_LOG_FILE>.<date> and
# leave the configured file empty; `semitexa logs:app --file=swoole` follows it.
SWOOLE_LOG_ROTATION=daily
# Rotated logs older than this are deleted at server start; 0 disables the
# sweep entirely. The live log is never deleted in either case, and neither
# are rotated files another tool produced (only Swoole's own <date> suffix).
SWOOLE_LOG_RETENTION_DAYS=14
# Swoole tracer (>= 6.2): report internal calls that block a coroutine longer
# than SWOOLE_BLOCKING_THRESHOLD µs with a backtrace on stdout. Diagnostic
# tool — enable per-session in .env, not permanently (worker overhead).
SWOOLE_BLOCKING_DETECTION=Off
SWOOLE_BLOCKING_THRESHOLD=100000

# PHP memory limit for the long-lived Swoole worker. Unlike a request-per-process
# SAPI, one worker holds every open SSE session, its queues and its subscription
# state for its whole life, so PHP's 128M default is too tight: the worker dies
# with exit 255 under load and every route it served starts timing out, including
# ones unrelated to SSE.
#
# This value is the baseline: bin/semitexa merges .env.default with .env and
# exports the result before invoking Compose, so the setting below takes effect
# on the normal path. Put machine-specific overrides in .env, which wins.
#
# One distinction worth keeping straight: env_file loads BOTH files into the
# container environment, but `${...}` interpolation is a separate mechanism that
# does not read .env.default. So on a bare `docker compose` invocation the
# worker command falls back to the default in docker-compose.yml, even though
# the variable itself is still present inside the container.
PHP_MEMORY_LIMIT=512M

# Swoole shared memory tables (allocated upfront: rows × max_bytes)
# Increase for high-load or large session payloads.
# SWOOLE_SESSION_TABLE_SIZE=4096
# SWOOLE_SESSION_MAX_BYTES=65535
# SWOOLE_SSE_WORKER_TABLE_SIZE=4096
# SWOOLE_SSE_DELIVER_TABLE_SIZE=8192
# SWOOLE_SSE_PAYLOAD_MAX_BYTES=65535

# Session (Swoole Table). Cookie name and lifetime in seconds.
# SESSION_COOKIE_NAME=semitexa_session
# SESSION_LIFETIME=3600
#
# Whether the session and XSRF cookies carry Secure.
#   auto (default) - follow the request scheme;
#   always         - an HTTPS-only deployment, independent of scheme detection;
#   never          - plain HTTP on purpose.
# SESSION_COOKIE_SECURE=auto

# HTTP Strict Transport Security. OFF unless HSTS_MAX_AGE is set.
#
# Off by default on purpose. A server CAN withdraw it -- send max-age=0 over
# working HTTPS and the browser forgets -- but that rollback only arrives over a
# connection the browser will still make. A browser that has seen max-age refuses
# plaintext to this host for the full duration, from its OWN cache, so if the
# certificate lapses there is no HTTPS to carry the withdrawal and no plaintext
# fallback to reach: visitors are locked out of a site you control, and nothing
# you change on the server reaches them until the certificate is valid again.
#
# Start short, confirm, then raise:
#   HSTS_MAX_AGE=300          # five minutes, while you check
#   HSTS_MAX_AGE=31536000     # one year, once you trust renewal
#   HSTS_MAX_AGE=0            # the withdrawal -- sends max-age=0, browsers forget
#
# Rolling back means SETTING zero, not removing the variable: removing it stops
# sending the header, and a policy a browser has already cached stands until it
# expires on its own. Leave the zero in place until the longest max-age you ever
# sent has run out for your visitors.
# Confirm with:
#   curl -sS -D - -o /dev/null https://your-host/ | grep -i '^strict-transport-security:'
# (-o /dev/null and the ^ anchor matter: without them the page body is searched
# too, so a page that merely mentions the header reads as a pass.)
#
# It is NOT gated on the detected request scheme, deliberately -- see
# TRUSTED_PROXIES below for why that would fail silently. Setting it is how the
# deployment says it is HTTPS; browsers ignore the header over plaintext.
# HSTS_MAX_AGE=

# Applies the policy to every subdomain, present and future. Each must serve
# valid HTTPS from the moment a browser first sees this.
# HSTS_INCLUDE_SUBDOMAINS=false

# Asks to be added to the browsers' built-in preload list. Effectively
# PERMANENT -- removal takes months and is not guaranteed -- and requires
# HSTS_INCLUDE_SUBDOMAINS=true with HSTS_MAX_AGE=31536000. Neither is added for
# you; `bin/semitexa system:doctor` says when the combination will be rejected.
# HSTS_PRELOAD=false

# Reverse proxies allowed to set X-Forwarded-Proto / -Host / -For.
#
# Comma-separated IPs and/or CIDR blocks. Loopback is always trusted, so a proxy
# on the same host needs nothing here -- but a proxy in ANOTHER CONTAINER is not
# loopback, and that is the topology the shipped compose files use. Leave this
# empty there and the app never learns the request was HTTPS: every generated
# URL comes out http://, and the session and XSRF cookies lose their Secure
# flag, silently.
#
# `bin/semitexa system:doctor` fails the http.forwarded-proxy-trust check when
# APP_URL says https and this is empty. Confirm a fix with:
#   curl -sS -D - -o /dev/null https://your-host/ | grep -i '^set-cookie:'
# Every line printed should contain `Secure`, and NO output at all means no
# cookie was set -- which is not a pass. (-o /dev/null and the ^ anchor matter:
# without them the page body is searched too, and a page that merely mentions
# set-cookie reads as a result.)
#
# THE VALUE BELOW IS AN EXAMPLE, NOT A DEFAULT. Replace it with the address your
# proxy actually has: nothing pins the compose network to 172.18.0.0/16, Docker
# assigns it, and a CIDR that does not contain the proxy trusts nothing --
# leaving the silent failure above in place while looking configured.
#
# And keep the range as narrow as the topology allows. Everything inside it is
# believed about X-Forwarded-Proto, X-Forwarded-Host and X-Forwarded-For, so a
# whole shared bridge means every container on it -- including one that is only
# there to run somebody's job -- can tell this app what scheme, host and client
# IP a request had. The proxy's own address (172.18.0.7) is the honest value;
# use a CIDR only for a network that contains proxies and nothing else.
# TRUSTED_PROXIES=172.18.0.0/16

# CORS
CORS_ALLOW_ORIGIN=*
CORS_ALLOW_METHODS=GET, POST, PUT, DELETE, OPTIONS
CORS_ALLOW_HEADERS=Content-Type, Authorization
CORS_ALLOW_CREDENTIALS=false

# Theme
INJECT_HEAD=""
INJECT_BODY=""

# Enable the starter project's deferred SSR demo out of the box.
SSR_ISOMORPHIC_ENABLED=true
# Keep the Hello starter cards visibly deferred so the fresh install clearly
# demonstrates Semitexa's KISS streaming path.
HELLO_DEMO_DELAY=1
# Keep the demo deferred page visibly staggered so slot arrivals are easy to inspect.
DEMO_DEFERRED_DELAY=1

# Keep the deferred KISS stream available after the initial block delivery so
# authorized users can reuse the same connection for ongoing runtime features.
SSR_DEFERRED_PERSISTENT_SSE=true
SSR_DEFERRED_PERSISTENT_SSE_REQUIRE_AUTH=true

# Optional crawler hints for the auto-generated robots.txt fallback.
# ROBOTS_SITEMAP_URL=https://example.com/sitemap.xml
# ROBOTS_HOST=example.com
# AI_SITEMAP_URL=https://example.com/sitemap.json

# Events: 1 = NATS/JetStream (use with Docker), 0 = in-memory
# In Docker, bin/semitexa server:start enables docker-compose.nats.yml automatically
# and rewrites NATS_PRIMARY_URL to the nats service.
# EVENTS_ASYNC=0
# NATS_PRIMARY_URL=nats://127.0.0.1:4222
# NATS_SECONDARY_URL=

# Database (ORM) — uncomment to enable MySQL container on server:start
# For Docker, docker-compose.mysql.yml rewrites DB_HOST to the mysql service.
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=semitexa
# DB_USERNAME=root
# DB_PASSWORD=
# DB_POOL_SIZE=10
# DB_CHARSET=utf8mb4

# Database (ORM) — SQLite (no Docker container needed, file-based)
# DB_DRIVER=sqlite
# DB_SQLITE_PATH=var/database/semitexa.sqlite

# Database (ORM) — SQLite in-memory (testing only, data lost on restart)
# DB_DRIVER=sqlite
# DB_SQLITE_MEMORY=1

# Database (ORM) — dedicated SQLite connection for semitexa-ledger
# Keeps ledger ownership/storage isolated from the primary application DB.
# DB_LEDGER_DRIVER=sqlite
# DB_LEDGER_SQLITE_PATH=var/ledger/ledger.sqlite

# Redis — uncomment to enable Redis container on server:start
# For Docker, docker-compose.redis.yml rewrites REDIS_HOST to the redis service.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────────────────
# LLM (AI) — three modes: disabled (default), local Ollama, or remote Ollama.
#
# The local Ollama Docker container (docker-compose.ollama.yml) starts ONLY
# when LLM_PROVIDER=ollama is uncommented below. Otherwise the container is
# skipped to save RAM and CPU.
#
# Mode 1 — Disabled (default)
#   Leave everything commented. No LLM features are available.
#
# Mode 2 — Local Ollama (runs ollama/ollama:0.5.7 in Docker)
#   Uncomment LLM_PROVIDER, LLM_BASE_URL, LLM_MODEL, LLM_TIMEOUT.
#   After server:start, pull a model inside the container:
#     docker compose exec ollama ollama pull gemma3:4b
#   Available models: gemma3:4b (~3 GB), gemma3:12b (~8 GB),
#     llama3.2:3b (~2 GB), llama3.2:8b (~5 GB), mistral:7b (~4 GB),
#     phi4:14b (~9 GB).
#
# Mode 3 — Remote Ollama (external Ollama instance, NO local Docker container)
#   Uncomment LLM_BACKEND=remote_ollama and the LLM_REMOTE_* variables.
#   The local ollama/ollama container will NOT start, saving significant RAM.
#   Point LLM_REMOTE_OLLAMA_URL to any reachable Ollama server (LAN, VPS, etc.).
# ─────────────────────────────────────────────────────────────────────────────

# --- Mode 2: Local Ollama (Docker) ---
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://ollama:11434
# LLM_MODEL=gemma3:4b
# LLM_TIMEOUT=60

# --- Mode 3: Remote Ollama (external server, no local container) ---
# LLM_BACKEND=remote_ollama
# LLM_REMOTE_OLLAMA_URL=http://your-ollama-server:11434
# LLM_REMOTE_OLLAMA_MODEL=gemma3:4b
# LLM_REMOTE_OLLAMA_TIMEOUT=120
# LLM_REMOTE_OLLAMA_RETRIES=2

# ─────────────────────────────────────────────────────────────────────────────
# NATS Event Ledger (semitexa-ledger)
#
# Enables cross-node event propagation via NATS JetStream + a local SQLite
# append-only ledger per node. Required for multi-node deployments.
#
# LEDGER_NODE_ID   — unique identifier for this node (e.g. "store-a", "node-1").
#                    Must be distinct across every process in the cluster.
# LEDGER_HMAC_KEY  — secret used to HMAC-sign each ledger entry for tamper
#                    evidence. Use a long random string (32+ chars). Must be
#                    the same value on every node in the cluster.
# LEDGER_DB_PATH   — path to the per-node SQLite ledger file.
#                    Defaults to /var/lib/semitexa/ledger/{node_id}.sqlite
#
# NATS_PRIMARY_URL     — primary NATS server with JetStream enabled.
#                        Also accepted as NATS_URL.
# NATS_SECONDARY_URL   — optional second NATS cluster for HA failover.
#                        When set, each node publishes to primary first and
#                        falls back to secondary; both are consumed for
#                        split-brain convergence.
#
# ─────────────────────────────────────────────────────────────────────────────

# LEDGER_NODE_ID=node-1
# LEDGER_HMAC_KEY=change-me-use-a-long-random-secret
# LEDGER_DB_PATH=var/ledger/node-1.sqlite
# LEDGER_DB_CONNECTION=ledger

# NATS_PRIMARY_URL=nats://127.0.0.1:4222
# NATS_SECONDARY_URL=nats://127.0.0.1:4223

# ─────────────────────────────────────────────────────────────────────────────
# Media & webhooks — safety limits
# ─────────────────────────────────────────────────────────────────────────────
#
# MEDIA_MAX_IMAGE_PIXELS        — largest image (width x height, summed over all
#                                 frames) accepted for processing. Read from the
#                                 file header before decoding, so a small file
#                                 declaring a huge size cannot exhaust memory.
#                                 ImageMagick Q16 needs ~8 bytes per pixel.
# WEBHOOK_ALLOW_PRIVATE_TARGETS — allow outbound webhooks to loopback/private/
#                                 link-local addresses (development receivers).
#                                 Keep false in production.
#
# ─────────────────────────────────────────────────────────────────────────────

# MEDIA_MAX_IMAGE_PIXELS=100000000
# WEBHOOK_ALLOW_PRIVATE_TARGETS=false
