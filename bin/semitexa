#!/bin/sh
# ─────────────────────────────────────────────────────────────────────────────
# Semitexa CLI — universal entry point (POSIX shell, no PHP required on host)
#
# Usage:  bin/semitexa <command> [arguments...]
#
# Server lifecycle commands (server:start, server:stop, server:restart) are
# handled natively in this shell script via Docker Compose.
#
# Local routing commands (local-router:* and local-domain:*) manage the shared
# Semitexa workstation router for .test domains.
#
# All other commands are proxied into the running "app" container so PHP
# execution always uses the exact same runtime that powers the framework.
#
# Compatible with: macOS, Linux, Windows (Git Bash / WSL / MSYS2)
# Architecture:    AMD64 and ARM64 (Apple Silicon, Raspberry Pi, etc.)
# ─────────────────────────────────────────────────────────────────────────────
set -e

# ── Resolve project root (follow symlinks, works on macOS + Linux) ──────────
resolve_script_dir() {
    _source="$0"
    while [ -L "$_source" ]; do
        _dir="$(cd -P "$(dirname "$_source")" && pwd)"
        _source="$(readlink "$_source")"
        case "$_source" in
            /*) ;;
            *)  _source="$_dir/$_source" ;;
        esac
    done
    cd -P "$(dirname "$_source")" && pwd
}

SCRIPT_DIR="$(resolve_script_dir)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$PROJECT_ROOT" || {
    printf '[ERROR] Failed to enter project root: %s\n' "$PROJECT_ROOT" >&2
    exit 1
}

# ── Colour helpers (safe for non-tty / Windows) ────────────────────────────
if [ -t 1 ] && command -v tput >/dev/null 2>&1; then
    C_RESET="$(tput sgr0 2>/dev/null || true)"
    C_GREEN="$(tput setaf 2 2>/dev/null || true)"
    C_YELLOW="$(tput setaf 3 2>/dev/null || true)"
    C_RED="$(tput setaf 1 2>/dev/null || true)"
    C_CYAN="$(tput setaf 6 2>/dev/null || true)"
    C_BOLD="$(tput bold 2>/dev/null || true)"
else
    C_RESET="" C_GREEN="" C_YELLOW="" C_RED="" C_CYAN="" C_BOLD=""
fi

info()    { printf "%s[INFO]%s  %s\n"    "$C_CYAN"   "$C_RESET" "$*"; }
success() { printf "%s[OK]%s    %s\n"    "$C_GREEN"  "$C_RESET" "$*"; }
warn()    { printf "%s[WARN]%s  %s\n"    "$C_YELLOW" "$C_RESET" "$*" >&2; }
error()   { printf "%s[ERROR]%s %s\n"    "$C_RED"    "$C_RESET" "$*" >&2; }

# ── Env readers (.env.default + .env) ───────────────────────────────────────
env_existing_files_low_to_high() {
    for _file in \
        "$PROJECT_ROOT/.env.default" \
        "$PROJECT_ROOT/.env"
    do
        [ -f "$_file" ] && printf '%s\n' "$_file"
    done
}

env_runtime_file_exists() {
    for _file in "$PROJECT_ROOT/.env.default" "$PROJECT_ROOT/.env"; do
        [ -f "$_file" ] && return 0
    done
    return 1
}

env_merged_lines() {
    _files="$(env_existing_files_low_to_high | tr '\n' ' ')"
    [ -n "$_files" ] || return 0

    # shellcheck disable=SC2086
    awk '
        /^[[:space:]]*#/ || /^[[:space:]]*$/ || index($0, "=") == 0 { next }
        {
            line = $0
            sub(/\r$/, "", line)
            key = line
            sub(/[[:space:]]*=.*$/, "", key)
            gsub(/[[:space:]]/, "", key)
            if (key !~ /^[A-Za-z_][A-Za-z0-9_]*$/) {
                next
            }
            values[key] = line
            if (!(key in first_seen)) {
                order[++count] = key
                first_seen[key] = 1
            }
        }
        END {
            for (i = 1; i <= count; i++) {
                key = order[i]
                if (!(key in printed) && (key in values)) {
                    print values[key]
                    printed[key] = 1
                }
            }
        }
    ' $_files
}

env_val() {
    _key="$1"
    _default="$2"
    _val="$(env_merged_lines 2>/dev/null | grep -E "^[[:space:]]*${_key}[[:space:]]*=" 2>/dev/null | head -1 | sed 's/^[^=]*=[[:space:]]*//' | sed 's/[[:space:]]*$//' | sed -e 's/^"\(\([^"]*[^"\\]\)\{0,1\}\)"[[:space:]]\{1,\}#.*$/\1/' -e t -e 's/^"\(.*\)"$/\1/' -e t -e '/^"/b' -e "s/^'\([^']*\)'[[:space:]]\{1,\}#.*\$/\1/" -e t -e "s/^'\(.*\)'\$/\1/" -e t -e "/^'/b" -e 's/[[:space:]]#.*$//' -e 's/[[:space:]]*$//')"
    if [ -n "$_val" ]; then
        printf '%s' "$_val"
        return
    fi
    printf '%s' "$_default"
}

# Rootless Docker (or Podman) maps the container's root to the host user, so
# there the right service user is 0:0: any other uid lands on a subordinate id
# the developer cannot read. Asked once per process.
docker_is_rootless() {
    if [ -z "${_SEMITEXA_ROOTLESS:-}" ]; then
        # The connected engine's own mode: a rootless Podman service reports
        # it here too, and a rootful one (the client name says nothing) does not.
        case "$(docker info --format '{{json .SecurityOptions}}' 2>/dev/null)" in
            *rootless*) _SEMITEXA_ROOTLESS=1 ;;
            *) _SEMITEXA_ROOTLESS=0 ;;
        esac
    fi
    [ "$_SEMITEXA_ROOTLESS" = 1 ]
}

env_export_compose_context() {
    # docker-compose.yml runs the app and scheduler as SEMITEXA_UID:SEMITEXA_GID,
    # so whatever the server or a CLI command (`compose exec` takes the
    # service's user) writes into the bind-mounted project belongs to the
    # developer instead of root. Precedence: the caller's environment, then
    # .env, then the host user (0:0 under rootless Docker, where that IS the
    # host user). Running as root keeps root.
    _caller_uid="${SEMITEXA_UID:-}"
    _caller_gid="${SEMITEXA_GID:-}"
    _merged="$(env_merged_lines || true)"

    if [ -n "$_merged" ]; then
        _old_ifs=$IFS
        IFS='
'
        for _line in $_merged; do
            [ -n "$_line" ] || continue
            _key="$(printf '%s' "$_line" | sed 's/[[:space:]]*=.*$//' | tr -d '[:space:]')"
            _val="$(printf '%s' "$_line" | sed 's/^[^=]*=[[:space:]]*//' | sed 's/[[:space:]]*$//' | sed -e 's/^"\(\([^"]*[^"\\]\)\{0,1\}\)"[[:space:]]\{1,\}#.*$/\1/' -e t -e 's/^"\(.*\)"$/\1/' -e t -e '/^"/b' -e "s/^'\([^']*\)'[[:space:]]\{1,\}#.*\$/\1/" -e t -e "s/^'\(.*\)'\$/\1/" -e t -e "/^'/b" -e 's/[[:space:]]#.*$//' -e 's/[[:space:]]*$//')"
            case "$_key" in
                ''|*[!A-Za-z0-9_]*)
                    continue
                    ;;
            esac
            export "$_key=$_val"
        done
        IFS=$_old_ifs
    fi

    [ -z "$_caller_uid" ] || SEMITEXA_UID="$_caller_uid"
    [ -z "$_caller_gid" ] || SEMITEXA_GID="$_caller_gid"
    if [ -z "${SEMITEXA_UID:-}" ] || [ -z "${SEMITEXA_GID:-}" ]; then
        if docker_is_rootless; then
            _default_uid=0; _default_gid=0
        else
            _default_uid="$(id -u)"; _default_gid="$(id -g)"
        fi
        SEMITEXA_UID="${SEMITEXA_UID:-$_default_uid}"
        SEMITEXA_GID="${SEMITEXA_GID:-$_default_gid}"
    fi
    export SEMITEXA_UID SEMITEXA_GID

    # Agent presence: one store for every project on this machine, beside the
    # router registry. A per-project store hid an agent started in one project
    # from the project whose packages it was editing (2026-10-17). Created here,
    # as the host user: compose would create a missing bind source as root.
    # Inside the container every project is /var/www/html, so its host path
    # travels along to tell the projects' sessions apart.
    # Unusable: the project's own var/ai-work/agents, silently, as this runs on
    # every compose call; `ai:agent list` names the store it reads.
    # Owner only: it sits in the user's home, and another local user must not
    # forge or end sessions there. A planted symlink is not followed.
    # The path compose mounts is always absolute (a bare name is a volume) and
    # always exported: unset, compose would read a rejected value from .env.
    # The fallback is created here too, as the host user, not by Docker as root.
    _agents_dir="${SEMITEXA_AGENTS_HOST_DIR:-${SEMITEXA_HOME:-$HOME/.semitexa}/agents}"
    # Owner only works only when the services run as that owner (or as root):
    # a different SEMITEXA_UID could not write a 0700 store at all.
    # Narrowed to owner only when this creates it; one that was already there
    # keeps its mode and is used only if it is owner only already: a store named
    # in .env may be a directory other people rely on.
    _agents_new=0
    { [ -e "$_agents_dir" ] || [ -L "$_agents_dir" ]; } || _agents_new=1
    if { [ "$SEMITEXA_UID" = "0" ] || [ "$SEMITEXA_UID" = "$(id -u)" ]; } \
        && [ ! -L "$_agents_dir" ] && mkdir -p "$_agents_dir" 2>/dev/null && [ -O "$_agents_dir" ] \
        && if [ "$_agents_new" = 1 ]; then chmod 700 "$_agents_dir" 2>/dev/null; else
            case "$(ls -ld "$_agents_dir" 2>/dev/null)" in d???------*) true ;; *) false ;; esac; fi \
        && [ -w "$_agents_dir" ]; then
        SEMITEXA_AGENTS_HOST_DIR="$(cd "$_agents_dir" && pwd -P)"
    else
        SEMITEXA_AGENTS_HOST_DIR="$PROJECT_ROOT/var/ai-work/agents"
        mkdir -p "$SEMITEXA_AGENTS_HOST_DIR" 2>/dev/null || true
        # Services under a SEMITEXA_UID that is neither root nor the host user
        # could not write a host-owned store: only then is it opened to all,
        # as the presence store does itself. Otherwise its mode is left alone.
        # Never through a link, here or in a parent: it could lead to the
        # machine-wide store, which must stay owner only.
        if [ "$SEMITEXA_UID" != "0" ] && [ "$SEMITEXA_UID" != "$(id -u)" ] && [ ! -L "$SEMITEXA_AGENTS_HOST_DIR" ] \
            && [ -O "$SEMITEXA_AGENTS_HOST_DIR" ] \
            && [ "$(cd "$SEMITEXA_AGENTS_HOST_DIR" 2>/dev/null && pwd -P)" = "$(cd "$PROJECT_ROOT" 2>/dev/null && pwd -P)/var/ai-work/agents" ]; then
            chmod 777 "$SEMITEXA_AGENTS_HOST_DIR" 2>/dev/null || true
        fi
    fi
    export SEMITEXA_AGENTS_HOST_DIR
    SEMITEXA_HOST_PROJECT_ROOT="$PROJECT_ROOT"
    export SEMITEXA_HOST_PROJECT_ROOT
}

# ── Docker Compose helpers ──────────────────────────────────────────────────
has_compose() {
    docker compose version >/dev/null 2>&1 && return 0
    docker-compose version >/dev/null 2>&1 && return 0
    return 1
}

compose_bin() {
    if docker compose version >/dev/null 2>&1; then
        echo "docker compose"
    elif docker-compose version >/dev/null 2>&1; then
        echo "docker-compose"
    else
        error "Docker Compose not found. Install Docker Desktop or docker-compose."
        exit 1
    fi
}

compose_args() {
    _args="-f docker-compose.yml"
    _has_overlay=0

    # The queue worker, in a container of its own: something is queued exactly
    # when EVENTS_ASYNC=1, whatever the transport (NATS or the database).
    # Before the override, so a project's docker-compose.override.yml can
    # The worker, in a container of its own: it runs what worker:processes
    # lists. The scheduler and webhook delivery poll the database and need no
    # broker, so it runs whatever EVENTS_ASYNC says; without async events the
    # queue consumers simply name nothing. Before the override, so a project's
    # docker-compose.override.yml can give it resources or more.
    if [ -f "$PROJECT_ROOT/docker-compose.worker.yml" ]; then
        _args="$_args -f docker-compose.worker.yml"; _has_overlay=1
    fi

    # Per-operator override — standard Docker Compose convention.
    # Explicit -f overrides compose's auto-discovery, so we must re-include it.
    if [ -f "$PROJECT_ROOT/docker-compose.override.yml" ]; then
        _args="$_args -f docker-compose.override.yml"
        _has_overlay=1
    fi

    if [ -f "$PROJECT_ROOT/docker-compose.nats.yml" ]; then
        _async="$(env_val EVENTS_ASYNC 0)"
        case "$_async" in 1|true|yes) _args="$_args -f docker-compose.nats.yml"; _has_overlay=1 ;; esac
    fi
    if [ -f "$PROJECT_ROOT/docker-compose.mysql.yml" ]; then
        # Only MySQL needs the bundled container; DB_DRIVER=sqlite runs without one.
        _db="$(env_val DB_DRIVER "")"
        if [ "$_db" = "mysql" ]; then _args="$_args -f docker-compose.mysql.yml"; _has_overlay=1; fi
    fi
    if [ -f "$PROJECT_ROOT/docker-compose.redis.yml" ]; then
        _redis="$(env_val REDIS_HOST "")"
        if [ -n "$_redis" ]; then _args="$_args -f docker-compose.redis.yml"; _has_overlay=1; fi
    fi
    if [ -f "$PROJECT_ROOT/docker-compose.ollama.yml" ]; then
        _llm_provider="$(env_val LLM_PROVIDER "")"
        if [ "$_llm_provider" = "ollama" ]; then _args="$_args -f docker-compose.ollama.yml"; _has_overlay=1; fi
    fi
    # External path-repo overlay. Loaded only when the operator has created
    # the project-root symlink `./semitexa.pl`. Mounts that path into the
    # phpunit / e2e-runner / app / scheduler services so vendor symlinks for
    # composer path-repo packages whose sources live outside the project
    # tree (currently semitexa/platform-ui) resolve identically on host and
    # in containers. See docker-compose.path-repos.yml header for details.
    if [ -f "$PROJECT_ROOT/docker-compose.path-repos.yml" ] && [ -L "$PROJECT_ROOT/semitexa.pl" ]; then
        _args="$_args -f docker-compose.path-repos.yml"
        _has_overlay=1
    fi
    if [ "$_has_overlay" -eq 0 ]; then
        echo ""
    else
        echo "$_args"
    fi
}

# Returns ALL compose files regardless of .env settings (for stop/cleanup).
compose_all_args() {
    _args="-f docker-compose.yml"
    for _overlay in docker-compose.worker.yml docker-compose.override.yml docker-compose.nats.yml docker-compose.mysql.yml docker-compose.redis.yml docker-compose.ollama.yml; do
        [ -f "$PROJECT_ROOT/$_overlay" ] && _args="$_args -f $_overlay"
    done
    echo "$_args"
}

# What the overlays set on the app, written to var/run/worker.env for the
# worker in docker-compose.worker.yml, which reads it last. That file cannot
# name the services itself: an overlay that is not loaded has no such
# service. The conditions are compose_args's, so the worker reaches what the
# app reaches. Rewritten on every compose call, so nothing stale is kept.
# Returns 1, and says why, when the file could not be written: one left from an
# earlier start may name services this one does not load.
compose_write_worker_env() {
    [ -f "$PROJECT_ROOT/docker-compose.worker.yml" ] || return 0
    _wenv="$PROJECT_ROOT/var/run/worker.env"
    if ! mkdir -p "$PROJECT_ROOT/var/run" 2>/dev/null || [ -d "$_wenv" ]; then
        warn "Cannot write $_wenv: the worker would start with the service addresses of an earlier start."
        return 1
    fi
    {
        echo "# Written by bin/semitexa: the services the overlays give the app."
        if [ -f "$PROJECT_ROOT/docker-compose.mysql.yml" ] && [ "$(env_val DB_DRIVER "")" = "mysql" ]; then
            echo "DB_HOST=mysql"; echo "DB_PORT=3306"
        fi
        if [ -f "$PROJECT_ROOT/docker-compose.redis.yml" ] && [ -n "$(env_val REDIS_HOST "")" ]; then
            echo "REDIS_HOST=redis"; echo "REDIS_PORT=6379"; echo "CACHE_DRIVER=$(env_val CACHE_DRIVER "${CACHE_DRIVER:-redis}")"
        fi
        if [ -f "$PROJECT_ROOT/docker-compose.nats.yml" ]; then
            case "$(env_val EVENTS_ASYNC 0)" in 1|true|yes) echo "NATS_PRIMARY_URL=nats://nats:4222" ;; esac
        fi
        if [ -f "$PROJECT_ROOT/docker-compose.ollama.yml" ] && [ "$(env_val LLM_PROVIDER "")" = "ollama" ]; then
            echo "LLM_BASE_URL=http://ollama:11434"
        fi
    } > "$_wenv.tmp.$$" 2>/dev/null && mv -f "$_wenv.tmp.$$" "$_wenv" 2>/dev/null && return 0
    rm -f "$_wenv.tmp.$$" 2>/dev/null
    warn "Cannot write $_wenv: the worker would start with the service addresses of an earlier start."
    return 1
}

run_compose() {
    _compose="$(compose_bin)"
    _overlays="$(compose_args)"
    (
        env_export_compose_context
        # Every up and run goes through here: the worker gets the overlays' values.
        # Starting it with stale ones is refused; stop, logs and the rest go on.
        if ! compose_write_worker_env && [ "${1:-}" = up ]; then
            exit 1
        fi
        if [ -n "$_overlays" ]; then
            # shellcheck disable=SC2086
            $_compose $_overlays "$@"
        else
            $_compose "$@"
        fi
    )
}

is_app_running() {
    _compose="$(compose_bin)"
    _overlays="$(compose_args)"
    _status="$(
        env_export_compose_context
        if [ -n "$_overlays" ]; then
            # shellcheck disable=SC2086
            $_compose $_overlays ps --format '{{.State}}' app 2>/dev/null || true
        else
            $_compose ps --format '{{.State}}' app 2>/dev/null || true
        fi
    )"
    case "$_status" in
        *running*) return 0 ;;
        *)         return 1 ;;
    esac
}

wait_for_service() {
    _service_name="$1" _host="$2" _port="$3" _max_attempts="$4" _delay="$5" _initial_wait="${6:-0}"

    if [ "$_initial_wait" -gt 0 ]; then
        info "Waiting ${_initial_wait}s for $_service_name to initialise..."
        sleep "$_initial_wait"
    fi

    _attempt=1
    while [ "$_attempt" -le "$_max_attempts" ]; do
        if run_compose exec -T app sh -c "
            (echo > /dev/tcp/$_host/$_port) 2>/dev/null ||
            nc -z $_host $_port 2>/dev/null ||
            timeout 3 sh -c \"cat < /dev/null > /dev/tcp/$_host/$_port\" 2>/dev/null
        " >/dev/null 2>&1; then
            success "$_service_name: reachable"
            return 0
        fi
        _attempt=$((_attempt + 1))
        [ "$_attempt" -le "$_max_attempts" ] && sleep "$_delay"
    done

    warn "$_service_name: not reachable after $_max_attempts attempts (may still be starting)"
    return 1
}

# MySQL answers within seconds on a warm volume and in up to ~40 s on a first
# init. Polled from the start, every 2 s for 40 s: it used to sleep 20 s before
# the first look, so every server:start waited 20 s on a database that had been
# up all along (bench-server-start-sleeps-20s). The ceiling is the same.
wait_for_mysql() {
    wait_for_service "MySQL" "mysql" "3306" 20 2 0 && verify_mysql_auth
}

# A TCP-reachable MySQL is NOT proof the app can use it. `mysql_data` is a
# project-scoped Docker named volume that SURVIVES deleting/recreating the
# project dir, so a "fresh" re-install of the same dir name silently inherits a
# pre-existing database — and if that volume was initialised with different
# credentials than the current .env, the app gets "Access denied" while the port
# still answers. A plain port check reports a false-green here. Verify the
# configured user can actually authenticate (retried, since on a genuinely fresh
# init the port opens a moment before the user is created).
verify_mysql_auth() {
    # Use the APP's configured credentials (works whether the compose creates a
    # dedicated app user or only root), passed into the mysql container via -e so
    # special characters survive. A stale volume rejects them; a correct one
    # accepts (`%` host grants match the in-container connection too).
    _vu="$(env_val DB_USERNAME "root")"
    _vp="$(env_val DB_PASSWORD "")"
    _att=1
    while [ "$_att" -le 6 ]; do
        if run_compose exec -T -e _VCHK_U="$_vu" -e _VCHK_P="$_vp" mysql \
            sh -c 'MYSQL_PWD="$_VCHK_P" mysql -u"$_VCHK_U" -e "SELECT 1" >/dev/null 2>&1'; then
            success "MySQL: credentials verified"
            return 0
        fi
        _att=$((_att + 1))
        [ "$_att" -le 6 ] && sleep 3
    done
    _proj="$(basename "$PROJECT_ROOT")"
    warn "MySQL: port is reachable but the configured user CANNOT authenticate."
    warn "  This is almost always a STALE MySQL data volume — initialised with"
    warn "  different credentials than the current .env. The named volume"
    warn "  '${_proj}_mysql_data' persists across deleting/recreating the project"
    warn "  dir, so a fresh install does NOT reset the database. Reset it with:"
    warn "    bin/semitexa server:stop"
    warn "    docker volume rm '${_proj}_mysql_data'"
    warn "    bin/semitexa server:start"
    return 1
}

# ── Shared local router helpers ─────────────────────────────────────────────
SEMITEXA_HOME="${SEMITEXA_HOME:-$HOME/.semitexa}"
ROUTER_ROOT="$SEMITEXA_HOME/router"
ROUTER_COMPOSE="$ROUTER_ROOT/docker-compose.yml"
ROUTER_MODE_FILE="$ROUTER_ROOT/mode"
ROUTER_REGISTRY_DIR="$ROUTER_ROOT/registry/domains"
ROUTER_NGINX_DIR="$ROUTER_ROOT/nginx/generated"
ROUTER_DNS_DIR="$ROUTER_ROOT/dns/generated"
ROUTER_NGINX_DEFAULT="$ROUTER_NGINX_DIR/default.conf"
ROUTER_NGINX_DOMAINS="$ROUTER_NGINX_DIR/domains.conf"
ROUTER_DNSMASQ_CONF="$ROUTER_DNS_DIR/dnsmasq.conf"
ROUTER_DNS_DOMAINS="$ROUTER_DNS_DIR/domains.conf"

router_ensure_dirs() {
    mkdir -p "$ROUTER_ROOT" "$ROUTER_REGISTRY_DIR" "$ROUTER_NGINX_DIR" "$ROUTER_DNS_DIR"
}

router_entry_key() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9.-' '_'
}

router_entry_path() {
    printf '%s/%s.env' "$ROUTER_REGISTRY_DIR" "$(router_entry_key "$1")"
}

router_mode_get() {
    if [ -f "$ROUTER_MODE_FILE" ]; then
        _mode="$(tr -d '[:space:]' < "$ROUTER_MODE_FILE" 2>/dev/null || true)"
        case "$_mode" in dns|hosts) printf '%s' "$_mode"; return ;; esac
    fi
    printf 'dns'
}

router_mode_set() {
    _mode="$1"
    case "$_mode" in
        dns|hosts) ;;
        *)
            error "Unsupported local router mode: $_mode"
            exit 1
            ;;
    esac
    router_ensure_dirs
    printf '%s\n' "$_mode" > "$ROUTER_MODE_FILE"
}

router_validate_domain() {
    _domain="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
    case "$_domain" in
        *.test) ;;
        *) return 1 ;;
    esac
    _label="${_domain%.test}"
    [ -n "$_label" ] || return 1
    case "$_label" in
        *[!a-z0-9.-]*|-*|*-) return 1 ;;
    esac
    return 0
}

router_registry_write_entry() {
    _domain="$1"
    _upstream_port="$2"
    _mode="$3"
    _path="$(router_entry_path "$_domain")"
    _compose_project_name="$(basename "$PROJECT_ROOT")"
    # The container route (router_attach_project): given, or kept from this
    # project's existing entry, so a rewrite before the app is up does not
    # drop it. UPSTREAM_HOST/UPSTREAM_PORT stay as they were: an older
    # bin/semitexa elsewhere renders from them, and the port checks read them.
    _uc="${4:-}" _un="${5:-}" _ucp="${6:-}"
    if [ -z "$_uc" ] && [ -f "$_path" ]; then
        _uc="$(sed -n "s/^UPSTREAM_CONTAINER=//p" "$_path" | head -n 1)"
        _un="$(sed -n "s/^UPSTREAM_NETWORK=//p" "$_path" | head -n 1)"
        _ucp="$(sed -n "s/^UPSTREAM_CONTAINER_PORT=//p" "$_path" | head -n 1)"
        [ "$(sed -n "s/^PROJECT_ROOT=//p" "$_path" | head -n 1)" = "$PROJECT_ROOT" ] || { _uc=''; _un=''; _ucp=''; }
    fi

    router_ensure_dirs
    cat > "$_path" <<EOF
DOMAIN=$_domain
PROJECT_ROOT=$PROJECT_ROOT
COMPOSE_PROJECT_NAME=$_compose_project_name
UPSTREAM_HOST=host.docker.internal
UPSTREAM_PORT=$_upstream_port
MODE=$_mode
UPDATED_AT=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
EOF
    if [ -n "$_uc" ] && [ -n "$_un" ] && [ -n "$_ucp" ]; then
        printf 'UPSTREAM_CONTAINER=%s\nUPSTREAM_NETWORK=%s\nUPSTREAM_CONTAINER_PORT=%s\n' "$_uc" "$_un" "$_ucp" >> "$_path"
    fi
}

router_registry_delete_entry() {
    _domain="$1"
    rm -f "$(router_entry_path "$_domain")"
}

router_registry_count() {
    find "$ROUTER_REGISTRY_DIR" -maxdepth 1 -type f -name '*.env' 2>/dev/null | wc -l | tr -d ' '
}

router_collect_project_domains() {
    env_merged_lines 2>/dev/null \
        | grep -E '^[[:space:]]*[A-Z0-9_]*DOMAIN[A-Z0-9_]*[[:space:]]*=' 2>/dev/null \
        | while IFS= read -r _line; do
            _value="$(printf '%s' "$_line" | sed 's/^[^=]*=[[:space:]]*//' | sed 's/[[:space:]]*$//' | sed -e 's/^"\(\([^"]*[^"\\]\)\{0,1\}\)"[[:space:]]\{1,\}#.*$/\1/' -e t -e 's/^"\(.*\)"$/\1/' -e t -e '/^"/b' -e "s/^'\([^']*\)'[[:space:]]\{1,\}#.*\$/\1/" -e t -e "s/^'\(.*\)'\$/\1/" -e t -e "/^'/b" -e 's/[[:space:]]#.*$//' -e 's/[[:space:]]*$//')"
            printf '%s\n' "$_value" | tr ', ' '\n\n' | while IFS= read -r _candidate; do
                _candidate="$(printf '%s' "$_candidate" | tr '[:upper:]' '[:lower:]')"
                [ -n "$_candidate" ] || continue
                if router_validate_domain "$_candidate"; then
                    printf '%s\n' "$_candidate"
                fi
            done
        done | sort -u
}

router_sync_project_domains() {
    _domains="$(router_collect_project_domains || true)"
    [ -n "$_domains" ] || return 0

    _saved_project_root="$PROJECT_ROOT"
    _port="$(env_val SWOOLE_PORT 8080)"
    _mode="$(router_mode_get)"

    router_ensure_dirs

    for _entry in "$ROUTER_REGISTRY_DIR"/*.env; do
        [ -f "$_entry" ] || continue
        DOMAIN='' PROJECT_ROOT='' UPSTREAM_PORT='' MODE=''
        # shellcheck disable=SC1090
        . "$_entry"
        [ "$PROJECT_ROOT" = "$_saved_project_root" ] || continue
        if ! printf '%s\n' "$_domains" | grep -Fx -- "$DOMAIN" >/dev/null 2>&1; then
            rm -f "$_entry"
        fi
    done

    PROJECT_ROOT="$_saved_project_root"
    printf '%s\n' "$_domains" | while IFS= read -r _domain; do
        [ -n "$_domain" ] || continue
        router_registry_write_entry "$_domain" "$_port" "$_mode"
    done
    PROJECT_ROOT="$_saved_project_root"
}

router_project_domain_count() {
    _project_root="${1:-$PROJECT_ROOT}"
    _saved_project_root="$PROJECT_ROOT"
    _count=0
    for _entry in "$ROUTER_REGISTRY_DIR"/*.env; do
        [ -f "$_entry" ] || continue
        DOMAIN='' PROJECT_ROOT='' UPSTREAM_PORT='' MODE=''
        # shellcheck disable=SC1090
        . "$_entry"
        [ "$PROJECT_ROOT" = "$_project_root" ] || continue
        _count=$((_count + 1))
    done
    PROJECT_ROOT="$_saved_project_root"
    printf '%s' "$_count"
}

# Print domains registered in the shared router for the given project root,
# one per line, alphabetically sorted. Used by server:start to show the real
# URLs the project is reachable at instead of generic http://localhost:<port>.
router_list_project_domains() {
    _project_root="${1:-$PROJECT_ROOT}"
    _saved_project_root="$PROJECT_ROOT"
    for _entry in "$ROUTER_REGISTRY_DIR"/*.env; do
        [ -f "$_entry" ] || continue
        DOMAIN='' PROJECT_ROOT='' UPSTREAM_PORT='' MODE=''
        # shellcheck disable=SC1090
        . "$_entry"
        [ "$PROJECT_ROOT" = "$_project_root" ] || continue
        [ -n "$DOMAIN" ] || continue
        printf '%s\n' "$DOMAIN"
    done | sort
    PROJECT_ROOT="$_saved_project_root"
}

project_has_shared_domains() {
    [ "$(router_project_domain_count "$PROJECT_ROOT")" -gt 0 ] && return 0
    [ -n "$(router_collect_project_domains || true)" ]
}

# ── Local app registry + Swoole port broker ─────────────────────────────────
# Each installed Semitexa project registers itself in
#   ~/.semitexa/router/registry/apps/<app-id>.env
# and gets a unique, persisted Swoole port from a configurable range
# (default 9501-9599). Prevents host-port collisions when multiple Semitexa
# projects run on the same workstation.
ROUTER_APP_REGISTRY_DIR="$ROUTER_ROOT/registry/apps"
ROUTER_CONFIG_FILE="$ROUTER_ROOT/config.env"
ROUTER_LOCK_DIR="$ROUTER_ROOT/locks"

router_ensure_app_dirs() {
    mkdir -p "$ROUTER_APP_REGISTRY_DIR" "$ROUTER_LOCK_DIR"
}

# Best-effort lock via mkdir; gives up after ~5s. Workstation-only collisions
# are extremely rare; the lock just guards back-to-back installs.
router_lock_acquire() {
    router_ensure_app_dirs
    _lock="$ROUTER_LOCK_DIR/registry.lock"
    _waited=0
    while [ "$_waited" -lt 50 ]; do
        if mkdir "$_lock" 2>/dev/null; then
            return 0
        fi
        sleep 0.1 2>/dev/null || sleep 1
        _waited=$((_waited + 1))
    done
    return 0
}

router_lock_release() {
    rm -rf "$ROUTER_LOCK_DIR/registry.lock" 2>/dev/null || true
}

port_range_start() {
    if [ -f "$ROUTER_CONFIG_FILE" ]; then
        _v="$(grep -E '^[[:space:]]*SEMITEXA_LOCAL_PORT_RANGE_START[[:space:]]*=' "$ROUTER_CONFIG_FILE" 2>/dev/null | head -1 | sed 's/^[^=]*=[[:space:]]*//' | tr -d '[:space:]"')"
        case "$_v" in ''|*[!0-9]*) ;; *) printf '%s' "$_v"; return ;; esac
    fi
    printf '9501'
}

port_range_end() {
    if [ -f "$ROUTER_CONFIG_FILE" ]; then
        _v="$(grep -E '^[[:space:]]*SEMITEXA_LOCAL_PORT_RANGE_END[[:space:]]*=' "$ROUTER_CONFIG_FILE" 2>/dev/null | head -1 | sed 's/^[^=]*=[[:space:]]*//' | tr -d '[:space:]"')"
        case "$_v" in ''|*[!0-9]*) ;; *) printf '%s' "$_v"; return ;; esac
    fi
    printf '9599'
}

port_in_range() {
    _p="$1"
    case "$_p" in ''|*[!0-9]*) return 1 ;; esac
    [ "$_p" -ge "$(port_range_start)" ] && [ "$_p" -le "$(port_range_end)" ]
}

# Returns 0 if <port> is bound on the host by ANY listening process.
# Tries ss → netstat → nc → bash /dev/tcp for portability.
port_in_use_on_host() {
    _p="$1"
    case "$_p" in ''|*[!0-9]*) return 1 ;; esac

    if command -v ss >/dev/null 2>&1; then
        ss -ltn 2>/dev/null | awk 'NR>1 {print $4}' | grep -E "[:.]${_p}\$" >/dev/null 2>&1
        return $?
    fi
    if command -v netstat >/dev/null 2>&1; then
        netstat -an 2>/dev/null | awk '/LISTEN/ {print $4}' | grep -E "[:.]${_p}\$" >/dev/null 2>&1
        return $?
    fi
    if command -v nc >/dev/null 2>&1; then
        nc -z 127.0.0.1 "$_p" >/dev/null 2>&1
        return $?
    fi
    if command -v bash >/dev/null 2>&1; then
        bash -c "exec 9<>/dev/tcp/127.0.0.1/$_p" >/dev/null 2>&1
        _rc=$?
        bash -c "exec 9>&-" >/dev/null 2>&1 || true
        return $_rc
    fi
    return 1
}

router_app_entry_path() {
    _id="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9.-' '_')"
    printf '%s/%s.env' "$ROUTER_APP_REGISTRY_DIR" "$_id"
}

router_app_entry_exists() {
    [ -f "$(router_app_entry_path "$1")" ]
}

# Iterate over every app entry and emit "APP_ID<TAB>SWOOLE_PORT<TAB>PROJECT_ROOT<TAB>PROJECT_NAME".
router_app_iter() {
    [ -d "$ROUTER_APP_REGISTRY_DIR" ] || return 0
    for _entry in "$ROUTER_APP_REGISTRY_DIR"/*.env; do
        [ -f "$_entry" ] || continue
        APP_ID='' SWOOLE_PORT='' PROJECT_ROOT='' PROJECT_NAME='' REGISTERED_AT='' UPDATED_AT=''
        # shellcheck disable=SC1090
        . "$_entry"
        [ -n "$APP_ID" ] || continue
        [ -n "$SWOOLE_PORT" ] || continue
        printf '%s\t%s\t%s\t%s\n' "$APP_ID" "$SWOOLE_PORT" "${PROJECT_ROOT:-}" "${PROJECT_NAME:-}"
    done
}

# Find the app id matching a project root, if registered. Empty stdout if not.
router_app_find_by_project() {
    _root="$1"
    [ -n "$_root" ] || return 1
    [ -d "$ROUTER_APP_REGISTRY_DIR" ] || return 1
    for _entry in "$ROUTER_APP_REGISTRY_DIR"/*.env; do
        [ -f "$_entry" ] || continue
        APP_ID='' SWOOLE_PORT='' PROJECT_ROOT='' PROJECT_NAME='' REGISTERED_AT='' UPDATED_AT=''
        # shellcheck disable=SC1090
        . "$_entry"
        if [ "$PROJECT_ROOT" = "$_root" ] && [ -n "$APP_ID" ]; then
            printf '%s' "$APP_ID"
            return 0
        fi
    done
    return 1
}

# Returns 0 if <port> is registered to a DIFFERENT app than <self_app_id>.
port_owned_by_other_app() {
    _port="$1"
    _self="$2"
    [ -d "$ROUTER_APP_REGISTRY_DIR" ] || return 1
    for _entry in "$ROUTER_APP_REGISTRY_DIR"/*.env; do
        [ -f "$_entry" ] || continue
        APP_ID='' SWOOLE_PORT='' PROJECT_ROOT='' PROJECT_NAME='' REGISTERED_AT='' UPDATED_AT=''
        # shellcheck disable=SC1090
        . "$_entry"
        [ -n "$APP_ID" ] || continue
        [ -n "$SWOOLE_PORT" ] || continue
        [ "$SWOOLE_PORT" = "$_port" ] || continue
        [ "$APP_ID" != "$_self" ] || continue
        return 0
    done
    return 1
}

# Scan [start..end] for a port that is neither owned by another app id
# nor bound on the host. Echoes the chosen port; non-zero exit if exhausted.
allocate_free_port() {
    _self="$1"
    _start="$(port_range_start)"
    _end="$(port_range_end)"
    _p="$_start"
    while [ "$_p" -le "$_end" ]; do
        if ! port_owned_by_other_app "$_p" "$_self" && ! port_in_use_on_host "$_p"; then
            printf '%s' "$_p"
            return 0
        fi
        _p=$((_p + 1))
    done
    return 1
}

# Generate a UUIDv4. Prefers `uuidgen`; falls back to /dev/urandom and
# manually sets the version + variant nibbles per RFC 4122 §4.4.
app_generate_uuid() {
    if command -v uuidgen >/dev/null 2>&1; then
        uuidgen 2>/dev/null | tr '[:upper:]' '[:lower:]'
        return 0
    fi
    if [ -r /proc/sys/kernel/random/uuid ]; then
        cat /proc/sys/kernel/random/uuid 2>/dev/null
        return 0
    fi
    if [ -r /dev/urandom ]; then
        _hex="$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')"
        if [ -n "$_hex" ]; then
            _g1="$(printf '%s' "$_hex" | cut -c1-8)"
            _g2="$(printf '%s' "$_hex" | cut -c9-12)"
            _g3="$(printf '4%s' "$(printf '%s' "$_hex" | cut -c14-16)")"
            _v9="$(printf '%s' "$_hex" | cut -c17)"
            case "$_v9" in
                0|1|2|3|4|5|6|7) _v9=8 ;;
                c|d|e|f)         _v9=a ;;
            esac
            _g4="$(printf '%s%s' "$_v9" "$(printf '%s' "$_hex" | cut -c18-20)")"
            _g5="$(printf '%s' "$_hex" | cut -c21-32)"
            printf '%s-%s-%s-%s-%s\n' "$_g1" "$_g2" "$_g3" "$_g4" "$_g5"
            return 0
        fi
    fi
    error "Cannot generate UUID: no uuidgen, /proc UUID, or /dev/urandom available."
    exit 1
}

# Loose validator: accepts canonical UUIDv4 or a [a-z0-9-]{6,64} slug.
app_validate_app_id() {
    _id="$1"
    case "$_id" in
        ''|*[!a-z0-9-]*) return 1 ;;
    esac
    _len=${#_id}
    [ "$_len" -ge 6 ] && [ "$_len" -le 64 ]
}

# Persist an app entry. REGISTERED_AT is preserved across re-writes.
router_app_write_entry() {
    _id="$1"
    _port="$2"
    _project_root_arg="${3:-$PROJECT_ROOT}"
    _project_name="$(basename "$_project_root_arg" 2>/dev/null || echo unknown)"
    _path="$(router_app_entry_path "$_id")"
    _registered_at=""
    if [ -f "$_path" ]; then
        APP_ID='' SWOOLE_PORT='' PROJECT_ROOT='' PROJECT_NAME='' REGISTERED_AT='' UPDATED_AT=''
        # shellcheck disable=SC1090
        . "$_path"
        _registered_at="$REGISTERED_AT"
    fi
    [ -n "$_registered_at" ] || _registered_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    router_ensure_app_dirs
    cat > "$_path" <<EOF
APP_ID=$_id
PROJECT_ROOT=$_project_root_arg
PROJECT_NAME=$_project_name
SWOOLE_PORT=$_port
REGISTERED_AT=$_registered_at
UPDATED_AT=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
EOF
}

router_app_delete_entry() {
    _id="$1"
    rm -f "$(router_app_entry_path "$_id")"
}

# Rewrite UPSTREAM_PORT for every domain entry under a project root, regenerate
# nginx + dnsmasq config, and reload the proxy if it's running.
router_apply_app_port_to_domains() {
    _project_root_arg="$1"
    _new_port="$2"
    [ -n "$_project_root_arg" ] || return 0
    [ -n "$_new_port" ] || return 0
    [ -d "$ROUTER_REGISTRY_DIR" ] || return 0

    _saved_project_root="$PROJECT_ROOT"
    _changed=0
    for _entry in "$ROUTER_REGISTRY_DIR"/*.env; do
        [ -f "$_entry" ] || continue
        DOMAIN='' PROJECT_ROOT='' COMPOSE_PROJECT_NAME='' UPSTREAM_HOST='' UPSTREAM_PORT='' MODE='' UPDATED_AT=''
        # shellcheck disable=SC1090
        . "$_entry"
        [ "$PROJECT_ROOT" = "$_project_root_arg" ] || continue
        [ "$UPSTREAM_PORT" != "$_new_port" ] || continue
        PROJECT_ROOT="$_project_root_arg"
        router_registry_write_entry "$DOMAIN" "$_new_port" "$MODE"
        _changed=1
    done
    PROJECT_ROOT="$_saved_project_root"

    if [ "$_changed" -eq 1 ]; then
        router_generate_nginx_config
        router_generate_dns_config
        if [ -f "$ROUTER_COMPOSE" ]; then
            router_compose restart proxy >/dev/null 2>&1 || true
        fi
    fi
}

# Atomic-ish .env upsert: replace KEY=... line in-place, otherwise append.
env_upsert_kv() {
    _file="$1"
    _key="$2"
    _val="$3"
    [ -n "$_file" ] || return 1
    [ -n "$_key" ] || return 1
    if [ ! -f "$_file" ]; then
        printf '%s=%s\n' "$_key" "$_val" > "$_file"
        return 0
    fi
    _tmp="$(mktemp "${_file}.XXXXXX")"
    awk -v k="$_key" -v v="$_val" '
        BEGIN { written = 0 }
        {
            line = $0
            stripped = line
            sub(/^[[:space:]]+/, "", stripped)
            if (stripped ~ "^"k"[[:space:]]*=") {
                if (!written) { print k "=" v; written = 1 }
                next
            }
            print line
        }
        END { if (!written) print k "=" v }
    ' "$_file" > "$_tmp" && mv "$_tmp" "$_file"
}

# Returns 0 (success) if the project rooted at $1 has its `app` compose service
# in a "running" state, 1 otherwise. Unlike `is_app_running` this is per-project
# (takes the project root explicitly), and queries Docker directly via compose
# labels so it works even when $PROJECT_ROOT doesn't match the argument.
#
# The broker uses this to gate self-port reuse: a registry entry from a
# project whose `app` container isn't actually up MUST NOT be treated as
# "owns this port" — otherwise a stopped project would shadow whoever has
# actually bound the port (another Semitexa app or an unrelated host process).
project_is_app_running() {
    _project_root_arg="${1:-$PROJECT_ROOT}"
    [ -n "$_project_root_arg" ] || return 1
    command -v docker >/dev/null 2>&1 || return 1
    _proj_name="$(basename "$_project_root_arg" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9_-')"
    [ -n "$_proj_name" ] || return 1
    _running="$(
        docker ps \
            --filter "label=com.docker.compose.project=$_proj_name" \
            --filter "label=com.docker.compose.service=app" \
            --filter "status=running" \
            --format '{{.ID}}' 2>/dev/null | head -n 1
    )"
    [ -n "$_running" ]
}

# Treat "in use by us" as not-in-use, so reconciling while our own container
# is publishing this port doesn't relocate the app.
#
# Registry-match alone is not sufficient: a stale entry whose app isn't
# actually running could otherwise shadow a port that some other process
# now holds. We require the project's app container to be running before
# trusting a router-registry entry as proof of self-ownership.
port_in_use_on_host_excluding_self() {
    _port="$1"
    _project_root_arg="${2:-$PROJECT_ROOT}"
    if ! port_in_use_on_host "$_port"; then
        return 1
    fi
    _project_running=0
    if project_is_app_running "$_project_root_arg"; then
        _project_running=1
    fi
    if [ -d "$ROUTER_REGISTRY_DIR" ]; then
        for _entry in "$ROUTER_REGISTRY_DIR"/*.env; do
            [ -f "$_entry" ] || continue
            DOMAIN='' PROJECT_ROOT='' COMPOSE_PROJECT_NAME='' UPSTREAM_HOST='' UPSTREAM_PORT='' MODE='' UPDATED_AT=''
            # shellcheck disable=SC1090
            . "$_entry"
            if [ "$_project_running" -eq 1 ] && [ "$PROJECT_ROOT" = "$_project_root_arg" ] && [ "$UPSTREAM_PORT" = "$_port" ]; then
                return 1
            fi
        done
    fi
    _existing="$(router_app_find_by_project "$_project_root_arg" 2>/dev/null || true)"
    if [ -n "$_existing" ] && [ -f "$(router_app_entry_path "$_existing")" ]; then
        APP_ID='' SWOOLE_PORT='' PROJECT_ROOT='' PROJECT_NAME='' REGISTERED_AT='' UPDATED_AT=''
        # shellcheck disable=SC1090
        . "$(router_app_entry_path "$_existing")"
        if [ "$_project_running" -eq 1 ] && [ "$SWOOLE_PORT" = "$_port" ]; then
            return 1
        fi
    fi
    return 0
}

# Core registration algorithm. Inputs: <app-id> [<requested-port>] [<project-root>]
# Echoes the assigned port; non-zero exit if no port could be allocated.
local_app_register_logic() {
    _id="$1"
    _requested="${2:-}"
    _project_root_arg="${3:-$PROJECT_ROOT}"

    if ! app_validate_app_id "$_id"; then
        error "Invalid SEMITEXA_APP_ID: '$_id' (expected 6-64 chars, [a-z0-9-])."
        return 1
    fi

    router_ensure_app_dirs
    router_lock_acquire

    _existing_port=""
    if router_app_entry_exists "$_id"; then
        APP_ID='' SWOOLE_PORT='' PROJECT_ROOT='' PROJECT_NAME='' REGISTERED_AT='' UPDATED_AT=''
        # shellcheck disable=SC1090
        . "$(router_app_entry_path "$_id")"
        _existing_port="$SWOOLE_PORT"
    fi

    case "$_requested" in
        ''|auto) _requested="" ;;
        *[!0-9]*)
            warn "Requested port '$_requested' is not numeric; ignoring."
            _requested=""
            ;;
    esac

    _assigned=""
    if [ -z "$_requested" ]; then
        if [ -n "$_existing_port" ] \
            && port_in_range "$_existing_port" \
            && ! port_owned_by_other_app "$_existing_port" "$_id" \
            && ! port_in_use_on_host_excluding_self "$_existing_port" "$_project_root_arg"; then
            _assigned="$_existing_port"
        else
            _assigned="$(allocate_free_port "$_id" || true)"
        fi
    else
        if ! port_in_range "$_requested"; then
            warn "Port $_requested is outside the allowed range ($(port_range_start)-$(port_range_end))."
        elif port_owned_by_other_app "$_requested" "$_id"; then
            warn "Port $_requested is already assigned to another local Semitexa app."
        elif port_in_use_on_host_excluding_self "$_requested" "$_project_root_arg"; then
            warn "Port $_requested is currently bound by another process on the host."
        else
            _assigned="$_requested"
        fi
        if [ -z "$_assigned" ]; then
            _assigned="$(allocate_free_port "$_id" || true)"
            [ -n "$_assigned" ] && warn "Falling back to free port $_assigned."
        fi
    fi

    if [ -z "$_assigned" ]; then
        router_lock_release
        error "No free port in $(port_range_start)-$(port_range_end). Adjust SEMITEXA_LOCAL_PORT_RANGE_START/END in $ROUTER_CONFIG_FILE."
        return 1
    fi

    router_app_write_entry "$_id" "$_assigned" "$_project_root_arg"
    router_apply_app_port_to_domains "$_project_root_arg" "$_assigned"
    router_lock_release
    printf '%s' "$_assigned"
}

# High-level reconcile for $PROJECT_ROOT: ensure SEMITEXA_APP_ID + SWOOLE_PORT
# in .env are valid against the broker; rewrite .env if the assigned port
# differs from what the project asked for. No-op when no .env.* file exists.
local_app_reconcile() {
    _env_file="$PROJECT_ROOT/.env"
    if [ ! -f "$_env_file" ] && [ ! -f "$PROJECT_ROOT/.env.default" ]; then
        return 0
    fi

    _app_id="$(env_val SEMITEXA_APP_ID '')"
    if [ -z "$_app_id" ]; then
        _app_id="$(router_app_find_by_project "$PROJECT_ROOT" 2>/dev/null || true)"
        if [ -z "$_app_id" ]; then
            _app_id="$(app_generate_uuid)"
            info "Generated SEMITEXA_APP_ID=$_app_id for $(basename "$PROJECT_ROOT")."
        else
            info "Reusing existing app id $_app_id for $(basename "$PROJECT_ROOT")."
        fi
        [ -f "$_env_file" ] || : > "$_env_file"
        env_upsert_kv "$_env_file" SEMITEXA_APP_ID "$_app_id"
    fi

    _current_port="$(env_val SWOOLE_PORT '')"
    _assigned="$(local_app_register_logic "$_app_id" "$_current_port" "$PROJECT_ROOT" || true)"
    if [ -z "$_assigned" ]; then
        warn "Local app registry could not assign a Swoole port; keeping existing value."
        return 1
    fi

    if [ "$_assigned" != "$_current_port" ]; then
        if [ -n "$_current_port" ]; then
            warn "Swoole port for app $_app_id changed from $_current_port to $_assigned (conflict or out-of-range)."
        else
            info "Swoole port for app $_app_id assigned to $_assigned."
        fi
        [ -f "$_env_file" ] || : > "$_env_file"
        env_upsert_kv "$_env_file" SWOOLE_PORT "$_assigned"
    fi
    return 0
}

# The networks the router proxy is on, one per line; nothing when it is not running.
router_proxy_networks() {
    docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{println $k}}{{end}}' semitexa-router-proxy 2>/dev/null | sed '/^$/d'
}

# Puts the router on this project's network and records the app container as
# the route for this project's domains (tk-app-port-binds-every-interface).
# Names are read from Docker, never built: with the router on several
# projects' networks, "app" names a different container on each.
router_attach_project() {
    project_has_shared_domains || return 0
    docker inspect semitexa-router-proxy >/dev/null 2>&1 || return 0
    _ra_compose="$(compose_bin)"
    # shellcheck disable=SC2086
    _ra_cid="$($_ra_compose $(compose_args) ps -q app 2>/dev/null </dev/null | head -n 1 || true)"
    [ -n "$_ra_cid" ] || return 0
    # || true throughout: an app that died right after up is not a reason to stop.
    _ra_name="$(docker inspect -f '{{.Name}}' "$_ra_cid" 2>/dev/null | sed 's#^/##' || true)"
    _ra_proj="$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' "$_ra_cid" 2>/dev/null || true)"
    _ra_nets="$(docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{println $k}}{{end}}' "$_ra_cid" 2>/dev/null | sed '/^$/d' || true)"
    _ra_net="$(printf '%s\n' "$_ra_nets" | grep -Fx -- "${_ra_proj}_default" | head -n 1)"
    [ -n "$_ra_net" ] || _ra_net="$(printf '%s\n' "$_ra_nets" | head -n 1)"
    [ -n "$_ra_name" ] && [ -n "$_ra_net" ] || return 0
    docker network connect "$_ra_net" semitexa-router-proxy >/dev/null 2>&1 || true
    if ! router_proxy_networks | grep -Fx -- "$_ra_net" >/dev/null 2>&1; then
        # The host port is published on SWOOLE_BIND, 127.0.0.1 by default, where the
        # router's host.docker.internal route cannot reach it (tk-app-port-binds-every-interface).
        warn "The shared router could not join network $_ra_net, so its domains go through the host port $(env_val SWOOLE_PORT 8080), published on $(env_val SWOOLE_BIND 127.0.0.1). The router reaches that port only when SWOOLE_BIND=0.0.0.0 in .env; open http://127.0.0.1:$(env_val SWOOLE_PORT 8080) meanwhile."
        return 0
    fi
    _ra_port="$(env_val SWOOLE_PORT 8080)"
    _ra_mode="$(router_mode_get)"
    _ra_root="$PROJECT_ROOT"
    for _ra_entry in "$ROUTER_REGISTRY_DIR"/*.env; do
        [ -f "$_ra_entry" ] || continue
        [ "$(sed -n "s/^PROJECT_ROOT=//p" "$_ra_entry" | head -n 1)" = "$_ra_root" ] || continue
        _ra_domain="$(sed -n "s/^DOMAIN=//p" "$_ra_entry" | head -n 1)"
        _ra_hport="$(sed -n "s/^UPSTREAM_PORT=//p" "$_ra_entry" | head -n 1)"
        [ -n "$_ra_domain" ] || continue
        router_registry_write_entry "$_ra_domain" "${_ra_hport:-$_ra_port}" "$_ra_mode" "$_ra_name" "$_ra_net" "$_ra_port"
    done
    PROJECT_ROOT="$_ra_root"
    router_generate_nginx_config
    router_reload_proxy
}

# Takes the router off this project's networks, so `down` can remove them
# ("network has active endpoints" otherwise, and set -e then ends the run
# before `up`). Docker says which networks are the project's, by the compose
# project label: the registry can have lost the entry (local-domain:remove,
# a domain renamed in .env) while the router is still attached (Fable review,
# installer#82). The registry is read as well, for an entry Docker no longer
# labels.
router_detach_project() {
    docker inspect semitexa-router-proxy >/dev/null 2>&1 || return 0
    _rd_compose="$(compose_bin)"
    # shellcheck disable=SC2086
    _rd_cid="$($_rd_compose $(compose_args) ps -a -q 2>/dev/null </dev/null | head -n 1 || true)"
    _rd_proj=''
    [ -n "$_rd_cid" ] && _rd_proj="$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' "$_rd_cid" 2>/dev/null || true)"
    _rd_nets="$(sed -n "s/^UPSTREAM_NETWORK=//p" $(grep -lxF "PROJECT_ROOT=$PROJECT_ROOT" "$ROUTER_REGISTRY_DIR"/*.env 2>/dev/null) </dev/null 2>/dev/null || true)"
    for _rd_net in $(router_proxy_networks || true); do
        [ "$_rd_net" = "router_default" ] && continue
        if [ -n "$_rd_proj" ] && [ "$(docker network inspect -f '{{index .Labels "com.docker.compose.project"}}' "$_rd_net" 2>/dev/null || true)" = "$_rd_proj" ]; then
            _rd_nets="$_rd_nets
$_rd_net"
        fi
    done
    for _rd_net in $(printf '%s\n' "$_rd_nets" | sed '/^$/d' | sort -u); do
        docker network disconnect -f "$_rd_net" semitexa-router-proxy >/dev/null 2>&1 || true
    done
    return 0
}

# A recreated router container is on its own network only: put it back on
# every network a registered project's app is reached over.
router_reconnect_all() {
    docker inspect semitexa-router-proxy >/dev/null 2>&1 || return 0
    for _rc_net in $(sed -n "s/^UPSTREAM_NETWORK=//p" "$ROUTER_REGISTRY_DIR"/*.env 2>/dev/null | sort -u); do
        docker network connect "$_rc_net" semitexa-router-proxy >/dev/null 2>&1 || true
    done
    return 0
}

# Loads the rendered config only when nginx accepts it: a bad render leaves
# the working one in place instead of a router that no longer starts.
router_reload_proxy() {
    docker inspect semitexa-router-proxy >/dev/null 2>&1 || return 0
    if docker exec semitexa-router-proxy nginx -t >/dev/null 2>&1; then
        docker exec semitexa-router-proxy nginx -s reload >/dev/null 2>&1 || true
    else
        warn "The shared router refused the new config (nginx -t); it keeps the one it had."
    fi
}

router_generate_nginx_config() {
    router_ensure_dirs
    _saved_project_root="$PROJECT_ROOT"
    # Each entry sets COMPOSE_PROJECT_NAME to its own project's, and .env keys
    # are exported (env_export_compose_context): left as the last entry's, a
    # compose call after this would run in another project (Fable review,
    # installer#82).
    _saved_cpn_set="${COMPOSE_PROJECT_NAME+x}" _saved_cpn="${COMPOSE_PROJECT_NAME:-}"
    cat > "$ROUTER_NGINX_DEFAULT" <<'EOF'
server {
    listen 80 default_server;
    server_name _;

    default_type text/plain;

    location / {
        return 404 "Semitexa local router: domain is not registered or its upstream is unavailable.\n";
    }
}
EOF

    : > "$ROUTER_NGINX_DOMAINS"
    _router_nets="$(router_proxy_networks)"
    for _entry in "$ROUTER_REGISTRY_DIR"/*.env; do
        [ -f "$_entry" ] || continue
        DOMAIN='' PROJECT_ROOT='' COMPOSE_PROJECT_NAME='' UPSTREAM_HOST='' UPSTREAM_PORT='' MODE='' UPDATED_AT=''
        UPSTREAM_CONTAINER='' UPSTREAM_NETWORK='' UPSTREAM_CONTAINER_PORT=''
        # shellcheck disable=SC1090
        . "$_entry"
        [ -n "$DOMAIN" ] || continue
        [ -n "$UPSTREAM_PORT" ] || continue
        # Into the app's container over its own network when the router is on
        # it (tk-app-port-binds-every-interface): the host port is then not
        # needed. Resolved per request, so a stopped project is a 502 for its
        # own domain, not a router that refuses to load, and a recreated app is
        # found again within 5 s. Otherwise the host port, as before.
        _route="proxy_pass http://$UPSTREAM_HOST:$UPSTREAM_PORT;"
        if [ -n "$UPSTREAM_CONTAINER" ] && [ -n "$UPSTREAM_CONTAINER_PORT" ] \
            && printf '%s\n' "$_router_nets" | grep -Fx -- "$UPSTREAM_NETWORK" >/dev/null 2>&1; then
            _route="resolver 127.0.0.11 valid=5s ipv6=off;
        set \$semitexa_upstream $UPSTREAM_CONTAINER;
        proxy_pass http://\$semitexa_upstream:$UPSTREAM_CONTAINER_PORT;"
        fi
        cat >> "$ROUTER_NGINX_DOMAINS" <<EOF
server {
    listen 80;
    server_name $DOMAIN;

    location / {
        $_route
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}

EOF
    done
    PROJECT_ROOT="$_saved_project_root"
    if [ -n "$_saved_cpn_set" ]; then COMPOSE_PROJECT_NAME="$_saved_cpn"; else unset COMPOSE_PROJECT_NAME; fi
}

router_generate_dns_config() {
    router_ensure_dirs
    _saved_project_root="$PROJECT_ROOT"
    cat > "$ROUTER_DNSMASQ_CONF" <<'EOF'
port=53
no-resolv
no-daemon
log-queries
conf-file=/etc/dnsmasq.d/domains.conf
EOF

    : > "$ROUTER_DNS_DOMAINS"
    for _entry in "$ROUTER_REGISTRY_DIR"/*.env; do
        [ -f "$_entry" ] || continue
        DOMAIN='' MODE=''
        # shellcheck disable=SC1090
        . "$_entry"
        [ -n "$DOMAIN" ] || continue
        printf 'address=/%s/127.0.0.1\n' "$DOMAIN" >> "$ROUTER_DNS_DOMAINS"
    done
    PROJECT_ROOT="$_saved_project_root"
}

router_generate_compose() {
    router_ensure_dirs
    cat > "$ROUTER_COMPOSE" <<EOF
services:
  dns:
    image: alpine:3.21
    container_name: semitexa-router-dns
    restart: unless-stopped
    command: ["sh", "-c", "apk add --no-cache dnsmasq && dnsmasq --keep-in-foreground --conf-file=/etc/dnsmasq.d/dnsmasq.conf"]
    ports:
      - "127.0.0.1:5553:53/udp"
      - "127.0.0.1:5553:53/tcp"
    volumes:
      - $ROUTER_DNSMASQ_CONF:/etc/dnsmasq.d/dnsmasq.conf:ro
      - $ROUTER_DNS_DOMAINS:/etc/dnsmasq.d/domains.conf:ro
    cap_add:
      - NET_ADMIN
    healthcheck:
      test: ["CMD", "nslookup", "localhost", "127.0.0.1"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 5s

  proxy:
    image: nginx:alpine
    container_name: semitexa-router-proxy
    restart: unless-stopped
    # This machine only, as the DNS above: *.test resolves to 127.0.0.1 and
    # nowhere else, so nobody else ever reaches the router by name. On 0.0.0.0
    # anyone on the network could send any registered Host to port 80 and be
    # proxied into that project's dev stack.
    ports:
      - "127.0.0.1:80:80"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - $ROUTER_NGINX_DEFAULT:/etc/nginx/conf.d/default.conf:ro
      - $ROUTER_NGINX_DOMAINS:/etc/nginx/conf.d/semitexa-domains.conf:ro
EOF
}

router_render() {
    router_generate_compose
    router_generate_nginx_config
    router_generate_dns_config
}

router_compose() {
    _compose="$(compose_bin)"
    $_compose -f "$ROUTER_COMPOSE" "$@"
}

tty_available() {
    [ -t 0 ] && [ -e /dev/tty ]
}

sudo_ready() {
    sudo -n true >/dev/null 2>&1
}

router_configure_resolved_for_test() {
    if ! command -v systemctl >/dev/null 2>&1 || ! systemctl is-active --quiet systemd-resolved; then
        return 0
    fi

    _needs_restart=0
    if grep -qi "^DNSStubListener=no" /etc/systemd/resolved.conf 2>/dev/null; then
        warn "systemd-resolved has DNSStubListener=no (breaks shared .test resolution)."
        if tty_available; then
            printf "%s? Do you want to fix this automatically? (requires sudo) [Y/n]%s " "$C_YELLOW" "$C_RESET"
            read -r _ans </dev/tty
        elif sudo_ready; then
            _ans="y"
        else
            warn "Skipping DNSStubListener fix (no TTY and sudo requires a password)."
            _ans="n"
        fi
        if [ "$_ans" != "n" ] && [ "$_ans" != "N" ]; then
            if sudo sed -i 's/^DNSStubListener=no/DNSStubListener=yes/i' /etc/systemd/resolved.conf; then
                success "Set DNSStubListener=yes"
                _needs_restart=1
            else
                warn "Failed to set DNSStubListener=yes."
            fi
        fi
    fi

    if [ ! -f /etc/systemd/resolved.conf.d/semitexa-router.conf ]; then
        info "Shared Semitexa router is not yet bound to .test."
        if tty_available; then
            printf "%s? Do you want to configure this automatically? (requires sudo) [Y/n]%s " "$C_YELLOW" "$C_RESET"
            read -r _ans </dev/tty
        elif sudo_ready; then
            _ans="y"
        else
            warn "Skipping automatic .test resolver setup (no TTY and sudo requires a password)."
            _ans="n"
        fi
        if [ "$_ans" != "n" ] && [ "$_ans" != "N" ]; then
            if sudo mkdir -p /etc/systemd/resolved.conf.d/ \
                && printf "[Resolve]\nDNS=127.0.0.1:5553\nDomains=~test\n" | sudo tee /etc/systemd/resolved.conf.d/semitexa-router.conf >/dev/null; then
                success "Created /etc/systemd/resolved.conf.d/semitexa-router.conf"
                _needs_restart=1
            else
                warn "Failed to create /etc/systemd/resolved.conf.d/semitexa-router.conf."
            fi
        fi
    fi

    if [ "$_needs_restart" -eq 1 ]; then
        info "Restarting systemd-resolved to apply shared .test routing..."
        if sudo systemctl restart systemd-resolved \
            && sudo ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf; then
            success "systemd-resolved restarted and configured!"
            echo ""
        else
            warn "Failed to restart systemd-resolved cleanly."
        fi
    fi
}

router_hosts_remove_domain() {
    _domain="$1"
    if ! grep -q "^[[:space:]]*127\\.0\\.0\\.1[[:space:]].*${_domain}.*# semitexa-router\$" /etc/hosts 2>/dev/null; then
        return 0
    fi
    _tmp="$(mktemp)"
    grep -v "^[[:space:]]*127\\.0\\.0\\.1[[:space:]].*${_domain}.*# semitexa-router\$" /etc/hosts > "$_tmp" 2>/dev/null || true
    sudo tee /etc/hosts >/dev/null < "$_tmp"
    rm -f "$_tmp"
}

router_hosts_ensure_domain() {
    _domain="$1"
    if grep -q "^[[:space:]]*127\\.0\\.0\\.1[[:space:]].*${_domain}.*# semitexa-router\$" /etc/hosts 2>/dev/null; then
        return 0
    fi
    printf '127.0.0.1 %s # semitexa-router\n' "$_domain" | sudo tee -a /etc/hosts >/dev/null
}

router_apply_name_resolution() {
    _mode="$(router_mode_get)"
    _domain="${1:-}"

    case "$_mode" in
        dns)
            router_configure_resolved_for_test
            [ -n "$_domain" ] && router_hosts_remove_domain "$_domain" >/dev/null 2>&1 || true
            ;;
        hosts)
            [ -n "$_domain" ] && router_hosts_ensure_domain "$_domain"
            ;;
    esac
}

# Reads what the router proxy publishes port 80 on, in this shell (no subshell,
# so the caller sees the result):
#   ROUTER_PUBLISHED        the addresses, space-separated
#   ROUTER_PUBLISHED_STATE  ok; absent (no docker, no proxy container, or one
#                           publishing nothing); failed (docker answered with
#                           another error: the binding is unknown, not clean)
#   ROUTER_INSPECT_ERROR    docker's first line, when failed
router_proxy_inspect() {
    ROUTER_PUBLISHED=''
    ROUTER_PUBLISHED_STATE=absent
    ROUTER_INSPECT_ERROR=''
    command -v docker >/dev/null 2>&1 || return 0
    # stderr apart: a CLI warning (a malformed config file, say) beside a
    # successful answer is not an address, and would read as a public one.
    _port_err_file="$(mktemp 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}/semitexa-router-port.$$")"
    _port_rc=0
    _port_out="$(docker port semitexa-router-proxy 80/tcp 2>"$_port_err_file")" || _port_rc=$?
    _port_err="$(cat "$_port_err_file" 2>/dev/null || true)"
    rm -f "$_port_err_file"
    if [ "$_port_rc" -eq 0 ]; then
        ROUTER_PUBLISHED="$(printf '%s\n' "$_port_out" | sed '/^$/d; s/:[0-9]*$//' | tr '\n' ' ' | sed 's/ *$//')"
        [ -z "$ROUTER_PUBLISHED" ] || ROUTER_PUBLISHED_STATE=ok
        return 0
    fi
    case "$_port_err$_port_out" in
        *'No such container'*|*'o public port'*) ;;
        *)
            ROUTER_PUBLISHED_STATE=failed
            ROUTER_INSPECT_ERROR="$(printf '%s\n' "$_port_err" "$_port_out" | sed '/^$/d' | sed -n '1p')"
            ;;
    esac
}

# The router workspace is shared by every project on the machine, and each
# project's own bin/semitexa renders it. One with a script from before
# 2026-11-09 writes "80:80" and reopens the router to the network whenever it
# starts it. This script cannot stop that, so it says so and rebinds: start and
# restart run it before `up -d`, doctor reports it. Returns 1 when public.
router_warn_if_public() {
    router_proxy_inspect
    _published="$ROUTER_PUBLISHED"
    _public=''
    _rc=0
    # A binding docker would not show is unknown, not clean: say so.
    if [ "$ROUTER_PUBLISHED_STATE" = failed ]; then
        warn "Could not read which addresses the router proxy publishes port 80 on: ${ROUTER_INSPECT_ERROR:-docker port failed}"
        warn "Its binding is not checked. See: docker port semitexa-router-proxy 80/tcp"
        return 3
    fi
    # Loopback is the only local-only answer. Anything else - 0.0.0.0, [::],
    # or one LAN address such as 192.168.1.100 - is reachable from others.
    for _address in $_published; do
        case "$_address" in
            127.*|'[::1]'|::1) ;;
            *) _public="${_public:+$_public }$_address" ;;
        esac
    done
    if [ -n "$_public" ]; then
        warn "The shared local router answers beyond this machine ($_public), not only on 127.0.0.1."
        warn "A Semitexa project with an older bin/semitexa reopens it whenever it starts the router: run 'bin/semitexa update' in each of your projects."
        _rc=1
    fi
    # Before Docker Engine 28 a port published on 127.0.0.1 is still reachable
    # from a host on the same network segment (fixed in 28.0, see the Docker
    # port-publishing docs), so loopback there is not this machine only either.
    # Checked whether or not the address was public: a rebind to 127.0.0.1
    # does not close it.
    [ -n "$_published" ] || return "$_rc"
    # An engine that will not say its version (an authorization plugin, a
    # daemon error) is unknown, not new enough: no upgrade advice, no all-clear.
    # A CLI too old for Server.Platform fails the whole template: ask for the
    # version alone then, and let the version decide what the engine is.
    _server="$(docker version --format '{{.Server.Platform.Name}}|{{.Server.Version}}' 2>/dev/null)" \
        || _server="|$(docker version --format '{{.Server.Version}}' 2>/dev/null || true)"
    # The version is the last field (a name may hold a "|"), and only a number
    # is one: a template error or an empty field is no version.
    _platform="${_server%|*}"
    _engine="${_server##*|}"
    [ "$_server" != "$_engine" ] || _platform=''
    case "$_engine" in [0-9]*) ;; *) _engine='' ;; esac
    if [ -z "$_engine" ]; then
        warn "Could not read the Docker Engine version, so it is not known whether 127.0.0.1 keeps the router to this machine (Engine 28 and later do). See: docker version"
        [ "$_rc" -eq 1 ] || _rc=3
        return "$_rc"
    fi
    # The 28.0 fix is Docker Engine's. Another engine behind the docker CLI
    # (Podman reports its own version, e.g. 5.4.0) is not measured by that
    # number, so it is unknown rather than "too old". Two signs, either enough:
    # a platform name without "Docker", or a version Docker Engine never had -
    # the second holds when an engine reports no platform name at all. Docker
    # went from 1.13 straight to YY.MM (17.03), so 2.x to 16.x is something
    # else; 1.x is old Docker (Podman answers the docker CLI only from 2.0).
    _not_docker=''
    case "$_platform" in
        ''|*Docker*) ;;
        *) _not_docker=1 ;;
    esac
    case "$_engine" in
        [2-9].*|1[0-6].*) _not_docker=1 ;;
    esac
    if [ -n "$_not_docker" ]; then
        warn "The engine is ${_platform:+$_platform }$_engine, not Docker Engine: whether 127.0.0.1 keeps the router to this machine is not checked here."
        [ "$_rc" -eq 1 ] || _rc=3
        return "$_rc"
    fi
    case "$_engine" in
        2[8-9].*|[3-9][0-9].*|[1-9][0-9][0-9]*) ;;
        *)
            warn "Docker Engine $_engine does not keep a port published on 127.0.0.1 from hosts on the same network; 28.0 does."
            warn "The router is reachable from your network segment until Docker is upgraded."
            [ "$_rc" -eq 1 ] || _rc=2
            ;;
    esac
    # 0: this machine only. 1: published beyond it, which a rebind to 127.0.0.1
    # fixes. 2: loopback, on an engine that does not enforce it. 3: not known,
    # because docker would not say the binding or the engine version.
    return "$_rc"
}

# The registered projects whose bin/semitexa still publishes the router on
# every interface, one root per line (tk-router-refuses-public-bind). Every
# project renders the shared router with its own script, so one from before
# 2026-11-09 reopens port 80 to the network the next time it starts it; this
# names them before that happens instead of "update each of your projects".
router_stale_projects() {
    # The ports line itself, anchored: a plain grep for the address also found
    # this function's own text, so any script carrying it read as fresh
    # (Fable review, installer#84). One root per line, spaces kept.
    sed -n 's/^PROJECT_ROOT=//p' "$ROUTER_REGISTRY_DIR"/*.env 2>/dev/null | sort -u | while IFS= read -r _rs_root; do
        [ -n "$_rs_root" ] && [ "$_rs_root" != "$PROJECT_ROOT" ] || continue
        if [ ! -f "$_rs_root/bin/semitexa" ]; then
            printf '%s (no bin/semitexa: not checked)\n' "$_rs_root"
        elif ! grep -Eq '^[[:space:]]*- "127\.0\.0\.1:80:80"[[:space:]]*$' "$_rs_root/bin/semitexa" 2>/dev/null; then
            printf '%s\n' "$_rs_root"
        fi
    done
    return 0
}

# start and restart rebind (up -d with the rendered 127.0.0.1 port), so they
# say so; doctor only reports.
router_check_before_rebind() {
    _check=0
    router_warn_if_public || _check=$?
    [ "$_check" -ne 1 ] || info "Rebinding it to 127.0.0.1."
    _stale="$(router_stale_projects)"
    if [ -n "$_stale" ]; then
        # "may": a project without a script is listed as not checked (review, update#87).
        warn "These projects may reopen the shared router to the network when they start it (an older bin/semitexa, or one not checked):"
        printf '%s\n' "$_stale" | while IFS= read -r _sp; do warn "    $_sp"; done
        warn "Run 'bin/semitexa update' in each. One whose bin/semitexa was edited there keeps it: run 'bin/semitexa update --write-scaffold-candidates', merge bin/semitexa.new, and check that the router ports line reads \"127.0.0.1:80:80\"."
        # Neither update runs where there is no script (review, installer#85).
        warn "One marked not checked has no bin/semitexa: restore it, or, if the project is gone, remove its domains from $ROUTER_REGISTRY_DIR."
    fi
    return 0
}

router_start_for_mode() {
    _mode="$(router_mode_get)"
    router_check_before_rebind
    router_render
    case "$_mode" in
        dns)
            router_apply_name_resolution
            router_compose up -d dns proxy
            router_reconnect_all; router_generate_nginx_config
            router_compose restart dns proxy >/dev/null 2>&1 || true
            ;;
        hosts)
            router_compose up -d proxy
            router_reconnect_all; router_generate_nginx_config
            router_compose stop dns >/dev/null 2>&1 || true
            router_compose restart proxy >/dev/null 2>&1 || true
            ;;
    esac
}

cmd_local_router_init() {
    printf "\n%s%s Semitexa — Shared Local Router Init %s\n\n" "$C_BOLD" "$C_CYAN" "$C_RESET"
    router_ensure_dirs
    router_mode_set "$(router_mode_get)"
    router_render
    success "Shared local router workspace prepared at $ROUTER_ROOT"
    info "Mode: $(router_mode_get)"
    printf "\n"
}

cmd_local_router_start() {
    printf "\n%s%s Semitexa — Shared Local Router Start %s\n\n" "$C_BOLD" "$C_CYAN" "$C_RESET"
    cmd_local_router_init >/dev/null
    router_start_for_mode
    success "Shared local router started."
    info "Mode: $(router_mode_get)"
    printf "\n"
}

cmd_local_router_stop() {
    printf "\n%s%s Semitexa — Shared Local Router Stop %s\n\n" "$C_BOLD" "$C_CYAN" "$C_RESET"
    if [ ! -f "$ROUTER_COMPOSE" ]; then
        info "Shared local router is not initialized."
        exit 0
    fi
    router_compose down
    success "Shared local router stopped."
    printf "\n"
}

cmd_local_router_restart() {
    printf "\n%s%s Semitexa — Shared Local Router Restart %s\n\n" "$C_BOLD" "$C_CYAN" "$C_RESET"
    cmd_local_router_init >/dev/null
    router_check_before_rebind
    router_render
    _mode="$(router_mode_get)"
    # up -d first: `restart` keeps a container's old configuration, so a
    # rendered compose with new ports (127.0.0.1:80, 2026-11-09) never reached
    # the running router. up -d recreates what changed; restart then reloads
    # the nginx and dnsmasq files the containers mount.
    case "$_mode" in
        dns)
            router_compose up -d dns proxy
            router_reconnect_all; router_generate_nginx_config
            router_compose restart dns proxy
            ;;
        hosts)
            router_compose up -d proxy
            router_reconnect_all; router_generate_nginx_config
            router_compose restart proxy
            ;;
    esac
    success "Shared local router restarted."
    printf "\n"
}

cmd_local_router_doctor() {
    printf "\n%s%s Semitexa — Shared Local Router Doctor %s\n\n" "$C_BOLD" "$C_CYAN" "$C_RESET"
    if [ ! -d "$ROUTER_ROOT" ]; then
        warn "Shared local router workspace does not exist."
        info "Run: bin/semitexa local-router:init"
        exit 1
    fi

    info "Root: $ROUTER_ROOT"
    info "Mode: $(router_mode_get)"
    info "Registered domains: $(router_registry_count)"
    info "Port range: $(port_range_start)-$(port_range_end)"

    if [ -f "$ROUTER_COMPOSE" ]; then
        printf "\n"
        router_compose ps || true
    fi
    if command -v docker >/dev/null 2>&1; then
        _check=0
        router_warn_if_public || _check=$?
        case "$ROUTER_PUBLISHED_STATE:$_check" in
            absent:*) info "The router proxy is not running, so it publishes nothing." ;;
            # What was checked, not a network boundary: a host routed to the
            # Docker bridge (allow-direct-routing) reaches the container itself.
            *:0) success "The router proxy is published on loopback only ($ROUTER_PUBLISHED)." ;;
            *:1) info "Fix: bin/semitexa local-router:restart, after updating the older projects." ;;
            # A restart rebinds to 127.0.0.1, which this engine does not keep local.
            *:2) info "Fix: upgrade Docker Engine to 28 or later; a restart does not close this." ;;
            # 3: the warning above says what was not known - docker not
            # answering (retry once it does) or an engine this check cannot
            # judge (a retry gives the same answer).
            *) info "Not checked: see the warning above for what could not be judged." ;;
        esac
    fi

    printf "\n"
    cmd_local_domain_list
    cmd_local_app_list
}

cmd_local_domain_mode() {
    _mode="${1:-}"
    if [ -z "$_mode" ]; then
        printf "%s\n" "$(router_mode_get)"
        exit 0
    fi
    router_mode_set "$_mode"
    router_render
    success "Shared local router mode set to $_mode."
    case "$_mode" in
        dns)
            info "Restart the shared router to enable shared .test DNS."
            ;;
        hosts)
            info "Future domain registrations will write /etc/hosts entries."
            ;;
    esac
}

cmd_local_domain_add() {
    _domain="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')"
    if [ -z "$_domain" ]; then
        error "Usage: bin/semitexa local-domain:add <domain.test>"
        exit 1
    fi
    if ! router_validate_domain "$_domain"; then
        error "Only valid .test domains are supported."
        exit 1
    fi

    _port="$(env_val SWOOLE_PORT 8080)"
    cmd_local_router_init >/dev/null
    router_registry_write_entry "$_domain" "$_port" "$(router_mode_get)"
    router_render
    router_apply_name_resolution "$_domain"
    if [ -f "$ROUTER_COMPOSE" ]; then
        router_start_for_mode
        if [ "$(router_mode_get)" = "dns" ]; then
            router_compose restart dns proxy >/dev/null 2>&1 || true
        else
            router_compose restart proxy >/dev/null 2>&1 || true
        fi
    fi

    success "Registered shared local domain: $_domain -> http://host.docker.internal:${_port}"
}

cmd_local_domain_remove() {
    _domain="$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')"
    if [ -z "$_domain" ]; then
        error "Usage: bin/semitexa local-domain:remove <domain.test>"
        exit 1
    fi
    _path="$(router_entry_path "$_domain")"
    if [ ! -f "$_path" ]; then
        warn "Domain '$_domain' is not registered in the shared router."
        exit 0
    fi

    router_registry_delete_entry "$_domain"
    router_render
    router_hosts_remove_domain "$_domain" >/dev/null 2>&1 || true
    if [ -f "$ROUTER_COMPOSE" ]; then
        if [ "$(router_mode_get)" = "dns" ]; then
            router_compose restart dns proxy >/dev/null 2>&1 || true
        else
            router_compose restart proxy >/dev/null 2>&1 || true
        fi
    fi

    success "Removed shared local domain: $_domain"
}

cmd_local_domain_list() {
    printf "\n%s%s Semitexa — Shared Local Domains %s\n\n" "$C_BOLD" "$C_CYAN" "$C_RESET"
    router_ensure_dirs
    _saved_project_root="$PROJECT_ROOT"
    _count=0
    for _entry in "$ROUTER_REGISTRY_DIR"/*.env; do
        [ -f "$_entry" ] || continue
        DOMAIN='' UPSTREAM_PORT='' PROJECT_ROOT='' MODE=''
        # shellcheck disable=SC1090
        . "$_entry"
        [ -n "$DOMAIN" ] || continue
        _project_label="$(basename "${PROJECT_ROOT:-}")"
        [ -n "$_project_label" ] || _project_label="unknown"
        printf "  %s%-30s%s → host.docker.internal:%s [%s] (%s)\n" "$C_GREEN" "$DOMAIN" "$C_RESET" "$UPSTREAM_PORT" "$MODE" "$_project_label"
        _count=$((_count + 1))
    done
    printf "\n"
    [ "$_count" -eq 0 ] && info "No shared local domains registered."
    [ "$_count" -gt 0 ] && info "$_count shared domain(s) configured."
    PROJECT_ROOT="$_saved_project_root"
    printf "\n"
}

# ═══════════════════════════════════════════════════════════════════════
#  local-app:* — local application registry & port broker
# ═══════════════════════════════════════════════════════════════════════
cmd_local_app_register() {
    _id=""
    _port=""
    _root=""
    _write_env=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --app-id=*)         _id="${1#--app-id=}" ;;
            --requested-port=*) _port="${1#--requested-port=}" ;;
            --project-root=*)   _root="${1#--project-root=}" ;;
            --write-env)        _write_env=1 ;;
            -h|--help)
                printf 'Usage: bin/semitexa local-app:register [--app-id=<id>] [--requested-port=<p>] [--project-root=<path>] [--write-env]\n'
                exit 0
                ;;
            *)
                error "Unknown argument: $1"
                exit 1
                ;;
        esac
        shift
    done

    [ -n "$_root" ] || _root="$PROJECT_ROOT"
    if [ -z "$_id" ]; then
        _id="$(router_app_find_by_project "$_root" 2>/dev/null || true)"
        [ -n "$_id" ] || _id="$(app_generate_uuid)"
    fi

    _saved_project_root="$PROJECT_ROOT"
    PROJECT_ROOT="$_root"
    _assigned="$(local_app_register_logic "$_id" "$_port" "$_root")"
    PROJECT_ROOT="$_saved_project_root"
    [ -n "$_assigned" ] || exit 1

    if [ "$_write_env" -eq 1 ]; then
        _env_file="$_root/.env"
        [ -f "$_env_file" ] || : > "$_env_file"
        env_upsert_kv "$_env_file" SEMITEXA_APP_ID "$_id"
        env_upsert_kv "$_env_file" SWOOLE_PORT "$_assigned"
        success "Wrote SEMITEXA_APP_ID=$_id and SWOOLE_PORT=$_assigned to $_env_file"
    fi

    printf '%s\n' "$_assigned"
}

cmd_local_app_reconcile() {
    printf "\n%s%s Semitexa — Local App Reconcile %s\n\n" "$C_BOLD" "$C_CYAN" "$C_RESET"
    if local_app_reconcile; then
        _id="$(env_val SEMITEXA_APP_ID '')"
        _port="$(env_val SWOOLE_PORT '')"
        success "Reconciled $(basename "$PROJECT_ROOT")."
        info "  SEMITEXA_APP_ID=$_id"
        info "  SWOOLE_PORT=$_port"
        printf "\n"
    else
        exit 1
    fi
}

cmd_local_app_list() {
    printf "\n%s%s Semitexa — Local App Registry %s\n\n" "$C_BOLD" "$C_CYAN" "$C_RESET"
    router_ensure_app_dirs
    _has_any=0
    if [ -d "$ROUTER_APP_REGISTRY_DIR" ]; then
        _count_files="$(find "$ROUTER_APP_REGISTRY_DIR" -maxdepth 1 -type f -name '*.env' 2>/dev/null | wc -l | tr -d ' ')"
        if [ "$_count_files" -gt 0 ]; then
            _has_any=1
        fi
    fi
    if [ "$_has_any" -eq 1 ]; then
        router_app_iter | while IFS="$(printf '\t')" read -r _app_id _port _root _name; do
            printf "  %s%-36s%s  port=%-5s  %s%s%s  %s\n" \
                "$C_GREEN" "$_app_id" "$C_RESET" "$_port" \
                "$C_CYAN" "${_name:-unknown}" "$C_RESET" "${_root:-?}"
        done
    else
        info "No local apps registered."
    fi
    printf "\n"
    info "Range: $(port_range_start)-$(port_range_end)  (override: $ROUTER_CONFIG_FILE)"
    printf "\n"
}

cmd_local_app_remove() {
    _id="${1:-}"
    if [ -z "$_id" ]; then
        error "Usage: bin/semitexa local-app:remove <app-id>"
        exit 1
    fi
    if ! router_app_entry_exists "$_id"; then
        warn "App '$_id' is not registered."
        exit 0
    fi
    APP_ID='' SWOOLE_PORT='' PROJECT_ROOT='' PROJECT_NAME='' REGISTERED_AT='' UPDATED_AT=''
    # shellcheck disable=SC1090
    . "$(router_app_entry_path "$_id")"
    router_app_delete_entry "$_id"
    success "Removed local app: $_id (port ${SWOOLE_PORT:-?}, project ${PROJECT_ROOT:-?})."
}

cmd_local_app_doctor() {
    printf "\n%s%s Semitexa — Local App Doctor %s\n\n" "$C_BOLD" "$C_CYAN" "$C_RESET"
    info "Range: $(port_range_start)-$(port_range_end)"
    info "Registry: $ROUTER_APP_REGISTRY_DIR"
    info "Config:   $ROUTER_CONFIG_FILE"
    cmd_local_app_list
}

# Locate a guard script that ships inside semitexa/theme.
#
# These two lints used to live only in <projectRoot>/scripts/, which in this
# workspace meant they lived nowhere under version control at all — the project
# root is not a git repository, so a machine reinstall would have taken them
# with it, and no consumer ever received them. They now ship with the package
# that owns skins. A project-local copy still wins, so an operator can pin a
# modified guard without editing the package.
#
# Echoes the resolved path, or nothing when no copy is reachable.
find_theme_script() {
    _name="$1"
    for _candidate in \
        "$PROJECT_ROOT/scripts/$_name" \
        "$PROJECT_ROOT/vendor/semitexa/theme/resources/guards/$_name" \
        "$PROJECT_ROOT/packages/semitexa-theme/resources/guards/$_name"
    do
        if [ -f "$_candidate" ]; then
            echo "$_candidate"
            return 0
        fi
    done
    return 1
}

# Run the frontend skin-mode regression guard (lint-skin-legacy-markers.sh).
# Fails when forbidden legacy theme markers reappear in the guarded packages,
# or when the guard would scan nothing at all. Demo + Hello scaffold are
# intentionally NOT scanned (deferred to tk-demo-hello-skin-migration-followup).
cmd_lint_skin_legacy() {
    _script="$(find_theme_script lint-skin-legacy-markers.sh || true)"
    if [ -z "$_script" ]; then
        info "Skin-mode legacy guard script not present in this project."
        info "  (Looked in: scripts/, then semitexa/theme's resources/guards/)"
        info "  This is normal for fresh installs / single-app starters that don't"
        info "  ship the marketing-site packages. Nothing to enforce — skipping."
        exit 0
    fi
    PROJECT_ROOT="$PROJECT_ROOT" sh "$_script" "$@"
}

# Run the canonical skin token-format guard (scripts/lint-skin-tokens.php).
# Fails when any src/skins/<slug>/tokens.css drifts from a fresh TokenEmitter
# rebuild of skin.json, or when the canonical structural markers / forbidden
# legacy markers regress. Runs locally — does not require the app container.
# Run one of the project's PHP scripts on the project's own PHP: the app
# container's. The host's may be missing (an install needs none) or another
# version, and composer's platform check then kills the script before it
# starts. Measured on a GitHub runner with PHP 8.3: a clean project's
# self-test reported the skin token guard FAILED. The caller checks
# is_app_running first: the script's own status comes back unchanged, and no
# exit code — 127 included, which a script can return too — is taken to mean
# "the app is not running".
run_project_php_script() {
    _rpps_script="$1"
    shift
    case "$_rpps_script" in
        "$PROJECT_ROOT"/*) _rpps_script="${_rpps_script#"$PROJECT_ROOT"/}" ;;
    esac
    run_compose exec -T -w /var/www/html -e SEMITEXA_PROJECT_ROOT=/var/www/html app php "$_rpps_script" "$@"
}

cmd_lint_skin_tokens() {
    _script="$(find_theme_script lint-skin-tokens.php || true)"
    if [ -z "$_script" ]; then
        info "Skin token canonical guard script not present in this project."
        info "  (Looked in: scripts/, then semitexa/theme's resources/guards/)"
        info "  This is normal for fresh installs without src/skins/ — skipping."
        exit 0
    fi
    # Whether the app runs is asked, not read off an exit code: the guard can
    # return 127 itself. `|| _lst_status=$?`, not a bare call: under set -e a
    # non-zero status would end the command here. Its own name: sh has no
    # locals, and is_app_running sets _status.
    if is_app_running; then
        _lst_status=0
        run_project_php_script "$_script" "$@" || _lst_status=$?
        exit "$_lst_status"
    fi
    # The app is not running: the host's PHP is the only one left, if it has one.
    if ! command -v php >/dev/null 2>&1; then
        error "lint:skin-tokens runs on the app's PHP: start it first (bin/semitexa server:start)."
        exit 1
    fi
    SEMITEXA_PROJECT_ROOT="$PROJECT_ROOT" php "$_script" "$@"
}

# Returns 0 if the captured compose log contains a clear port-conflict signal
# AND mentions <port>. Conservative: only fires when both halves match, so
# unrelated compose failures fall through to the default error path.
server_start_log_signals_port_conflict() {
    _file="$1"
    _port="$2"
    [ -f "$_file" ] || return 1
    [ -n "$_port" ] || return 1
    grep -qE "(port is already allocated|address already in use|Bind for [^ ]+ failed)" "$_file" || return 1
    grep -qE "(:|\.)$_port([^0-9]|\$)" "$_file"
}

# Before the app ran as the host user, the server and every `compose exec`
# were root, and what they wrote into the project (var/, generated docs, the
# quality baseline, caches) stayed root-owned: the developer could not edit
# it, and the server, now no longer root, could not rewrite it. Hand every
# root-owned file back once, through a root one-off container, so no sudo is
# needed. A clean project pays one host-side find; a root host has nothing to
# reclaim. Never fatal: the stack still starts, and the warning says why.
project_ownership_reclaim() {
    # The ids the services will actually run as, not merely the caller's.
    _reclaim_ids="$(env_export_compose_context; printf '%s:%s' "$SEMITEXA_UID" "$SEMITEXA_GID")"
    _reclaim_uid="${_reclaim_ids%%:*}"
    _reclaim_gid="${_reclaim_ids##*:}"

    # Under rootless Docker only container root is the host user; any other
    # uid maps to a subordinate id that cannot write the developer's files.
    if [ "$_reclaim_uid" != 0 ] && [ "$(id -u)" != 0 ] && docker_is_rootless; then
        error "SEMITEXA_UID=$_reclaim_uid under rootless Docker: the app would run as a subordinate id that cannot write this project."
        info  "Unset SEMITEXA_UID/SEMITEXA_GID (in .env or the environment); under rootless Docker the app runs as 0:0, which is you."
        return 1
    fi
    # Under rootless Docker no container can chown a file owned by HOST root
    # (container root is the host user), whatever service uid is configured —
    # files a rootful engine left behind need the host. Checked first.
    _reclaim_root="$(find "$PROJECT_ROOT" -xdev -user 0 -print 2>/dev/null | head -n 1)"
    if [ -n "$_reclaim_root" ] && [ "$(id -u)" != 0 ] && docker_is_rootless; then
        error "Host-root-owned project files (e.g. ${_reclaim_root#"$PROJECT_ROOT"/}) are left from a rootful Docker; under rootless Docker the app cannot write them."
        info  "Fix on the host: sudo chown -R $(id -u):$(id -g) \"$PROJECT_ROOT\""
        return 1
    fi
    # A root service user writes root files anyway.
    [ "$_reclaim_uid" != 0 ] || return 0

    # Whose files the service user cannot write: root's (a root container or
    # exec), and uid 1000's — the image's own user, which every container ran
    # as before the host uid was passed — when the host user is someone else.
    if [ "$_reclaim_uid" = 1000 ]; then
        _reclaim_first="$_reclaim_root"
        set -- -user 0
    else
        _reclaim_first="$(find "$PROJECT_ROOT" -xdev \( -user 0 -o -user 1000 \) -print 2>/dev/null | head -n 1)"
        set -- \( -user 0 -o -user 1000 \)
    fi
    [ -n "$_reclaim_first" ] || return 0

    info "Handing project files to the app user ($_reclaim_uid:$_reclaim_gid), e.g. ${_reclaim_first#"$PROJECT_ROOT"/}"
    # Build first: the image may be gone (pruned, first start after an
    # update). A separate `build`, not `run --build`, which Compose v1 lacks.
    # Errors stay on screen: a hidden one left only the later "files remain"
    # line, which names the wrong cause. In a subshell: run_compose assigns
    # _compose/_overlays, and a caller (test:run, between choosing the test
    # overlay and using it) keeps its own.
    ( _reclaim_build="$(run_compose build app 2>&1)" || {
          warn "Could not build the app image for the ownership handover; trying the existing one:"
          printf '%s\n' "$_reclaim_build" | tail -n 5 >&2
      }
      run_compose run --rm --no-deps -T --user 0:0 app \
        find /var/www/html -xdev "$@" -exec chown -h "$_reclaim_uid:$_reclaim_gid" {} + ) \
        || warn "The ownership handover container failed (see above)."

    # A warning, not a refusal: a container still running from before the
    # restart may write a file between the handover and its own stop, and the
    # next start or restart hands that one over too.
    _reclaim_left="$(find "$PROJECT_ROOT" -xdev "$@" -print 2>/dev/null | head -n 1)"
    if [ -n "$_reclaim_left" ]; then
        warn "Project files the app ($_reclaim_uid:$_reclaim_gid) cannot write remain, e.g. ${_reclaim_left#"$PROJECT_ROOT"/}."
        warn "Fix by hand: docker run --rm -v \"$PROJECT_ROOT\":/w alpine:3 chown -R $_reclaim_uid:$_reclaim_gid /w"
    fi
    return 0
}

# Wraps `run_compose up -d --build`, capturing exit + log so we can offer to
# auto-recover from a Swoole port conflict that slipped past pre-start
# reconcile (e.g., another process bound the broker-assigned port in the gap).
# Behavior:
#   - On success: nothing extra; return 0.
#   - On failure that is confidently a port conflict for our SWOOLE_PORT:
#       * interactive shell → prompt (default Y), reconcile, retry once.
#       * non-interactive   → auto-reconcile, retry once (no prompt, no hang).
#       * if reconcile didn't change the port (conflict is from a non-Semitexa
#         process) → surface a clear error with a suggested next command.
#   - On any other failure: pass through the original exit code.
server_start_run_with_port_conflict_fallback() {
    _log_file="$(mktemp)"
    _rc_file="$(mktemp)"
    # Subshell + `set +e` so a non-zero compose exit doesn't abort the outer
    # script. tee preserves the developer's real-time view of the build.
    ( set +e; run_compose up -d --build; echo "$?" > "$_rc_file" ) 2>&1 | tee "$_log_file"
    _rc="$(cat "$_rc_file" 2>/dev/null || echo 1)"
    rm -f "$_rc_file"

    if [ "$_rc" -eq 0 ]; then
        rm -f "$_log_file"
        return 0
    fi

    _port="$(env_val SWOOLE_PORT '')"
    if [ -z "$_port" ] || ! server_start_log_signals_port_conflict "$_log_file" "$_port"; then
        rm -f "$_log_file"
        return "$_rc"
    fi

    printf "\n"
    warn "Swoole port conflict detected for SWOOLE_PORT=${_port}."

    _accept=0
    if [ -e /dev/tty ] && [ -t 1 ]; then
        printf "%s? Do you want Semitexa to reconcile this app with the local port broker and assign a free port? [Y/n]%s " "$C_YELLOW" "$C_RESET"
        _ans=""
        read -r _ans </dev/tty 2>/dev/null || _ans=""
        case "$_ans" in
            ''|y|Y|yes|Yes|YES) _accept=1 ;;
            *)                  _accept=0 ;;
        esac
    else
        info "Non-interactive shell; auto-reconciling without prompt."
        _accept=1
    fi

    if [ "$_accept" -ne 1 ]; then
        info "Run: bin/semitexa local-app:reconcile && bin/semitexa server:start"
        rm -f "$_log_file"
        return "$_rc"
    fi

    rm -f "$_log_file"
    local_app_reconcile || warn "Reconcile reported a problem."

    _new_port="$(env_val SWOOLE_PORT '')"
    if [ "$_new_port" = "$_port" ]; then
        error "Reconcile kept SWOOLE_PORT=${_port}; the conflict appears to be from a non-Semitexa process holding the port."
        info "Inspect with: bin/semitexa local-app:doctor"
        info "Or release the port and re-run: bin/semitexa server:start"
        return "$_rc"
    fi

    info "Reconciled to SWOOLE_PORT=${_new_port}. Retrying server:start once..."
    _log_file="$(mktemp)"
    _rc_file="$(mktemp)"
    ( set +e; run_compose up -d --build; echo "$?" > "$_rc_file" ) 2>&1 | tee "$_log_file"
    _rc="$(cat "$_rc_file" 2>/dev/null || echo 1)"
    rm -f "$_rc_file" "$_log_file"

    if [ "$_rc" -eq 0 ]; then
        success "Recovered: server bound to SWOOLE_PORT=${_new_port}."
    else
        error "Retry failed (exit $_rc). Re-run 'bin/semitexa server:start' or inspect docker compose logs."
    fi
    return "$_rc"
}

# ═══════════════════════════════════════════════════════════════════════
#  server:start
# ═══════════════════════════════════════════════════════════════════════
# ── Dev-stack events: who started, stopped or restarted the stack ─────────
# Several agents share one stack. A restart runs `down --remove-orphans`,
# which also removes every one-off `compose run` container the others were
# using, and until now nothing said who did it or why — the others found out
# by having their work vanish. Each lifecycle command now appends one line to
# var/ai-work/stack-events.ndjson (read by ai:orient and ai:agent list), and
# names the live agents it is about to interrupt. It warns; it does not block.
stack_event() {
    _se_dir="$PROJECT_ROOT/var/ai-work"
    # Never blocks the lifecycle command, but never fails silently either:
    # an unrecorded restart is exactly the one nobody can attribute later.
    if ! mkdir -p "$_se_dir" 2>/dev/null; then
        warn "could not create $_se_dir; stack event '$1' was not recorded"
        return 0
    fi
    _se_by="${SEMITEXA_AGENT_SESSION:-}"
    case "$_se_by" in ''|*[!A-Za-z0-9_.:-]*) _se_by="" ;; esac
    # Detail comes from arguments; quotes, backslashes and control characters
    # are dropped so the line stays one valid JSON object.
    _se_detail="$(printf '%s' "${2:-}" | tr -d '"\\\000-\037' | cut -c1-120)"
    printf '{"at":"%s","action":"%s","by":%s,"user":"%s","detail":"%s"}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" \
        "$1" \
        "$( [ -n "$_se_by" ] && printf '"%s"' "$_se_by" || printf 'null')" \
        "$(id -un 2>/dev/null | tr -d '"\\' || printf '?')" \
        "$_se_detail" >> "$_se_dir/stack-events.ndjson" 2>/dev/null \
        || warn "could not append stack event '$1' to $_se_dir/stack-events.ndjson"
}

# Live agents other than the caller: a session file touched in the last 15
# minutes (every ai:* command touches it) that has not ended. Sessions live in
# the machine-wide store (and, from before it, the project's own); only the
# ones of this project, or holding a task of its backlog, use this stack.
stack_warn_live_agents() {
    # The store compose mounts: the caller's, else .env's, else the default.
    # A store env_export_compose_context rejects puts sessions in _sw_own, read below.
    _sw_shared="${SEMITEXA_AGENTS_HOST_DIR:-}"
    if [ -z "$_sw_shared" ] && command -v env_val >/dev/null 2>&1; then
        _sw_shared="$(env_val SEMITEXA_AGENTS_HOST_DIR '')"
    fi
    _sw_shared="${_sw_shared:-${SEMITEXA_HOME:-$HOME/.semitexa}/agents}"
    # JSON escapes the slashes of a path only when told to; AgentRegistry does not.
    _sw_mine="\"$PROJECT_ROOT\""
    # Read line by line, never word-split: a project path with a space in it
    # would otherwise turn each session file into two names that do not exist,
    # and the agent working there would get no warning at all.
    _sw_own="$PROJECT_ROOT/var/ai-work/agents"
    _sw_found="$(for _sw_dir in "$_sw_shared" "$_sw_own"; do
        [ "$_sw_dir" = "$_sw_shared" ] || [ "$_sw_shared" != "$_sw_own" ] || continue
        [ -d "$_sw_dir" ] && find "$_sw_dir" -name '*.json' -mmin -15 2>/dev/null
    done | while IFS= read -r _sw_file; do
        grep -q '"ended_at": null' "$_sw_file" 2>/dev/null || continue
        # A session from before sessions named their project is the store's own.
        if grep -q '"project": "' "$_sw_file" 2>/dev/null; then
            grep -F -q -e "\"project\": $_sw_mine" -e "\"task_project\": $_sw_mine" "$_sw_file" 2>/dev/null || continue
        elif [ "$(dirname "$_sw_file")" = "$_sw_shared" ] && [ "$_sw_shared" != "$_sw_own" ]; then
            continue
        fi
        _sw_id="$(basename "$_sw_file" .json)"
        [ "$_sw_id" = "${SEMITEXA_AGENT_SESSION:-}" ] && continue
        _sw_intent="$(sed -n 's/^ *"intent": "\(.*\)",$/\1/p' "$_sw_file" | head -1)"
        printf '      %s — %s\n' "$_sw_id" "$_sw_intent"
    done)"
    [ -n "$_sw_found" ] || return 0
    warn "Other agents are working in this project right now:"
    printf '%s\n' "$_sw_found" >&2
    # A service restart recreates one container and runs no `down`; only the
    # full stop/restart removes the others' one-off CLI containers.
    if [ -n "${2:-}" ]; then
        warn "This $1 recreates the '$2' container; if that is app, their running server requests are cut off."
    else
        warn "This $1 interrupts the running server, and removes their one-off CLI containers."
    fi
    [ -n "${SEMITEXA_AGENT_SESSION:-}" ] || warn "You have not joined (ai:agent join): the stack log will record this $1 as by nobody."
}

# Settings that start fine and go wrong later, said before the containers start.
server_start_config_warnings() {
    # Unset is prod, as the server reads it.
    if [ "$(env_val APP_ENV prod)" = "prod" ]; then
        # .env.default is the dev baseline (APP_DEBUG=1): a prod .env that leaves
        # APP_DEBUG out inherits it and shows error details to visitors.
        case "$(env_val APP_DEBUG 0)" in
            1|true|TRUE|yes|on) warn "APP_ENV=prod with APP_DEBUG on: error pages show details. Set APP_DEBUG=0 in .env." ;;
        esac
        # One worker: nothing serves while it is recycled. Without a request
        # limit too, Swoole gives it no manager and a recycle ends the server.
        _workers="$(env_val SWOOLE_WORKER_NUM 4)"
        case "$_workers" in ''|*[!0-9]*) _workers=0 ;; esac
        if [ "$_workers" -eq 1 ]; then
            _max_request="$(env_val SWOOLE_MAX_REQUEST 10000)"
            # As the server's (int) reads it: the leading digits (a sign of +
            # allowed), and anything but a positive count is none.
            _max_digits="$(printf '%s' "$_max_request" | sed -n 's/^+\{0,1\}\([0-9][0-9]*\).*/\1/p')"
            _has_manager=0
            [ -n "$_max_digits" ] && [ "$_max_digits" -gt 0 ] && _has_manager=1
            if [ "$_has_manager" = 1 ]; then
                warn "APP_ENV=prod with SWOOLE_WORKER_NUM=1: while the worker is recycled (SWOOLE_MAX_REQUEST, the memory watchdog, a fatal error) nothing serves and every open connection is cut. Set SWOOLE_WORKER_NUM=2 or more in .env."
            else
                warn "APP_ENV=prod with SWOOLE_WORKER_NUM=1 and SWOOLE_MAX_REQUEST=$_max_request: the worker runs without a manager, so a memory-watchdog recycle or a fatal error ends the whole server until the container is started again. Set SWOOLE_WORKER_NUM=2 or more in .env."
            fi
        fi
    fi
    # The mysql image creates DB_USERNAME as a user and refuses root, but only
    # on a new volume: an existing one has been set up and hides it.
    if [ "$(env_val DB_DRIVER "")" = "mysql" ] && [ -f "$PROJECT_ROOT/docker-compose.mysql.yml" ] \
        && [ "$(env_val DB_USERNAME semitexa)" = "root" ]; then
        warn "DB_USERNAME=root: the mysql service creates DB_USERNAME as its user and refuses root, so on a new database volume it never starts. Set another DB_USERNAME in .env (the scaffold uses semitexa); root's password is DB_ROOT_PASSWORD."
    fi
}

cmd_server_start() {
    printf "\n%s%s Semitexa — Starting Environment %s\n\n" "$C_BOLD" "$C_CYAN" "$C_RESET"

    if [ ! -f "$PROJECT_ROOT/docker-compose.yml" ]; then
        error "docker-compose.yml not found."
        info  "Run: bin/semitexa init"
        exit 1
    fi

    # Reconcile local app registry: ensure SEMITEXA_APP_ID exists in .env and
    # SWOOLE_PORT is unique on this workstation. May rewrite .env when a port
    # collision is detected. compose_args reads .env, so this must run first.
    local_app_reconcile || warn "Local app reconcile reported a problem; continuing with current .env."
    stack_event start

    _overlays="$(compose_args)"
    [ -n "$_overlays" ] && info "Compose files: $_overlays"

    server_start_config_warnings

    # ── Pre-flight Checks (Proxy & DNS) ──────────────────────────────
    if project_has_shared_domains; then
        router_sync_project_domains
        if command -v ss >/dev/null 2>&1; then
            _port80_pid="$(ss -ltnp 2>/dev/null | awk '$4 ~ /:80$/ {print $6}' | sed -n 's/.*pid=\([0-9]*\).*/\1/p' | head -n 1)"
            if [ -n "$_port80_pid" ]; then
                _port80_proc="$(ps -p "$_port80_pid" -o comm= 2>/dev/null || echo "unknown")"
                if [ "$_port80_proc" != "docker-proxy" ] && [ "$_port80_proc" != "docker" ] && [ "$_port80_proc" != "dockerd" ]; then
                    warn "Port 80 is occupied by '$_port80_proc' (PID: $_port80_pid)."
                    warn "The shared Semitexa proxy will fail to start."
                    printf "%s? Do you want to stop it now? (requires sudo) [Y/n]%s " "$C_YELLOW" "$C_RESET"
                    read -r _ans </dev/tty
                    if [ "$_ans" != "n" ] && [ "$_ans" != "N" ]; then
                        sudo systemctl stop "$_port80_proc" 2>/dev/null || sudo kill -9 "$_port80_pid"
                        success "Attempted to stop $_port80_proc."
                    fi
                    echo ""
                fi
            fi
        fi

        info "Project uses shared local routing. Ensuring shared router is running..."
        if ! router_start_for_mode; then
            error "Failed to start the shared local router."
            info "Inspect it with: bin/semitexa local-router:doctor"
            exit 1
        fi
    fi

    project_ownership_reclaim || exit 1
    info "Starting containers..."
    server_start_run_with_port_conflict_fallback || exit $?
    # Up, then connect, then render and reload: a router started before the
    # app has no network to join yet.
    router_attach_project

    _port="$(env_val SWOOLE_PORT 8080)"
    printf "\n"
    success "Semitexa environment started!"

    # Show project-specific URLs. Shared-router (.test) domains take priority;
    # fall back to http://localhost:<port> when no domains are registered.
    if project_has_shared_domains; then
        info "App URLs:"
        router_list_project_domains | while IFS= read -r _dom; do
            [ -n "$_dom" ] || continue
            printf "          ${C_GREEN}http://%s${C_RESET}\n" "$_dom"
        done
        printf "          ${C_CYAN}http://localhost:%s${C_RESET} (direct)\n" "$_port"
    else
        info "App:  ${C_GREEN}http://localhost:${_port}${C_RESET}"
    fi
    info "Logs: docker compose logs -f"
    info "Stop: bin/semitexa server:stop"

    _async="$(env_val EVENTS_ASYNC 0)"
    case "$_async" in
        1|true|yes)
            [ -f "$PROJECT_ROOT/docker-compose.nats.yml" ] && wait_for_service "NATS" "nats" "4222" 3 2 1 || true
            ;;
    esac

    _db="$(env_val DB_DRIVER "")"
    if [ "$_db" = "mysql" ] && [ -f "$PROJECT_ROOT/docker-compose.mysql.yml" ]; then
        wait_for_mysql || true
    fi

    _redis="$(env_val REDIS_HOST "")"
    [ -n "$_redis" ] && [ -f "$PROJECT_ROOT/docker-compose.redis.yml" ] && wait_for_service "Redis" "redis" "6379" 3 2 1 || true

    printf "\n"
}

# ═══════════════════════════════════════════════════════════════════════
#  server:stop
# ═══════════════════════════════════════════════════════════════════════
cmd_server_stop() {
    printf "\n%s%s Semitexa — Stopping Environment %s\n\n" "$C_BOLD" "$C_CYAN" "$C_RESET"

    if [ ! -f "$PROJECT_ROOT/docker-compose.yml" ]; then
        warn "docker-compose.yml not found. Nothing to stop."
        exit 0
    fi

    stack_warn_live_agents stop
    stack_event stop
    info "Stopping containers..."
    router_detach_project
    _compose="$(compose_bin)"
    _overlays="$(compose_all_args)"
    # shellcheck disable=SC2086
    $_compose $_overlays down --remove-orphans
    success "Semitexa environment stopped."

    for _pidfile in "$PROJECT_ROOT/var/swoole.pid" "$PROJECT_ROOT/var/run/semitexa.pid"; do
        if [ -f "$_pidfile" ]; then
            _pid="$(cat "$_pidfile" 2>/dev/null || true)"
            [ -n "$_pid" ] && kill "$_pid" 2>/dev/null || true
            rm -f "$_pidfile"
        fi
    done

    printf "\n"
}

# ═══════════════════════════════════════════════════════════════════════
#  server:restart
# ═══════════════════════════════════════════════════════════════════════

# `docker compose build` for a restart: success is silent, failure is a warning
# and the caller starts the containers from the images it already has. Never
# an exit — a restart that cannot rebuild must still bring the stack back up.
# Nothing is hidden: the compose output stays on screen, and the warning names
# the consequence (a possibly stale image) and the way out.
server_restart_build_or_warn() {
    if run_compose build "$@"; then
        return 0
    fi
    warn "Image build failed — restarting on the existing images instead (they may be stale)."
    warn "Fix the network / Dockerfile problem, then run 'bin/semitexa server:restart' again to pick up a fresh build."
    return 0
}
cmd_server_restart() {
    _service="${1:-}"
    printf "\n%s%s Semitexa — Restarting Environment %s\n\n" "$C_BOLD" "$C_CYAN" "$C_RESET"

    if [ ! -f "$PROJECT_ROOT/docker-compose.yml" ]; then
        error "docker-compose.yml not found."
        exit 1
    fi

    _compose="$(compose_bin)"
    stack_warn_live_agents restart "$_service"
    stack_event restart "$_service"
    project_ownership_reclaim || exit 1

    # Build BEFORE anything is taken down. `up -d --build` did both in one
    # step, so a build that could not reach Docker Hub (a DNS blip, a laptop
    # offline) died after `down` had already run and left the developer with
    # no stack at all — measured 2026-09-10. A failed build is now a warning:
    # the restart goes ahead on the images that already exist, and says so.
    if [ -n "$_service" ]; then
        info "Recreating service: $_service"
        server_restart_build_or_warn "$_service"
        run_compose up -d --no-build --force-recreate --no-deps "$_service"
    else
        info "Recreating all containers..."
        # Before down: run_compose refuses the up when var/run/worker.env
        # cannot be written, and after down that left no stack at all.
        if ! compose_write_worker_env; then
            error "Not restarting: the running containers are left as they are. Make var/run writable, then run server:restart again."
            exit 1
        fi
        server_restart_build_or_warn
        _overlays="$(compose_all_args)"
        router_detach_project
        # shellcheck disable=SC2086
        $_compose $_overlays down --remove-orphans
        run_compose up -d --no-build
    fi
    # A new network after down/up, a new container after a recreate: the
    # router joins it again and the domains follow.
    router_attach_project
    # Again after the swap: the old root container could still write a file
    # between the first pass and its own stop.
    project_ownership_reclaim

    success "Semitexa environment restarted!"
    printf "\n"
}

# ═══════════════════════════════════════════════════════════════════════
cmd_list() {
    printf "\n%s%s Semitexa Framework %s— CLI Commands\n\n" "$C_BOLD" "$C_GREEN" "$C_CYAN"
    printf "%s%s Shell Commands (no PHP required):%s\n" "$C_BOLD" "$C_YELLOW" "$C_RESET"
    printf "  %-32s %s\n" "install"       "Run composer install inside Docker (no local PHP needed)"
    printf "  %-32s %s\n" "demo:install"  "Install semitexa/demo inside Docker"
    printf "  %-32s %s\n" "server:start"   "Start Semitexa environment (Docker Compose)"
    printf "  %-32s %s\n" "server:stop"    "Stop Semitexa environment"
    printf "  %-32s %s\n" "server:restart" "Restart Semitexa environment and refresh env/config"
    printf "  %-32s %s\n" "local-router:init"       "Prepare shared local router workspace"
    printf "  %-32s %s\n" "local-router:start"      "Start shared local router"
    printf "  %-32s %s\n" "local-router:stop"       "Stop shared local router"
    printf "  %-32s %s\n" "local-router:restart"    "Restart shared local router"
    printf "  %-32s %s\n" "local-router:doctor"     "Inspect shared local router state"
    printf "  %-32s %s\n" "local-domain:mode [dns|hosts]" "Get or set shared local domain mode"
    printf "  %-32s %s\n" "local-domain:add <domain.test>" "Register shared local domain"
    printf "  %-32s %s\n" "local-domain:remove <domain.test>" "Remove shared local domain"
    printf "  %-32s %s\n" "local-domain:list"       "List shared local domains"
    printf "  %-32s %s\n" "local-app:register"      "Register this project; allocate Swoole port"
    printf "  %-32s %s\n" "local-app:reconcile"     "Validate / reassign Swoole port for this project"
    printf "  %-32s %s\n" "local-app:list"          "List local app registrations and ports"
    printf "  %-32s %s\n" "local-app:remove <id>"   "Remove an app from the local registry"
    printf "  %-32s %s\n" "local-app:doctor"        "Inspect local app registry health"
    printf "  %-32s %s\n" "lint:skin-legacy"        "Regression guard for the unified frontend skin-mode contract"
    printf "  %-32s %s\n" "lint:skin-tokens"        "Regression guard for the canonical skin token format (skin.json + tokens.css)"
    printf "  %-32s %s\n" "test:run [-- phpunit-args]" "Run PHPUnit then E2E (Playwright) inside Docker (APP_ENV=dev)"
    printf "  %-32s %s\n" "mcp"                   "MCP server on stdio for a coding agent (dev only)"
    printf "  %-32s %s\n" "mcp:config"            "Print how to connect Claude Code, Cursor or Claude Desktop to it"
    printf "  %-32s %s\n" "self-test"             "Verify setup"
    printf "  %-32s %s\n" "list"                  "Show this help"

    if [ "${1:-}" = "--shell-only" ]; then
        printf '\nPHP command help needs an installed runtime; no services were started.\n'
        return 0
    fi

    printf "\n%s%s PHP Commands (proxied to app container):%s\n" "$C_BOLD" "$C_YELLOW" "$C_RESET"
    if is_app_running; then
        run_compose exec -T app php vendor/bin/semitexa list --raw 2>/dev/null | while IFS= read -r _line; do
            _cmd="$(echo "$_line" | awk '{print $1}')"; _desc="$(echo "$_line" | sed 's/^[^ ]* *//')"
            case "$_cmd" in server:start|server:stop|server:restart|list|"") continue ;; esac
            printf "  %-32s %s\n" "$_cmd" "$_desc"
        done
    else
        info "(Start the server first to see all PHP commands)"
    fi
    printf "\n"
}

cmd_self_test() {
    printf "\n%s%s Semitexa — Self Test %s\n\n" "$C_BOLD" "$C_CYAN" "$C_RESET"
    _ok=0 _warn=0 _fail=0
    if command -v docker >/dev/null 2>&1; then success "Docker: $(docker --version 2>/dev/null)"; _ok=$((_ok+1)); else error "Docker: not found"; _fail=$((_fail+1)); fi
    if has_compose; then success "Compose: $(docker compose version 2>/dev/null || docker-compose version 2>/dev/null)"; _ok=$((_ok+1)); else error "Compose: not found"; _fail=$((_fail+1)); fi
    for _f in docker-compose.yml Dockerfile server.php .env.default composer.json; do
        if [ -f "$PROJECT_ROOT/$_f" ]; then success "File: $_f"; _ok=$((_ok+1)); else
            error "File: $_f (missing)"; _fail=$((_fail+1))
        fi
    done
    if [ -f "$PROJECT_ROOT/.env" ]; then success "File: .env"; _ok=$((_ok+1)); else info "File: .env (optional override, not present)"; fi
    [ -f "$PROJECT_ROOT/vendor/bin/semitexa" ] && { success "File: vendor/bin/semitexa"; _ok=$((_ok+1)); } || { error "File: vendor/bin/semitexa (missing)"; _fail=$((_fail+1)); }
    _arch="$(uname -m 2>/dev/null || echo unknown)"
    case "$_arch" in x86_64|amd64) success "Arch: AMD64" ;; aarch64|arm64) success "Arch: ARM64" ;; *) warn "Arch: $_arch (untested)" ;; esac
    if is_app_running; then success "App container: running"; _ok=$((_ok+1)); else info "App container: not running"; fi
    _skin_legacy="$(find_theme_script lint-skin-legacy-markers.sh || true)"
    # The legacy-marker guard scans four of the framework's own checkouts
    # (packages/semitexa-theme, -demo, -ultimate, -showcase-kit). A consumer
    # project has none of them (a module of its own made by
    # make:module --target=package does not count), and the guard would fail
    # with "verified NOTHING": report it as not applicable there instead.
    _has_workspace_packages=0
    for _dir in theme demo ultimate showcase-kit; do
        [ -d "$PROJECT_ROOT/packages/semitexa-$_dir" ] && { _has_workspace_packages=1; break; }
    done
    if [ -n "$_skin_legacy" ] && [ "$_has_workspace_packages" -eq 0 ]; then
        info "Skin-mode legacy guard: not applicable (none of the packages it scans is in this project; framework workspace only)"
    elif [ -n "$_skin_legacy" ]; then
        if ( PROJECT_ROOT="$PROJECT_ROOT" sh "$_skin_legacy" >/dev/null 2>&1 ); then
            success "Skin-mode legacy guard: clean"; _ok=$((_ok+1))
        else
            error "Skin-mode legacy guard: FAILED — run 'bin/semitexa lint:skin-legacy' for details"; _fail=$((_fail+1))
        fi
    fi
    _skin_tokens="$(find_theme_script lint-skin-tokens.php || true)"
    if [ -n "$_skin_tokens" ]; then
        # On the app's PHP only: the host's is not the project's (see run_project_php_script).
        if ! is_app_running; then
            info "Skin token canonical guard: not run (it runs on the app's PHP; the app is not running)"
        else
            _skin_tokens_status=0
            run_project_php_script "$_skin_tokens" >/dev/null 2>&1 || _skin_tokens_status=$?
            if [ "$_skin_tokens_status" -eq 0 ]; then
                success "Skin token canonical guard: clean"; _ok=$((_ok+1))
            else
                error "Skin token canonical guard: FAILED — run 'bin/semitexa lint:skin-tokens' for details"; _fail=$((_fail+1))
            fi
        fi
    fi
    printf "\n  Results: %s%d OK%s, %s%d Warn%s, %s%d Error%s\n\n" "$C_GREEN" "$_ok" "$C_RESET" "$C_YELLOW" "$_warn" "$C_RESET" "$C_RED" "$_fail" "$C_RESET"
    [ "$_fail" -gt 0 ] && exit 1; exit 0
}

local_semitexa_package_names() {
    for _dir in "$PROJECT_ROOT"/packages/semitexa-*; do
        [ -f "$_dir/composer.json" ] || continue
        awk -F'"' '
            $2 == "name" && $4 ~ /^semitexa\// {
                print $4
                exit
            }
        ' "$_dir/composer.json"
    done | sort -u
}

locked_semitexa_package_names() {
    [ -f "$PROJECT_ROOT/composer.lock" ] || return 0

    grep -o '"name"[[:space:]]*:[[:space:]]*"semitexa/[^"]*"' "$PROJECT_ROOT/composer.lock" 2>/dev/null \
        | sed 's/.*"name"[[:space:]]*:[[:space:]]*"//' \
        | sed 's/"$//' \
        | sort -u
}

local_semitexa_package_update_specs() {
    _tmp_local="$(mktemp)"
    _tmp_locked="$(mktemp)"
    local_semitexa_package_names >"$_tmp_local"
    locked_semitexa_package_names >"$_tmp_locked"

    for _dir in "$PROJECT_ROOT"/packages/semitexa-*; do
        [ -f "$_dir/composer.json" ] || continue

        _package="$(awk -F'"' '
            $2 == "name" && $4 ~ /^semitexa\// {
                print $4
                exit
            }
        ' "$_dir/composer.json")"
        [ -n "$_package" ] || continue

        if ! grep -Fx -- "$_package" "$_tmp_locked" >/dev/null 2>&1; then
            continue
        fi

        _branch=''
        if [ -d "$_dir/.git" ]; then
            _branch="$(git -C "$_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
        fi

        case "$_branch" in
            ''|HEAD)
                printf '%s\n' "$_package"
                ;;
            *)
                printf '%s:dev-%s\n' "$_package" "$_branch"
                ;;
        esac
    done | sort -u

    rm -f "$_tmp_local" "$_tmp_locked"
}

refresh_local_semitexa_packages() {
    _packages="$(local_semitexa_package_update_specs)"
    [ -n "$_packages" ] || return 0

    info "Refreshing local Semitexa path packages in composer.lock..."
    info "(This keeps workspace clones ahead of stale published tags)\n"

    # shellcheck disable=SC2086
    run_compose run --rm --no-deps --user "$(id -u):$(id -g)" app \
        composer update --no-interaction --with-all-dependencies $_packages
}

cmd_install() {
    printf "\n%s%s Semitexa — Install Dependencies %s\n\n" "$C_BOLD" "$C_CYAN" "$C_RESET"
    if ! has_compose; then error "Docker Compose is required. Install Docker Desktop or docker-compose."; exit 1; fi
    if [ ! -f "$PROJECT_ROOT/Dockerfile" ]; then error "Dockerfile not found. Cannot build container for installation."; exit 1; fi
    if [ ! -f "$PROJECT_ROOT/composer.json" ]; then error "composer.json not found. Is this a Semitexa project?"; exit 1; fi
    if [ ! -f "$PROJECT_ROOT/.env.default" ]; then error ".env.default not found. This project is missing its Semitexa baseline configuration."; exit 1; fi
    info "Building Docker image and running composer install inside container..."
    info "(This may take a few minutes on the first run)\n"
    run_compose build app
    run_compose run --rm --no-deps --user "$(id -u):$(id -g)" app composer install --no-interaction --prefer-dist
    if [ $? -ne 0 ]; then
        printf "\n"
        error "Installation failed. Check the output above."
        exit 1
    fi

    refresh_local_semitexa_packages
    if [ $? -eq 0 ]; then printf "\n"; success "Dependencies installed successfully!"; info "Next: bin/semitexa server:start"
    else printf "\n"; error "Installation failed. Check the output above."; exit 1; fi
    printf "\n"
}

cmd_demo_install() {
    printf "\n%s%s Semitexa — Install Demo %s\n\n" "$C_BOLD" "$C_CYAN" "$C_RESET"
    if ! has_compose; then error "Docker Compose is required. Install Docker Desktop or docker-compose."; exit 1; fi
    if [ ! -f "$PROJECT_ROOT/Dockerfile" ]; then error "Dockerfile not found. Cannot build container for demo installation."; exit 1; fi
    if [ ! -f "$PROJECT_ROOT/composer.json" ]; then error "composer.json not found. Is this a Semitexa project?"; exit 1; fi
    if [ ! -f "$PROJECT_ROOT/.env.default" ]; then error ".env.default not found. This project is missing its Semitexa baseline configuration."; exit 1; fi
    info "Installing semitexa/demo via Composer inside Docker..."
    info "(This may take a few minutes on the first run)\n"
    run_compose build app
    run_compose run --rm --no-deps --user "$(id -u):$(id -g)" app composer config repositories.semitexa-demo vcs https://github.com/semitexa/semitexa-demo.git
    run_compose run --rm --no-deps --user "$(id -u):$(id -g)" app composer require semitexa/demo:* --no-interaction --prefer-dist
    if [ $? -eq 0 ]; then printf "\n"; success "Semitexa Demo installed (semitexa/demo)."; info "Start or restart the server to load the new routes."; info "Remove when done: composer remove semitexa/demo"
    else printf "\n"; error "Demo installation failed. Check the output above."; exit 1; fi
    printf "\n"
}

cmd_init() {
    if ! has_compose; then error "Docker is required. Install Docker Desktop."; exit 1; fi
    if [ ! -f "$PROJECT_ROOT/Dockerfile" ]; then error "Dockerfile not found."; exit 1; fi
    if [ ! -f "$PROJECT_ROOT/.env.default" ]; then
        if command -v php >/dev/null 2>&1 && [ -f "$PROJECT_ROOT/vendor/bin/semitexa" ]; then
            warn ".env.default not found. Falling back to local PHP so init can scaffold it."
            php "$PROJECT_ROOT/vendor/bin/semitexa" init "$@"
            return
        fi
        error ".env.default not found. Run init once with local PHP so the scaffold can create it."
        exit 1
    fi
    info "Running init via Docker..."
    run_compose run --rm --no-deps --user "$(id -u):$(id -g)" app php vendor/bin/semitexa init "$@"
}

# Discover module-level E2E spec dirs. Every Semitexa package and local module
# owns its tests under `tests/{Unit,Integration,E2E}/`; this function walks the
# E2E category in both packages and src/modules and echoes one spec dir per
# line that contains at least one *.spec.ts file.
discover_e2e_dirs() {
    if [ -d "$PROJECT_ROOT/packages" ]; then
        for _dir in "$PROJECT_ROOT"/packages/*/tests/E2E; do
            [ -d "$_dir" ] || continue
            # Same guard as the PHPUnit discovery: only sweep E2E specs of
            # packages composer actually installed — a release/tagging
            # checkout keeps every package repo under packages/ while the
            # app runs with a subset, and a not-installed package's specs
            # exercise routes the app does not even serve.
            _pkg_composer="${_dir%/tests/E2E}/composer.json"
            if [ -f "$_pkg_composer" ]; then
                _pkg_name="$(sed -n 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$_pkg_composer" | head -n 1)"
                if [ -n "$_pkg_name" ] && [ ! -d "$PROJECT_ROOT/vendor/$_pkg_name" ]; then
                    continue
                fi
            fi
            if find "$_dir" -mindepth 1 -name '*.spec.ts' -print -quit 2>/dev/null | grep -q .; then
                printf '%s\n' "${_dir#$PROJECT_ROOT/}"
            fi
        done
    fi
    if [ -d "$PROJECT_ROOT/src/modules" ]; then
        for _dir in "$PROJECT_ROOT"/src/modules/*/tests/E2E; do
            [ -d "$_dir" ] || continue
            if find "$_dir" -mindepth 1 -name '*.spec.ts' -print -quit 2>/dev/null | grep -q .; then
                printf '%s\n' "${_dir#$PROJECT_ROOT/}"
            fi
        done
    fi
}

# ── Host headroom, observed alongside the E2E verdict ──────────────────────
#
# E2E on a loaded dev host is non-deterministic in a way that reads exactly
# like a code regression. MEASURED: an identical tree produced 17 failures,
# then 15 with DIFFERENT membership, 11 of those 15 being `page.goto`
# TimeoutError at 15000ms — with ~1 GB of host memory available and 20
# competing compose projects. The same suite, same host, same commit, with
# ~11 GB available: 88 specs in 47.2s, zero failures.
#
# Playwright retries stay at 0 on purpose. Retrying would convert the signal
# into a slower green and hide the cause. What was missing is not resilience
# but the CONTEXT to judge a red run, so the numbers are printed next to the
# verdict — before the run, and again when it fails.
host_avail_mb() {
    [ -r /proc/meminfo ] || return 1
    awk '/^MemAvailable:/ { printf "%d", $2 / 1024; found = 1; exit } END { exit !found }' /proc/meminfo
}

host_load1() {
    [ -r /proc/loadavg ] || return 1
    awk '{ printf "%s", $1; exit }' /proc/loadavg
}

# The docker output is captured BEFORE it is counted. Piping straight into awk
# discards docker's exit status, so a daemon that is not running produced a
# confident "0 competing compose projects" — an unreadable probe reported as an
# idle host, which is the exact failure this whole report exists to prevent.
host_compose_projects() {
    _hc_out="$(docker ps --filter label=com.docker.compose.project \
        --format '{{.Label "com.docker.compose.project"}}' 2>/dev/null)" || return 1

    printf '%s' "$_hc_out" | sort -u | awk 'NF { n++ } END { printf "%d", n + 0 }'
}

# Prints the host's headroom. Returns non-zero when memory is readable and below
# the threshold, and ALSO when the threshold itself is misconfigured, so the
# caller's opt-in refusal fails closed rather than open.
report_host_headroom() {
    _hh_avail=""
    _hh_load=""
    _hh_projects=""
    _hh_avail="$(host_avail_mb 2>/dev/null)" || _hh_avail=""
    _hh_load="$(host_load1 2>/dev/null)" || _hh_load=""
    _hh_projects="$(host_compose_projects)" || _hh_projects=""
    _hh_min="${SEMITEXA_E2E_MIN_AVAIL_MB:-2048}"

    # A threshold that is not a whole number of megabytes silently disables the
    # gate: `[ 512 -lt bad ]` fails, its stderr is discarded, and the false
    # branch reads as "there is room" — so SEMITEXA_E2E_REQUIRE_HEADROOM=1 would
    # let E2E start on a host with 512 MB free. Refused as a configuration
    # error instead, and the non-zero return means the opt-in refusal still
    # fires.
    case "$_hh_min" in
        ''|*[!0-9]*)
            error "SEMITEXA_E2E_MIN_AVAIL_MB must be a whole number of megabytes; got '${_hh_min}'."
            return 1
            ;;
    esac

    if [ -z "$_hh_avail" ]; then
        # Unreadable is NOT the same as fine. A headroom report that prints
        # nothing looks identical to a host with room to spare, and that is
        # the whole failure this exists to prevent.
        warn "Host headroom: UNREADABLE (no /proc/meminfo on this platform)."
        warn "A red E2E run here cannot be attributed to the host or to the code."
        return 0
    fi

    printf "  %-30s %s MB\n"  "Host memory available" "$_hh_avail"
    printf "  %-30s %s\n"     "Host load (1 min)"     "${_hh_load:-unknown}"
    printf "  %-30s %s\n"     "Competing compose projects" "${_hh_projects:-unknown}"

    # Each unreadable probe says so. The same rule as the memory branch above,
    # applied to the two that were left reporting a plausible-looking value:
    # 'unknown' in a table is easy to skim past, a warning is not.
    [ -z "$_hh_load" ] && warn "Host load is UNREADABLE (no /proc/loadavg); that column is not evidence."
    [ -z "$_hh_projects" ] && warn "Competing compose projects UNREADABLE (docker ps failed); that column is not evidence."

    if [ "$_hh_avail" -lt "$_hh_min" ]; then
        warn "Only ${_hh_avail} MB available (below ${_hh_min} MB)."
        warn "E2E failures on this host at this headroom have been measured as CONTENTION, not code:"
        warn "  page.goto TimeoutError at 15000ms, different specs failing on each run of one tree."
        warn "Judge a red run accordingly, or free memory and re-run before filing anything."
        return 1
    fi

    return 0
}

# The mysql image creates only DB_DATABASE, for DB_USERNAME. A fresh install
# therefore has no test database and no grant on one, and its first test:run
# stopped at the schema sync with "Access denied for user ... to database
# 'semitexa_test'". Created and granted here, as root, idempotently. A project
# that does not run the bundled MySQL service is left alone.
#   $1 compose binary   $2 compose -f arguments   $3 test database name
ensure_test_database() {
    case " $2 " in *docker-compose.mysql.yml*) ;; *) return 0 ;; esac
    # The user Compose hands MySQL, resolved as Compose resolves it: .env wins over
    # the caller, and an empty value falls back like ${DB_USERNAME:-semitexa}.
    _etd_user="$(env_export_compose_context >/dev/null 2>&1; printf '%s' "${DB_USERNAME:-semitexa}")"
    # Only plain identifiers are interpolated into the SQL below.
    if printf '%s\n%s\n' "$3" "$_etd_user" | grep -Eq '[^A-Za-z0-9_]|^$'; then
        warn "Test database '$3' or user '$_etd_user' is not a plain identifier; create and grant it yourself."
        return 0
    fi
    if ! (
        env_export_compose_context
        # No --wait: Compose v1 has no such flag, and on a fresh volume the
        # healthcheck can pass on the init server before MySQL restarts. The
        # SQL is idempotent, so it is retried until the final server takes it.
        # shellcheck disable=SC2086
        $1 $2 up -d mysql >/dev/null 2>&1 || exit 1
        _etd_try=1
        while [ "$_etd_try" -le 30 ]; do
            # MySQL creates MYSQL_USER only when the volume is first initialised, so a
            # user renamed since has no account to grant to: it is created with the
            # password Compose hands MySQL, passed hex-encoded so no character of it
            # can break the SQL. An account that exists keeps its password.
            # shellcheck disable=SC2086
            $1 $2 exec -T mysql sh -s "$3" "$_etd_user" >/dev/null 2>&1 <<'ETD_SQL' && exit 0
_create=''
_hex="$(printf '%s' "${MYSQL_PASSWORD:-}" | od -An -tx1 | tr -d ' \n')"
[ -z "$_hex" ] || _create="SET @etd = CONCAT('CREATE USER IF NOT EXISTS ''$2''@''%'' IDENTIFIED BY ', QUOTE(CONVERT(UNHEX('$_hex') USING utf8mb4))); PREPARE etd FROM @etd; EXECUTE etd; DEALLOCATE PREPARE etd;"
# In a database-level grant _ is a one-character wildcard: escaped, the grant
# names this database and not every one its name matches.
_pattern="$(printf '%s' "$1" | sed 's/_/\\_/g')"
mysql -uroot -p"$MYSQL_ROOT_PASSWORD" -e "CREATE DATABASE IF NOT EXISTS $1; $_create GRANT ALL PRIVILEGES ON \`$_pattern\`.* TO '$2'@'%';"
ETD_SQL
            _etd_try=$((_etd_try + 1))
            sleep 2
        done
        exit 1
    ); then
        warn "Could not create the test database '$3' or grant '$_etd_user' on it; the schema sync below will say why."
        return 0
    fi
    info "Test database '$3' is ready for '$_etd_user'."
}

# A PHPUnit option whose value is the NEXT argument (`--filter X`, `-c file`).
# The value is no test path: counted as one, `test:run -- --filter X` stopped
# discovering the test paths and PHPUnit ran nothing in a fresh install, whose
# module tests sit outside phpunit.xml.dist (bench-test-run-filter-noop).
phpunit_option_takes_value() {
    case "$1" in
        --filter|--exclude-filter|--group|--exclude-group|--testsuite|--exclude-testsuite|\
        --covers|--uses|--test-suffix|-c|--configuration|--bootstrap|--cache-directory|\
        --order-by|--random-order-seed|--log-junit|--log-teamcity|--log-events-text|\
        --log-events-verbose-text|--testdox-html|--testdox-text|--coverage-clover|\
        --coverage-cobertura|--coverage-crap4j|--coverage-html|--coverage-php|--coverage-xml|\
        --coverage-filter|--include-path|-d|--extension|--columns|--generate-baseline|--use-baseline|\
        --default-time-limit|--list-tests-xml|--coverage-cache|--cache-result-file)
            return 0 ;;
    esac
    return 1
}

cmd_test_run() {
    [ "${1:-}" != "--" ] || shift
    _test_information=0
    for _test_arg in "$@"; do
        case "$_test_arg" in
            --) break ;;
            -h|--help|-V|--version|--atleast-version|--atleast-version=*)
                cmd_information vendor/bin/phpunit "$@"
                return $?
                ;;
            --list-tests|--list-suites|--list-groups|--list-test-files|--list-tests-xml|--list-tests-xml=*)
                _test_information=1
                ;;
        esac
    done

    # Everything below this point is about RUNNING tests, and a listing does
    # not run any. Asking for one on a host with local PHP and no Docker used
    # to die on the Compose prerequisite several steps before reaching the
    # local fallback that exists precisely for that host — the fallback was
    # unreachable by the only caller that needed it.
    if [ "$_test_information" -eq 0 ]; then
    if ! has_compose; then
        error "Docker Compose is required. Install Docker Desktop or docker-compose."
        exit 1
    fi
    if [ ! -f "$PROJECT_ROOT/docker-compose.yml" ]; then
        error "docker-compose.yml not found."
        exit 1
    fi
    if [ ! -f "$PROJECT_ROOT/docker-compose.test.yml" ]; then
        error "docker-compose.test.yml not found."
        exit 1
    fi

    _env="$(env_val APP_ENV "")"
    if [ "$_env" != "dev" ]; then
        error "test:run is only available when APP_ENV=dev."
        info "Set APP_ENV=dev in your .env to enable test containers."
        exit 1
    fi

    # Before any phase writes: the PHPUnit container (schema sync, the
    # bootstrap marker) runs as a user and would die on a file an earlier
    # root run left behind, long before the E2E-phase pass below.
    project_ownership_reclaim || exit 1

    _overlays="$(test_compose_overlays)"

    _compose="$(compose_bin)"
    _files_display="$(printf '%s' "$_overlays" | sed 's/-f //g' | awk '{$1=$1; print}' | tr ' ' ',' | sed 's/,/, /g')"

    # ── Phase 1: PHPUnit ────────────────────────────────────────────────
    printf "\n%s%s Phase 1/2 — PHPUnit (Docker) %s\n\n" "$C_BOLD" "$C_CYAN" "$C_RESET"
    info "Compose files: $_files_display"
    fi

    if [ "$_test_information" -eq 1 ]; then
        info "Listing tests only — no Docker, schema sync, test execution, or E2E phase."
    fi

    # Build test-path list on the host, appended only when the user did not pass
    # any positional targets. Fresh installs only have tests/; monorepo layouts
    # also have packages/*/tests — this is where monorepo awareness lives
    # (phpunit.xml.dist stays minimal and environment-agnostic).
    _has_positional=0
    _broad_packages_run=0
    _option_value=0
    # A suite named from phpunit.xml.dist (--testsuite / --exclude-testsuite)
    # is the selection: positional paths would replace the XML suites, so
    # nothing is discovered for it.
    _suite_selected=0
    # A run that picks tests (--filter, --group, a suite...) is as focused as
    # one that names paths: neither runs the E2E phase after it. Its value no
    # longer counts as a path, so this is tracked on its own.
    _focused=0
    for _arg in "$@"; do
        if [ "$_option_value" -eq 1 ]; then
            _option_value=0
            continue
        fi
        case "$_arg" in
            --testsuite|--testsuite=*|--exclude-testsuite|--exclude-testsuite=*) _suite_selected=1; _focused=1 ;;
            --filter|--filter=*|--exclude-filter|--exclude-filter=*|--group|--group=*|--exclude-group|--exclude-group=*|\
            --covers|--covers=*|--uses|--uses=*|--test-suffix|--test-suffix=*) _focused=1 ;;
        esac
        if phpunit_option_takes_value "$_arg"; then
            _option_value=1
            continue
        fi
        case "$_arg" in
            -*) ;;
            packages|packages/|./packages|./packages/) _has_positional=1; _broad_packages_run=1 ;;
            *) _has_positional=1 ;;
        esac
    done
    # Auto-discovery (no positional args) is also a broad packages run. A
    # named suite is not: it needs no path repository, so neither the audit
    # nor discovery below applies to it.
    if [ "$_has_positional" -eq 0 ] && [ "$_suite_selected" -eq 0 ]; then
        _broad_packages_run=1
    fi
    # `packages` asks for the discovered package tests, a suite for the XML's:
    # PHPUnit can take only one, and dropping either silently runs less than
    # was asked. Say so instead.
    if [ "$_suite_selected" -eq 1 ] && [ "$_broad_packages_run" -eq 1 ]; then
        error "test:run packages cannot be combined with --testsuite or --exclude-testsuite."
        info "Run the packages (bin/semitexa test:run packages) or the suite (bin/semitexa test:run --testsuite <name>), not both at once."
        exit 1
    fi

    # Collect external composer path-repo URLs (those declared in composer.json
    # whose "url" points OUTSIDE the project's own packages/ tree). These are
    # checked twice below: (a) on explicit positional invocations that name
    # such a path — to fail loudly if the source isn't currently available;
    # (b) during automatic discovery — to fail loudly when broad runs would
    # otherwise silently omit those tests. Opt-out via SEMITEXA_SKIP_PATH_REPO_TESTS=1.
    _external_path_repo_urls=""
    if [ -f "$PROJECT_ROOT/composer.json" ]; then
        _external_path_repo_urls="$(awk '
            /"type"[[:space:]]*:[[:space:]]*"path"/ { intype = 1; next }
            intype && /"url"[[:space:]]*:/ {
                sub(/.*"url"[[:space:]]*:[[:space:]]*"/, "")
                sub(/".*/, "")
                print
                intype = 0
            }
        ' "$PROJECT_ROOT/composer.json" 2>/dev/null | awk '
            /^packages\// || /^\.\/packages\// { next }
            { print }
        ')"
    fi

    # Process env takes priority over .env (CI / one-off shell overrides).
    # Falls back to the .env file value via env_val so the opt-out can be
    # pinned for stable CI configurations.
    _skip_path_repos="${SEMITEXA_SKIP_PATH_REPO_TESTS:-}"
    [ -n "$_skip_path_repos" ] || _skip_path_repos="$(env_val SEMITEXA_SKIP_PATH_REPO_TESTS "")"
    case "$_skip_path_repos" in 1|true|yes|on) _skip_path_repos=1 ;; *) _skip_path_repos=0 ;; esac

    # (a) explicit positional path validation. If the user named an external
    #     path-repo path, refuse to proceed when the source isn't there.
    if [ "$_has_positional" -eq 1 ]; then
        _option_value=0
        for _arg in "$@"; do
            if [ "$_option_value" -eq 1 ]; then
                _option_value=0
                continue
            fi
            if phpunit_option_takes_value "$_arg"; then
                _option_value=1
                continue
            fi
            case "$_arg" in
                -*) continue ;;
            esac
            _match_url=""
            for _url in $_external_path_repo_urls; do
                _url_clean="${_url#./}"
                case "$_arg" in
                    "${_url_clean}"|"${_url_clean}/"*|"./${_url_clean}"|"./${_url_clean}/"*) _match_url="$_url_clean"; break ;;
                esac
            done
            [ -n "$_match_url" ] || continue

            _root_seg="${_match_url%%/*}"
            if [ -e "$PROJECT_ROOT/$_arg" ]; then
                continue
            fi
            error "External path-repo test target not available: $_arg"
            if [ -L "$PROJECT_ROOT/$_root_seg" ]; then
                error "  ./$_root_seg is a broken symlink — its target is missing on this host."
            else
                error "  ./$_root_seg symlink is missing — this is the entry point for the external path repo."
            fi
            info  ""
            info  "Fix one of:"
            info  "  1. Create the operator-local symlink (one-time, gitignored):"
            info  "       ln -s /absolute/host/path/to/$_root_seg \"$PROJECT_ROOT/$_root_seg\""
            info  "       composer dump-autoload --no-scripts"
            info  "  2. Or set SEMITEXA_SKIP_PATH_REPO_TESTS=1 to opt out of path-repo discovery."
            info  "     (This will NOT make an explicit positional target valid — it only silences"
            info  "      automatic discovery on broad runs.)"
            info  ""
            info  "Details: var/docs/ui-foundation-step1-quarantine.md"
            exit 1
        done
    fi

    # (b) Path-repo audit on every broad-packages run. Whether the operator
    # invoked `bin/semitexa test:run` (auto-discovery) or `bin/semitexa
    # test:run packages` (explicit broad target), the absence of an external
    # path-repo source must not be invisible. We DO NOT silently ignore
    # missing sources: a missing or broken symlink makes the run fail loudly
    # with an actionable message, unless the operator/CI has opted out via
    # SEMITEXA_SKIP_PATH_REPO_TESTS=1 (in which case the skip is loudly
    # logged and surfaced in the final summary).
    _missing_path_repos=""
    if [ "$_broad_packages_run" -eq 1 ]; then
        for _url in $_external_path_repo_urls; do
            _url_clean="${_url#./}"
            if [ ! -e "$PROJECT_ROOT/$_url_clean" ]; then
                _missing_path_repos="$_missing_path_repos
$_url_clean"
            fi
        done
        _missing_path_repos="$(printf '%s' "$_missing_path_repos" | sed '/^$/d')"
    fi

    if [ -n "$_missing_path_repos" ]; then
        if [ "$_skip_path_repos" -eq 1 ]; then
            warn "External path-repo discovery skipped (SEMITEXA_SKIP_PATH_REPO_TESTS=1)."
            printf '%s\n' "$_missing_path_repos" | while IFS= read -r _u; do
                [ -z "$_u" ] && continue
                warn "  - $_u  (source not available; tests NOT executed)"
            done
            # Remember the skipped set so the post-PHPUnit summary can
            # surface it again — the warning at the top of a long run
            # is easy to miss.
            SEMITEXA_TEST_SKIPPED_PATH_REPOS="$_missing_path_repos"
            export SEMITEXA_TEST_SKIPPED_PATH_REPOS
        else
            error "External path-repository tests cannot be discovered."
            printf '%s\n' "$_missing_path_repos" | while IFS= read -r _u; do
                [ -z "$_u" ] && continue
                _root="${_u%%/*}"
                if [ -L "$PROJECT_ROOT/$_root" ]; then
                    error "  - $_u  (./$_root is a broken symlink)"
                else
                    error "  - $_u  (./$_root symlink is missing)"
                fi
            done
            info ""
            info "A broad-packages run must not silently skip Platform UI tests."
            info "Fix one of:"
            info "  1. Create the operator-local symlink (one-time, gitignored):"
            _first_root="$(printf '%s' "$_missing_path_repos" | head -n1)"
            _first_root="${_first_root%%/*}"
            info "       ln -s /absolute/host/path/to/$_first_root \"$PROJECT_ROOT/$_first_root\""
            info "       composer dump-autoload --no-scripts"
            info "  2. Or set SEMITEXA_SKIP_PATH_REPO_TESTS=1 to opt out (run will still emit"
            info "     a loud warning and surface the skipped repos in the final summary)."
            info ""
            info "Details: var/docs/ui-foundation-step1-quarantine.md"
            exit 1
        fi
    fi

    _test_paths=""
    if [ "$_suite_selected" -eq 0 ] && { [ "$_has_positional" -eq 0 ] || [ "$_broad_packages_run" -eq 1 ]; }; then
        _discovered=""
        # The project's own tests/ first: discovered paths replace the XML
        # suites, so a run that also found module or package tests dropped it
        # (the phpunit.xml.dist suite is `tests`). Pure discovery only, as for
        # src/modules: an explicit `packages` target means the packages.
        if [ "$_has_positional" -eq 0 ] && [ -d "$PROJECT_ROOT/tests" ] \
            && find "$PROJECT_ROOT/tests" -mindepth 1 -name '*Test.php' -print -quit 2>/dev/null | grep -q .; then
            _discovered="tests"
        fi
        if [ -d "$PROJECT_ROOT/packages" ]; then
            for _dir in "$PROJECT_ROOT"/packages/*/tests; do
                [ -d "$_dir" ] || continue
                # Only sweep tests of packages that are actually installed:
                # a release/tagging checkout keeps every package repo under
                # packages/, but composer installs a subset — tests of a
                # not-installed package cannot autoload its src classes.
                _pkg_composer="$(dirname "$_dir")/composer.json"
                if [ -f "$_pkg_composer" ]; then
                    _pkg_name="$(sed -n 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$_pkg_composer" | head -n 1)"
                    if [ -n "$_pkg_name" ] && [ ! -d "$PROJECT_ROOT/vendor/$_pkg_name" ]; then
                        continue
                    fi
                fi
                _discovered="$_discovered
${_dir#$PROJECT_ROOT/}"
            done
        fi
        # src/modules is only auto-included on pure no-arg discovery; an
        # explicit `packages` positional should not pull modules in.
        if [ "$_has_positional" -eq 0 ] && [ -d "$PROJECT_ROOT/src/modules" ]; then
            for _dir in "$PROJECT_ROOT"/src/modules/*/tests; do
                [ -d "$_dir" ] || continue
                # Skip empty test dirs so PHPUnit doesn't error on no-tests.
                if find "$_dir" -mindepth 1 -name '*Test.php' -print -quit 2>/dev/null | grep -q .; then
                    _discovered="$_discovered
${_dir#$PROJECT_ROOT/}"
                fi
            done
        fi
        # Include external path-repo tests where the source IS available;
        # missing sources were already handled in the audit above.
        for _url in $_external_path_repo_urls; do
            _url_clean="${_url#./}"
            [ -e "$PROJECT_ROOT/$_url_clean" ] || continue
            _tests_dir="$PROJECT_ROOT/$_url_clean/tests"
            [ -d "$_tests_dir" ] || continue
            if find "$_tests_dir" -mindepth 1 -name '*Test.php' -print -quit 2>/dev/null | grep -q .; then
                _discovered="$_discovered
${_url_clean}/tests"
            fi
        done

        if [ -n "$_discovered" ]; then
            _test_paths="$(printf '%s' "$_discovered" | sed '/^$/d' | LC_ALL=C sort | tr '\n' ' ')"
        fi
    fi

    # When the user typed the `packages` alias as the broad target, drop it
    # from the args so the expanded discovered list (which already covers
    # packages/* AND external path-repo tests) is what PHPUnit receives.
    if [ "$_broad_packages_run" -eq 1 ] && [ "$_has_positional" -eq 1 ]; then
        _new_args=""
        for _arg in "$@"; do
            case "$_arg" in
                packages|packages/|./packages|./packages/) continue ;;
            esac
            _new_args="$_new_args $_arg"
        done
        # shellcheck disable=SC2086
        set -- $_new_args
    fi

    if [ -n "$_test_paths" ]; then
        info "Discovered test paths: $(printf '%s' "$_test_paths" | awk '{$1=$1; print}' | tr ' ' ',' | sed 's/,/, /g')"
    fi

    if [ "$_test_information" -eq 1 ]; then
        # PHPUnit may load the project's bootstrap to discover test classes.
        # This is not a sandbox for arbitrary bootstrap code. It NEVER enters
        # the schema-sync / test / E2E phases or starts a service, though.
        # shellcheck disable=SC2086
        cmd_information vendor/bin/phpunit "$@" $_test_paths
        return $?
    fi

    # ── Phase 1a: test-DB schema parity (idempotent) ────────────────────
    # The test database (DB_TEST_DATABASE, default semitexa_test — pinned by
    # the phpunit service env in docker-compose.test.yml) must carry every
    # table the ORM code schema declares, or runtime smoke tests 500 on
    # missing tables while the same routes are green in dev. The ORM is the
    # single schema authority (#[FromTable] resources + orm:sync), so parity
    # is one idempotent safe-ops sync run INSIDE the phpunit service — same
    # env the suites get, dev DB unreachable by construction.
    #
    # EXTENSION CONTRACT — "new table in dev → test DB follows":
    #   declare the table as an ORM resource (#[FromTable] + #[Column]s),
    #   which dev work must do anyway to use it; the next test:run syncs it
    #   here with ZERO edits. There is no second place to update. Ad-hoc DDL
    #   tables (none today) are NOT covered — declare them as resources.
    #
    # Deliberately NO --allow-destructive: stale tables in the test DB are
    # left in place (they don't fail tests); destructive cleanup is an
    # operator decision, never an automatic side effect of running tests.
    # The test database is separated from the live one by a DEFAULT
    # (DB_TEST_DATABASE, default semitexa_test), and a default is not a
    # guarantee: point that variable at DB_DATABASE and everything below —
    # schema sync now, the suites after it — runs against the database the
    # developer actually works in. Nothing downstream can tell the difference,
    # so the check belongs here, before the first write.
    # The EFFECTIVE value, not merely the file's. DB_TEST_DATABASE below is
    # read from the process first, so comparing it against a .env-only reading
    # of DB_DATABASE let an exported pair that both name the live database slip
    # through the one check standing between a test run and that database.
    _live_db="${DB_DATABASE:-$(env_val DB_DATABASE semitexa)}"
    _test_db="${DB_TEST_DATABASE:-$(env_val DB_TEST_DATABASE semitexa_test)}"
    if [ "$_test_db" = "$_live_db" ]; then
        error "DB_TEST_DATABASE and DB_DATABASE are both '$_live_db'."
        error "Tests create and drop tables; running them against the live database would destroy it."
        error "Set DB_TEST_DATABASE to a separate name (the default is semitexa_test)."
        exit 1
    fi

    ensure_test_database "$_compose" "$_overlays" "$_test_db"

    _sync_rc=0
    info "Test-DB schema parity: orm:sync against the test database (safe ops only)..."
    (
        env_export_compose_context
        # shellcheck disable=SC2086
        $_compose $_overlays run --rm phpunit php vendor/bin/semitexa orm:sync
    ) || _sync_rc=$?
    if [ "$_sync_rc" -ne 0 ]; then
        printf "\n"
        error "Test-DB schema sync failed (exit $_sync_rc). Aborting before PHPUnit —"
        error "a drifted test schema would produce misleading route-smoke failures."
        exit "$_sync_rc"
    fi
    success "Test-DB schema parity ensured."

    # `set -e` is in effect at the top of this script; wrap with `|| ...`
    # so a non-zero exit is captured here instead of killing the script
    # silently before we can report it and decide whether to continue.
    _phpunit_rc=0
    (
        env_export_compose_context
        # An explicit command to `compose run` overrides the phpunit service
        # command, so the env-gated Swoole blocking-detection flags from
        # docker-compose.test.yml must be repeated here or they are bypassed.
        #
        # pcov.enabled goes HERE, before vendor/bin/phpunit, because everything after that
        # is an argument to PHPUnit rather than to PHP. Without this the shipped PCOV
        # cannot be switched on through the canonical runner at all, and a coverage run
        # fails with "No code coverage driver available":
        #     SEMITEXA_COVERAGE=1 bin/semitexa test:run <paths> --coverage-text
        # shellcheck disable=SC2086
        $_compose $_overlays run --rm phpunit \
            php -d "swoole.blocking_detection=${SWOOLE_BLOCKING_DETECTION:-Off}" \
                -d "swoole.blocking_threshold=${SWOOLE_BLOCKING_THRESHOLD:-100000}" \
                -d "pcov.enabled=${SEMITEXA_COVERAGE:-0}" \
                vendor/bin/phpunit "$@" $_test_paths
    ) || _phpunit_rc=$?

    if [ "$_phpunit_rc" -ne 0 ]; then
        printf "\n"
        error "PHPUnit failed (exit $_phpunit_rc). Skipping E2E phase."
        exit "$_phpunit_rc"
    fi
    success "PHPUnit phase passed."

    # If path-repo discovery was opted out by SEMITEXA_SKIP_PATH_REPO_TESTS,
    # surface the skipped set in the final summary so a green PHPUnit phase
    # cannot be mistaken for "everything ran".
    if [ -n "${SEMITEXA_TEST_SKIPPED_PATH_REPOS:-}" ]; then
        warn "Note: external path-repo tests were NOT executed (SEMITEXA_SKIP_PATH_REPO_TESTS=1)."
        printf '%s\n' "$SEMITEXA_TEST_SKIPPED_PATH_REPOS" | while IFS= read -r _u; do
            [ -z "$_u" ] && continue
            warn "  - $_u  (source not available)"
        done
        warn "PHPUnit phase reports success ONLY for the discovered subset above."
    fi

    # ── Phase 2: E2E (Playwright) ───────────────────────────────────────
    # When the operator passed positional PHPUnit targets, this is a
    # focused PHPUnit run; do NOT auto-run the full E2E suite.
    if [ "$_has_positional" -eq 1 ] || [ "$_focused" -eq 1 ]; then
        info "Focused PHPUnit run (named targets or a test selection) — E2E phase skipped."
        exit 0
    fi

    printf "\n%s%s Phase 2/2 — E2E tests (Playwright in Docker) %s\n\n" "$C_BOLD" "$C_CYAN" "$C_RESET"

    _e2e_dirs="$(discover_e2e_dirs)"
    if [ -z "$_e2e_dirs" ]; then
        info "No E2E tests discovered (looked in packages/*/tests/E2E and src/modules/*/tests/E2E)."
        success "All tests passed (no E2E specs to run)."
        exit 0
    fi

    info "Discovered E2E spec dirs: $(printf '%s' "$_e2e_dirs" | tr '\n' ',' | sed 's/,$//' | sed 's/,/, /g')"
    info "E2E baseURL: ${PLAYWRIGHT_BASE_URL:-http://localhost:9502 (default; runner shares app netns)}"

    _headroom_rc=0
    report_host_headroom || _headroom_rc=$?
    # Refusal is opt-in and enabled ONLY by an exact "1", so that a well-meant
    # SEMITEXA_E2E_REQUIRE_HEADROOM=true or =yes cannot silently mean "off".
    if [ "$_headroom_rc" -ne 0 ] && [ "${SEMITEXA_E2E_REQUIRE_HEADROOM:-0}" = "1" ]; then
        error "Refusing to start E2E below the memory threshold (SEMITEXA_E2E_REQUIRE_HEADROOM=1)."
        info "Free memory, lower SEMITEXA_E2E_MIN_AVAIL_MB, or unset SEMITEXA_E2E_REQUIRE_HEADROOM."
        exit 1
    fi

    # The phase's own app, on its own database, when this project can have one;
    # otherwise the developer's app, said out loud (it writes into the live DB).
    _e2e_isolated=''
    _e2e_why="$(e2e_isolation_unavailable "$_compose" "$_overlays" || true)"
    if [ -z "$_e2e_why" ]; then
        e2e_database_reset "$_compose" "$_overlays" || exit 1
        # Removed on every way out from here: a failed step, Ctrl-C or a kill,
        # the 90 s the app takes to answer included (review, ultimate#135).
        _e2e_cleanup="$(e2e_container_name)"
        # shellcheck disable=SC2064
        trap "docker rm -f '$_e2e_cleanup' >/dev/null 2>&1 || true" EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        e2e_app_start "$_compose" "$_overlays" || exit 1
        _e2e_isolated="$E2E_APP_CONTAINER"
        info "E2E runs on its own app ($_e2e_isolated) and database ($(e2e_db_name)), not the one you work in."
    else
        warn "E2E runs against your running app and writes into its database: $_e2e_why."
        _app_rc=0
        (
            env_export_compose_context
            # Bring up the application so the E2E runner has a target. depends_on
            # in the compose service handles the rest, but `up -d app` is explicit
            # and makes the failure mode obvious if app cannot start.
            # shellcheck disable=SC2086
            $_compose $_overlays up -d app
        ) || _app_rc=$?
        if [ "$_app_rc" -ne 0 ]; then
            error "Failed to start app service for E2E phase (exit $_app_rc)."
            exit "$_app_rc"
        fi
    fi

    # Discovery is the single source of truth for WHICH specs run: the
    # compose service's default command lets playwright.config.ts testMatch
    # glob every packages/*/tests/E2E dir, including packages composer never
    # installed. Passing the discovered dirs as path filters keeps the two
    # in agreement.
    _e2e_spec_args="$(printf '%s' "$_e2e_dirs" | tr '\n' ' ')"
    # The runner writes test-results as the host user now; a directory an
    # earlier root run left behind would refuse it (EACCES on .last-run.json).
    project_ownership_reclaim || exit 1
    # On its own app, the runner is checked in that app's network namespace too:
    # with no developer app running, the plain file set cannot start it at all,
    # and a check that could not run lets the phase go on (review, installer#79).
    _e2e_runner_overlays="$_overlays"
    if [ -n "$_e2e_isolated" ]; then
        SEMITEXA_E2E_APP_CONTAINER="$_e2e_isolated"
        export SEMITEXA_E2E_APP_CONTAINER
        _e2e_runner_overlays="$_overlays -f docker-compose.e2e.yml"
    fi
    e2e_runner_preflight "$_compose" "$_e2e_runner_overlays" || exit 1
    _e2e_rc=0
    if [ -n "$_e2e_isolated" ]; then
        (
            env_export_compose_context
            # The runner joins the E2E app's network namespace (docker-compose.e2e.yml);
            # --no-deps: the developer's app is not this run's target.
            # shellcheck disable=SC2086
            $_compose $_e2e_runner_overlays run --rm --no-deps e2e-runner npx --no-install playwright test --config=playwright.config.ts $_e2e_spec_args
        ) || _e2e_rc=$?
        docker rm -f "$_e2e_isolated" >/dev/null 2>&1 || true
    else
        (
            env_export_compose_context
            # shellcheck disable=SC2086
            $_compose $_overlays run --rm e2e-runner npx --no-install playwright test --config=playwright.config.ts $_e2e_spec_args
        ) || _e2e_rc=$?
    fi

    if [ "$_e2e_rc" -ne 0 ]; then
        printf "\n"
        error "E2E phase failed (exit $_e2e_rc)."
        # Re-read rather than reuse the pre-run numbers: the run itself is what
        # consumed the memory, so the state at the moment of failure is the one
        # worth reporting.
        printf "\n%sHost at the moment of failure:%s\n" "$C_BOLD" "$C_RESET"
        report_host_headroom || true
        exit "$_e2e_rc"
    fi
    success "E2E phase passed."
    exit 0
}

# Resolve the Docker Compose project name for $PROJECT_ROOT — preferring the
# value compose itself reports (so we never disagree with the runtime), with a
# fallback to compose's name-normalization rule (`basename`, lowercase, drop
# disallowed chars). Stdout is the resolved name.
proxy_compose_project_name() {
    _compose="$(compose_bin 2>/dev/null)"
    _overlays="$(compose_args)"
    if [ -n "$_compose" ]; then
        _name="$(
            env_export_compose_context
            # shellcheck disable=SC2086
            $_compose $_overlays config --format json 2>/dev/null \
                | sed -n 's/.*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
                | head -n 1
        )"
        if [ -n "$_name" ]; then
            printf '%s' "$_name"
            return 0
        fi
    fi
    # Compose normalization: lowercase basename, strip anything not [a-z0-9_-].
    printf '%s' "$(basename "$PROJECT_ROOT" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9_-')"
}

# Look up the runtime owner of a published port. Prints up to four
# tab-separated fields when a Docker container is the publisher:
#   <container-name>\t<compose-project>\t<compose-service>\t<status>
# Empty stdout when no Docker container publishes the port.
proxy_runtime_owner_for_port() {
    _port="$1"
    [ -n "$_port" ] || return 0
    command -v docker >/dev/null 2>&1 || return 0
    docker ps --filter "publish=${_port}" --no-trunc --format \
        '{{.Names}}{{"\t"}}{{.Label "com.docker.compose.project"}}{{"\t"}}{{.Label "com.docker.compose.service"}}{{"\t"}}{{.Status}}' \
        2>/dev/null | head -n 1
}

# Best-effort host-process owner of a listening port. Prints "<pid>\t<command>"
# when ss is available and reports a pid; empty otherwise.
proxy_host_process_for_port() {
    _port="$1"
    [ -n "$_port" ] || return 0
    if command -v ss >/dev/null 2>&1; then
        ss -ltnp 2>/dev/null \
            | awk -v p="$_port" '$0 ~ ":" p "$" || $0 ~ ":" p " " {print; exit}' \
            | sed -n 's/.*users:(("\([^"]*\)",pid=\([0-9]*\),.*/\2\t\1/p' \
            | head -n 1
    fi
}

# Look up the registered owner of a port in ~/.semitexa/router/registry/apps.
# Prints "<app_id>\t<project_name>\t<project_root>" when the port is registered;
# empty otherwise.
proxy_registry_owner_for_port() {
    _port="$1"
    [ -n "$_port" ] || return 0
    [ -d "$ROUTER_APP_REGISTRY_DIR" ] || return 0
    for _entry in "$ROUTER_APP_REGISTRY_DIR"/*.env; do
        [ -f "$_entry" ] || continue
        APP_ID='' SWOOLE_PORT='' PROJECT_ROOT='' PROJECT_NAME='' REGISTERED_AT='' UPDATED_AT=''
        # shellcheck disable=SC1090
        . "$_entry"
        [ -n "$APP_ID" ] || continue
        [ "$SWOOLE_PORT" = "$_port" ] || continue
        printf '%s\t%s\t%s\n' "$APP_ID" "${PROJECT_NAME:-}" "${PROJECT_ROOT:-}"
        return 0
    done
    return 0
}

# Pure render: emit an ownership-aware diagnosis given already-resolved
# fields. No I/O — Docker, ss, and the registry are queried by the caller
# (`proxy_diagnose_port_conflict`). Kept pure so the case logic can be
# unit-tested by sourcing this file and feeding fixtures.
#
# Args:
#   $1 port
#   $2 our compose project name
#   $3 our SEMITEXA_APP_ID (may be empty)
#   $4 runtime line  : "<container>\t<compose-project>\t<service>\t<status>" or empty
#   $5 registry line : "<app-id>\t<project-name>\t<project-root>" or empty
#   $6 host process  : "<pid>\t<command>" or empty (only consulted when no runtime line)
#
# Always exits non-zero so the caller can chain `|| true` after consultation.
proxy_diagnose_port_conflict_render() {
    _port="$1"
    _our_compose="$2"
    _our_app_id="$3"
    _runtime_line="$4"
    _registry_line="$5"
    _host_proc="${6:-}"

    _runtime_name=""; _runtime_project=""; _runtime_service=""; _runtime_status=""
    if [ -n "$_runtime_line" ]; then
        _runtime_name="$(printf '%s' "$_runtime_line" | awk -F'\t' '{print $1}')"
        _runtime_project="$(printf '%s' "$_runtime_line" | awk -F'\t' '{print $2}')"
        _runtime_service="$(printf '%s' "$_runtime_line" | awk -F'\t' '{print $3}')"
        _runtime_status="$(printf '%s' "$_runtime_line" | awk -F'\t' '{print $4}')"
    fi

    _reg_app_id=""; _reg_project=""; _reg_root=""
    if [ -n "$_registry_line" ]; then
        _reg_app_id="$(printf '%s' "$_registry_line" | awk -F'\t' '{print $1}')"
        _reg_project="$(printf '%s' "$_registry_line" | awk -F'\t' '{print $2}')"
        _reg_root="$(printf '%s' "$_registry_line" | awk -F'\t' '{print $3}')"
    fi

    _registered_to_us=0
    if [ -n "$_reg_app_id" ] && [ "$_reg_app_id" = "$_our_app_id" ]; then
        _registered_to_us=1
    fi

    printf "\n"

    if [ -z "$_runtime_line" ]; then
        # No Docker container publishes the port — host process or Docker
        # socket not reachable.
        _pid="$(printf '%s' "$_host_proc" | awk -F'\t' '{print $1}')"
        _cmd="$(printf '%s' "$_host_proc" | awk -F'\t' '{print $2}')"
        if [ "$_registered_to_us" -eq 1 ]; then
            error "Port $_port is registered to this project (${_reg_project:-unknown}) but is currently bound by a host process."
        elif [ -n "$_reg_project" ]; then
            error "Port $_port is registered to '${_reg_project}' but is currently bound by a host process."
        else
            error "Port $_port is bound by a host process and is not in the local app registry."
        fi
        if [ -n "$_pid" ]; then
            info  "Host owner: pid=${_pid} command=${_cmd:-?}"
        else
            info  "Host owner: unknown (run with sudo for ss -ltnp, or use lsof -iTCP:${_port} -sTCP:LISTEN)"
        fi
        info  ""
        info  "Resolve by either stopping that process, or choosing another port for this project:"
        info  "  bin/semitexa local-app:reconcile"
        info  "  bin/semitexa server:start"
        return 1
    fi

    # A Docker container holds the port.
    if [ "$_runtime_project" = "$_our_compose" ]; then
        # Case A or B — same compose project as ours.
        if [ "$_registered_to_us" -eq 1 ] || [ -z "$_reg_app_id" ]; then
            error "Port $_port is bound by this project's container '${_runtime_name}' (${_runtime_status})."
            info  "The local-app registry says this port belongs to this project, but our 'app' service is reporting"
            info  "as not running — likely a stale or partially-stopped container under the same compose project."
            info  ""
            info  "Resolve by recreating this project's containers:"
            info  "  bin/semitexa server:stop"
            info  "  bin/semitexa server:start"
        else
            error "Port $_port is bound by this project's container '${_runtime_name}', but the local-app registry"
            info  "says the port is registered to '${_reg_project}' (${_reg_root})."
            info  "Either stop the conflicting container or reconcile registry/runtime."
        fi
        return 1
    fi

    # Different compose project than ours.
    if [ "$_registered_to_us" -eq 1 ]; then
        error "Port $_port is registered to this project (${_reg_project}) but is currently bound by a different container."
        info  "Runtime owner: container '${_runtime_name}' (compose project '${_runtime_project}', service '${_runtime_service}', ${_runtime_status})."
        info  ""
        info  "This project owns the port logically; reconciling to a different port would only mask the conflict."
        info  "Stop the conflicting container so this project can use its registered port:"
        info  "  docker stop ${_runtime_name}"
        info  "or, if it is a sibling Semitexa project, run 'bin/semitexa server:stop' from that project's root:"
        if [ -n "$_reg_root" ]; then
            info  "  (this project root: ${_reg_root})"
        fi
        return 1
    fi

    if [ -n "$_reg_project" ]; then
        # Registry says someone else owns this port; runtime confirms a third
        # party also holds it.
        error "Port $_port is registered to '${_reg_project}' but is currently bound by container '${_runtime_name}'"
        info  "(compose project '${_runtime_project}', service '${_runtime_service}', ${_runtime_status})."
        info  "Your project does not own this port. Reconcile to a free port:"
        info  "  bin/semitexa local-app:reconcile"
        info  "  bin/semitexa server:start"
        return 1
    fi

    # Port is not in the local-app registry at all; some other Docker
    # container owns it.
    error "Port $_port is bound by container '${_runtime_name}' (compose project '${_runtime_project}', ${_runtime_status})."
    info  "Your project's SWOOLE_PORT is set to $_port but the local-app registry has no entry for that port."
    info  "Reconcile this project to a free port, or pick one explicitly:"
    info  "  bin/semitexa local-app:reconcile"
    info  "  bin/semitexa server:start"
    return 1
}

# Resolves runtime, registry, and host-process facts for $_port and hands
# them to the pure renderer above.
proxy_diagnose_port_conflict() {
    _port="$1"
    _our_compose="$2"
    _our_app_id="$3"

    _runtime_line="$(proxy_runtime_owner_for_port "$_port")"
    _registry_line="$(proxy_registry_owner_for_port "$_port")"
    _host_proc=""
    if [ -z "$_runtime_line" ]; then
        _host_proc="$(proxy_host_process_for_port "$_port")"
    fi

    proxy_diagnose_port_conflict_render \
        "$_port" "$_our_compose" "$_our_app_id" \
        "$_runtime_line" "$_registry_line" "$_host_proc"
}

# Run a one-off, no-host-port app container to execute a CLI command. Compose
# `run` does NOT publish service ports by default, so this works even when
# another container/process holds SWOOLE_PORT — which is the right design for
# CLI-only commands like `update`, `list`, `routes:list`.
proxy_run_one_off_app() {
    _compose="$(compose_bin)"
    _overlays="$(compose_args)"
    # Read before env_export_compose_context: a value in .env would otherwise
    # replace the caller's own session and trace.
    _agent_env="$(agent_env_args)"
    (
        env_export_compose_context
        # Run as the host user: a root one-off writing into the bind-mounted
        # project leaves root:0600 files the host user cannot read.
        if [ -t 0 ] && [ -t 1 ]; then
            # shellcheck disable=SC2086
            $_compose $_overlays run --rm $_agent_env --user "$(id -u):$(id -g)" app php vendor/bin/semitexa "$@"
        else
            # shellcheck disable=SC2086
            $_compose $_overlays run --rm -T $_agent_env --user "$(id -u):$(id -g)" app php vendor/bin/semitexa "$@"
        fi
    )
}

# The MCP server for a coding agent, on stdio. stdout carries protocol
# messages and nothing else, so this says nothing on it (info() would): it
# runs in the app container, or a one-off one, or with local PHP, silently.
cmd_mcp() {
    if [ ! -f "$PROJECT_ROOT/vendor/bin/semitexa" ]; then
        error "vendor/bin/semitexa not found. Run: bin/semitexa install"
        exit 1
    fi
    # server:restart recreates the app container and the server with it, and
    # an agent does not restart a stdio server by itself. With PHP on the host,
    # a relay holds the agent's connection and reconnects to the new server
    # (semitexa/mcp bin/mcp-relay.php); it starts this command again with
    # SEMITEXA_MCP_RELAYED set, which runs the server itself: checked on
    # SEMITEXA_MCP_DIRECT alone, the relay's first start (which has no
    # DIRECT) started another relay, and that one another, without end.
    # Exported here, not left to the relay: a released relay that does not
    # set it passes it on to its children all the same.
    _mcp_relay="$PROJECT_ROOT/vendor/semitexa/mcp/bin/mcp-relay.php"
    if [ -z "${SEMITEXA_MCP_RELAYED:-}" ] && [ -z "${SEMITEXA_MCP_DIRECT:-}" ] && [ -f "$_mcp_relay" ] && command -v php >/dev/null 2>&1 \
        && case "$(uname -s 2>/dev/null)" in Linux|Darwin) true ;; *) false ;; esac \
        && php -r 'exit(PHP_VERSION_ID >= 80100 && function_exists("proc_open") ? 0 : 1);' >/dev/null 2>&1; then
        export SEMITEXA_MCP_RELAYED=1
        exec php "$_mcp_relay" "$PROJECT_ROOT/bin/semitexa" mcp "$@"
    fi
    # Started by the relay while the stack is down (a restart in progress):
    # say so and let the relay try again. A one-off container here would be
    # started with the app's dependencies mid-restart and outlive server:stop.
    # Only where that one-off would be the way: a host without Compose runs
    # the server with its own PHP below, and was told to try again forever.
    if [ -n "${SEMITEXA_MCP_DIRECT:-}" ] && has_compose && env_runtime_file_exists && ! is_app_running; then
        exit 75
    fi
    if is_app_running; then
        # shellcheck disable=SC2046
        run_compose exec $(agent_env_args) -T app php vendor/bin/semitexa mcp:serve "$@"
    elif has_compose && env_runtime_file_exists; then
        proxy_run_one_off_app mcp:serve "$@"
    else
        php "$PROJECT_ROOT/vendor/bin/semitexa" mcp:serve "$@"
    fi
}

# What to give an agent so it starts that server: the path is this project's
# on the host, which the app container does not know.
cmd_mcp_config() {
    _mcp_bin="$PROJECT_ROOT/bin/semitexa"
    _mcp_json="$(printf '%s' "$_mcp_bin" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    # Single quotes, each ' as '\'': in double quotes a ", \, $ or backtick in
    # the path changed what the pasted command gave claude.
    _mcp_sh="'$(printf '%s' "$_mcp_bin" | sed "s/'/'\\\\''/g")'"
    printf '%s\n' "Claude Code, in this project:"
    printf '  claude mcp add semitexa -- %s mcp\n\n' "$_mcp_sh"
    printf '%s\n' "Cursor (.cursor/mcp.json) or Claude Desktop (claude_desktop_config.json):"
    printf '{"mcpServers": {"semitexa": {"command": "%s", "args": ["mcp"]}}}\n' "$_mcp_json"
}

# Help and listings must not auto-start a stack or a one-off container.
# Reuse a running app's PHP, or an already installed local PHP; fail otherwise.
cmd_information() {
    _information_entry="$1"
    shift
    if [ ! -f "$PROJECT_ROOT/$_information_entry" ]; then
        error "$_information_entry not found. Install dependencies explicitly first."
        return 1
    fi
    if [ -f "$PROJECT_ROOT/docker-compose.yml" ] && has_compose && is_app_running; then
        if [ "$_information_entry" = "vendor/bin/phpunit" ]; then
            _information_db="${DB_TEST_DATABASE:-$(env_val DB_TEST_DATABASE semitexa_test)}"
            if [ "$_information_db" = "${DB_DATABASE:-$(env_val DB_DATABASE semitexa)}" ]; then
                error "Test database matches the live database; refusing to load the test bootstrap."
                return 1
            fi
            run_compose exec -T -e "DB_DATABASE=$_information_db" -e APP_ENV=dev app php "$_information_entry" "$@"
        else
            run_compose exec -T app php "$_information_entry" "$@"
        fi
    elif command -v php >/dev/null 2>&1; then
        if [ "$_information_entry" = "vendor/bin/phpunit" ]; then
            _information_db="${DB_TEST_DATABASE:-$(env_val DB_TEST_DATABASE semitexa_test)}"
            if [ "$_information_db" = "${DB_DATABASE:-$(env_val DB_DATABASE semitexa)}" ]; then
                error "Test database matches the live database; refusing to load the test bootstrap."
                return 1
            fi
            APP_ENV=dev DB_DATABASE="$_information_db" php "$PROJECT_ROOT/$_information_entry" "$@"
        else
            php "$PROJECT_ROOT/$_information_entry" "$@"
        fi
    else
        error "Information mode needs local PHP or an already-running app container. No services were started."
        return 1
    fi
}

# The agent's identity and trace, carried into the container. `compose exec`
# and `compose run` pass nothing from the caller's environment, so an agent
# that did `export SEMITEXA_AI_TRACE_ID=<task>` (as AGENTS.md says) reached PHP
# with no trace at all, and every auto-append silently went nowhere. Only ids
# of a safe shape are forwarded: they are spliced into the command line.
agent_env_args() {
    for _agent_var in SEMITEXA_AI_TRACE_ID SEMITEXA_AGENT_SESSION SEMITEXA_AGENT_IMPLICIT SEMITEXA_VERIFY_E2E_RUN; do
        eval "_agent_val=\${${_agent_var}:-}"
        case "$_agent_val" in
            ''|*[!A-Za-z0-9_.:-]*) ;;
            *) printf ' -e %s=%s' "$_agent_var" "$_agent_val" ;;
        esac
    done
}

# An agent that never ran `ai:agent join`, or whose `export` did not survive
# (Claude Code starts a fresh shell for every command), was invisible: the
# others saw nobody, and the stack log said "by an agent that never joined"
# (2026-10-17). When no session is exported, name one after something stable
# the agent already carries: Claude Code's session id, or the nearest ancestor
# process that is a known agent CLI (its pid and start time). The same agent
# then gets the same id on every command, and PHP registers it on first use
# (SEMITEXA_AGENT_IMPLICIT). A human at a terminal matches neither and stays
# anonymous; an explicit export always wins; SEMITEXA_AGENT_IMPLICIT=0 turns
# this off.
#
# Claude Code's subagents and forks carry the very same environment (session
# id, CLAUDE_PID, socket — measured 2026-10-17), so they share their parent's
# session: one Claude Code session is one agent here. Nothing tells them apart.
agent_identity() {
    [ -z "${SEMITEXA_AGENT_SESSION:-}" ] || return 0
    [ "${SEMITEXA_AGENT_IMPLICIT:-}" != "0" ] || return 0
    _ai_name=""; _ai_key=""
    if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
        _ai_name="claude"; _ai_key="$CLAUDE_CODE_SESSION_ID"
    else
        # One ps per hop. CLIs run under node (gemini, older codex) show up as
        # node and are not recognised; they can still export a session.
        _ai_pid="$PPID"; _ai_hops=0
        while [ -n "$_ai_pid" ] && [ "$_ai_pid" -gt 1 ] 2>/dev/null && [ "$_ai_hops" -lt 12 ]; do
            _ai_row="$(ps -o ppid= -o comm= -p "$_ai_pid" 2>/dev/null)" || break
            _ai_parent="$(printf '%s' "$_ai_row" | awk '{print $1}')"
            _ai_comm="$(printf '%s' "$_ai_row" | awk '{print $2}' | sed 's#.*/##')"
            case "$_ai_comm" in
                claude|codex|gemini|aider|opencode|cursor-agent|copilot|amp|goose|qwen)
                    _ai_name="$_ai_comm"
                    _ai_key="$_ai_pid:$(ps -o lstart= -p "$_ai_pid" 2>/dev/null)"
                    break
                    ;;
            esac
            _ai_pid="$_ai_parent"
            _ai_hops=$((_ai_hops + 1))
        done
    fi
    [ -n "$_ai_name" ] || return 0
    _ai_name="$(printf '%s' "$_ai_name" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9-' '-' | cut -c1-16)"
    _ai_sum="$(printf '%s' "$_ai_key" | cksum | cut -d' ' -f1)"
    SEMITEXA_AGENT_SESSION="$_ai_name-$(printf '%06x' "$_ai_sum" | cut -c1-6)"
    SEMITEXA_AGENT_IMPLICIT="$_ai_name"
    export SEMITEXA_AGENT_SESSION SEMITEXA_AGENT_IMPLICIT
}

# The node modules the e2e-runner image is built to carry: the packages its
# Dockerfile installs ("@axe-core/playwright@${AXE_PLAYWRIGHT_VERSION}" ...),
# one per line. @playwright/test when the Dockerfile names none.
e2e_runner_required_modules() {
    _e2e_df="$PROJECT_ROOT/docker/e2e-runner/Dockerfile"
    _e2e_mods=''
    # Every quoted "name@${VERSION}", however many share a line.
    [ -f "$_e2e_df" ] && _e2e_mods="$(grep -oE '"@?[a-z0-9._/-]+@[$][{][A-Z0-9_]+[}]"' "$_e2e_df" | sed 's/^"//; s/@[$][{].*$//' | sort -u)"
    printf '%s\n' "${_e2e_mods:-@playwright/test}"
}

# A present image tag skips the build, so an image tagged ...-axe4.13.0 that was
# built without @axe-core/playwright (seen 2026-11-05) made every spec that
# imports it stop at load: Playwright ran nothing and the phase "failed" with
# the cause buried in its output. Ask the runner itself, before the run, and
# name the fix. Returns 0 when everything resolves, 1 when a module is missing
# (said on stderr), and 0 when the check itself could not run: the run that
# follows reports that failure in its own words.
e2e_runner_preflight() {
    _e2e_need="$(e2e_runner_required_modules | tr '\n' ' ')"
    _e2e_missing_rc=0
    # stderr stays visible: with no image yet, compose builds it right here.
    # shellcheck disable=SC2086
    _e2e_missing="$(
        env_export_compose_context
        $1 $2 run --rm --no-deps -T e2e-runner node -e '
            const missing = process.argv.slice(1).filter((m) => { try { require.resolve(m); return false; } catch (e) { return true; } });
            if (missing.length) { console.log(missing.join(" ")); process.exit(3); }
        ' $_e2e_need < /dev/null
    )" || _e2e_missing_rc=$?
    [ "$_e2e_missing_rc" -eq 3 ] || return 0
    error "The e2e-runner image lacks: $_e2e_missing (its Dockerfile installs them; the image was built without)."
    info "Rebuild it, then run again: $1 $2 build --no-cache e2e-runner"
    return 1
}

# The E2E phase's own app (tk-e2e-own-database). The runner drove the
# developer's running app, so a run's specs wrote into the database the
# developer works in (a live run left 67 guestbook rows there, 07.11). The
# phase now starts the app service once more, as a container of its own: it
# inherits every overlay's env, volumes and command (a service declared in a
# file of its own could not see what the mysql/redis/nats files add to app),
# publishes no port, and gets its own database, runtime dirs under var/ (pid,
# runtime build, caches, locks, logs), cache namespace and NATS queue and
# event namespace. The
# runner joins its network namespace through docker-compose.e2e.yml.
# A database name as Compose hands it to MySQL: .env wins over the caller, as
# ensure_test_database() resolves the user. An exported stale DB_DATABASE must
# not make the guard check one name and the copy read another.
#   $1 variable   $2 default
e2e_compose_val() {
    ( env_export_compose_context >/dev/null 2>&1; eval "printf '%s' \"\${$1:-$2}\"" )
}

e2e_db_name() {
    _e2e_db="$(e2e_compose_val DB_E2E_DATABASE semitexa_e2e)"
    printf '%s' "${_e2e_db:-semitexa_e2e}"
}

# Why the phase cannot run on its own app here, or nothing when it can.
#   $1 compose binary   $2 compose -f arguments
e2e_isolation_unavailable() {
    case " $2 " in *docker-compose.mysql.yml*) ;; *) printf '%s' "the project runs no bundled MySQL to make the E2E database on"; return 0 ;; esac
    [ -f "$PROJECT_ROOT/docker-compose.e2e.yml" ] || { printf '%s' "docker-compose.e2e.yml is missing (bin/semitexa update brings it)"; return 0; }
    _e2e_live="$(e2e_compose_val DB_DATABASE semitexa)"
    _e2e_test="$(e2e_compose_val DB_TEST_DATABASE semitexa_test)"
    _e2e_name="$(e2e_db_name)"
    case "$_e2e_name" in
        "$_e2e_live"|"$_e2e_test"|mysql|sys|information_schema|performance_schema)
            printf '%s' "DB_E2E_DATABASE '$_e2e_name' is the live, the test or a MySQL system database"
            return 0 ;;
    esac
    case "$(e2e_db_mode)" in
        copy|clean) ;;
        *) printf '%s' "SEMITEXA_E2E_DB '$(e2e_db_mode)' is neither copy nor clean"; return 0 ;;
    esac
    if printf '%s\n' "$_e2e_name" | grep -Eq '[^A-Za-z0-9_]'; then
        printf '%s' "DB_E2E_DATABASE '$_e2e_name' is not a plain identifier"
        return 0
    fi
    # Seeding needs update --no-scaffold (semitexa/update after 2026.11.10.0849):
    # without it the sweep would rewrite the project's scaffold files.
    # shellcheck disable=SC2086
    if ! ( env_export_compose_context; $1 $2 run --rm --no-deps -T app php vendor/bin/semitexa update --help 2>/dev/null < /dev/null ) | grep -q -- '--no-scaffold'; then
        printf '%s' "this project's semitexa/update has no --no-scaffold yet (bin/semitexa update brings it)"
        return 0
    fi
    return 1
}

# The runtime state two servers from one checkout would fight over: the pid
# and worker env (run), the build marker (runtime), compiled caches, locks,
# logs, temp files. Only these get a directory of their own under var/e2e;
# the rest of var/ (storage and uploads, evidence, the project graph) is the
# project's data, which the copied database's rows point at, and stays shared:
# with all of var/ swapped, media, the evidence view and the graph had nothing.
E2E_RUNTIME_DIRS="run runtime cache lock log tmp"

# The env and mounts the E2E app and its seeding run share.
e2e_app_args() {
    _e2e_args="-e DB_DATABASE=$(e2e_db_name) -e CACHE_ENV=e2e -e NATS_QUEUE_STREAM=QUEUE_E2E -e NATS_QUEUE_SUBJECT_PREFIX=e2e.queue. -e LEDGER_STREAM=EVENTS_E2E -e LEDGER_SUBJECT_PREFIX=e2e.events"
    for _e2e_dir in $E2E_RUNTIME_DIRS; do
        # Relative: the script runs from PROJECT_ROOT, and a path with a space
        # in it would split here.
        _e2e_args="$_e2e_args -v ./var/e2e/$_e2e_dir:/var/www/html/var/$_e2e_dir"
    done
    printf '%s' "$_e2e_args"
}

# How the E2E database is filled: copy (default) or clean.
#   copy   a snapshot of the live database, then the schema and data patches:
#          38 specs today read data a developer's database grew through use
#          (pings, leads, CMS users, media rows) and no seed or patch makes;
#          the run writes into the copy, never into the live one.
#   clean  the schema and data patches alone: what a spec that sets up its
#          own data needs, and the target (tk-e2e-specs-own-their-data).
e2e_db_mode() {
    _e2e_mode="${SEMITEXA_E2E_DB:-$(env_val SEMITEXA_E2E_DB copy)}"
    printf '%s' "${_e2e_mode:-copy}"
}

# Outbound work a copy would carry: a job, mail or webhook copied from the
# live database must not be sent again by the E2E app's workers.
E2E_TRUNCATE_TABLES="queue_messages mail_messages mail_attempts webhook_outbox webhook_attempts webhook_inbox replication_outbox replication_outbox_dead scheduler_locks platform_user_password_reset"

# A fresh E2E database every run: dropped, made again, filled as e2e_db_mode
# says, then the schema and data patches (update --no-composer --no-scaffold
# writes no project file).
#   $1 compose binary   $2 compose -f arguments
e2e_database_reset() {
    _e2e_name="$(e2e_db_name)"
    _e2e_live="$(e2e_compose_val DB_DATABASE semitexa)"
    # shellcheck disable=SC2086
    ( env_export_compose_context; $1 $2 exec -T mysql sh -c "mysql -uroot -p\"\$MYSQL_ROOT_PASSWORD\" -e 'DROP DATABASE IF EXISTS $_e2e_name;'" >/dev/null 2>&1 < /dev/null ) \
        || { error "Could not drop the E2E database '$_e2e_name'."; return 1; }
    ensure_test_database "$1" "$2" "$_e2e_name"
    # ensure_test_database warns and returns 0 when it cannot create one: ask MySQL.
    # shellcheck disable=SC2086
    ( env_export_compose_context; $1 $2 exec -T mysql sh -c "mysql -N -uroot -p\"\$MYSQL_ROOT_PASSWORD\" -e \"SELECT SCHEMA_NAME FROM information_schema.SCHEMATA WHERE SCHEMA_NAME = '$_e2e_name'\"" 2>/dev/null < /dev/null ) | grep -qx "$_e2e_name" \
        || { error "The E2E database '$_e2e_name' does not exist after creating it."; return 1; }
    for _e2e_dir in $E2E_RUNTIME_DIRS; do mkdir -p "$PROJECT_ROOT/var/e2e/$_e2e_dir"; done
    if [ "$(e2e_db_mode)" = "copy" ]; then
        info "E2E database '$_e2e_name': a copy of '$_e2e_live'..."
        _e2e_t0="$(date +%s)"
        # One consistent snapshot without locking the app (--single-transaction);
        # no --databases, so no USE of the live schema reaches the import;
        # DEFINER dropped, so a view or routine needs no user of the source.
        # pipefail: a dump that fails part way is a failed copy, never a half one.
        # shellcheck disable=SC2086
        ( env_export_compose_context; $1 $2 exec -T mysql bash -o pipefail -c '
            set -e
            mysqldump -uroot -p"$MYSQL_ROOT_PASSWORD" --single-transaction --quick --routines --triggers --events --set-gtid-purged=OFF --no-tablespaces "$1" 2>/tmp/e2e-dump.err \
              | sed -E "s/DEFINER=\`[^\`]+\`@\`[^\`]+\`//g" \
              | mysql -uroot -p"$MYSQL_ROOT_PASSWORD" "$2" 2>/tmp/e2e-import.err \
              || { grep -v "Using a password" /tmp/e2e-dump.err /tmp/e2e-import.err >&2; exit 1; }
            # A table left with its live outbound rows would be sent again: a
            # TRUNCATE that fails fails the copy.
            for t in $3; do
              if mysql -N -uroot -p"$MYSQL_ROOT_PASSWORD" "$2" -e "SELECT 1 FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = \"$t\"" 2>/dev/null | grep -q 1; then
                mysql -uroot -p"$MYSQL_ROOT_PASSWORD" "$2" -e "TRUNCATE TABLE \`$t\`" 2>/dev/null || { echo "TRUNCATE $t failed" >&2; exit 1; }
              fi
            done' _ "$_e2e_live" "$_e2e_name" "$E2E_TRUNCATE_TABLES" < /dev/null ) \
            || { error "Copying '$_e2e_live' into the E2E database failed; the run would test a partial copy. Retry, or SEMITEXA_E2E_DB=clean."; return 1; }
        info "Copied in $(( $(date +%s) - _e2e_t0 )) s; queued jobs, mail, webhooks and outboxes emptied."
    fi
    info "E2E database '$_e2e_name': schema and data patches..."
    # shellcheck disable=SC2046,SC2086
    ( env_export_compose_context; $1 $2 run --rm --no-deps -T $(e2e_app_args) app php vendor/bin/semitexa update --no-composer --no-scaffold < /dev/null ) \
        || { error "Seeding the E2E database '$_e2e_name' failed."; return 1; }
}

# The E2E app's container name: unique per checkout (two with one directory
# name must not remove each other's app) and starting with a letter, as
# Docker requires. Known before the app starts, so the cleanup trap can be
# set first.
e2e_container_name() {
    printf '%s' "semitexa-e2e-$(basename "$PROJECT_ROOT" | tr -c 'a-zA-Z0-9_.\n-' '-')-$(printf '%s' "$PROJECT_ROOT" | cksum | cut -d' ' -f1)"
}

# Starts the E2E app and waits until it answers; sets E2E_APP_CONTAINER.
# Runs in the caller's shell, not in $(...): a TERM then interrupts the wait
# within a second (the trap runs as the current sleep or probe ends) instead
# of once a command substitution returns (review, installer#80).
#   $1 compose binary   $2 compose -f arguments
e2e_app_start() {
    E2E_APP_CONTAINER=
    _e2e_container="$(e2e_container_name)"
    docker rm -f "$_e2e_container" >/dev/null 2>&1 || true
    # shellcheck disable=SC2046,SC2086
    ( env_export_compose_context; $1 $2 run -d --no-deps --name "$_e2e_container" $(e2e_app_args) app >/dev/null < /dev/null ) \
        || { error "Could not start the E2E app."; return 1; }
    # As Compose resolves it (.env first), the port the app and the runner use (review, update#81).
    _e2e_port="$(e2e_compose_val SWOOLE_PORT 9502)"
    # A deadline in seconds, not a count of probes: a probe can take its full
    # 2 s, so 90 of them with a 1 s pause were ~270 s (review, update#82).
    # E2E_APP_START_TIMEOUT gives a slow machine longer.
    _e2e_wait="${E2E_APP_START_TIMEOUT:-90}"
    case "$_e2e_wait" in ''|*[!0-9]*) _e2e_wait=90 ;; esac
    # Decimal, as written: "08" is not octal to $(( )) (review, installer#81).
    _e2e_wait="$(printf '%s' "$_e2e_wait" | sed 's/^0*//')"
    [ -n "$_e2e_wait" ] || _e2e_wait=0
    _e2e_deadline=$(( $(date +%s) + _e2e_wait ))
    while :; do
        # Bounded: an app that takes the connection and never answers cannot hold the wait.
        docker exec "$_e2e_container" curl -fsS --connect-timeout 1 --max-time 2 -o /dev/null "http://127.0.0.1:${_e2e_port}/" >/dev/null 2>&1 \
            && { E2E_APP_CONTAINER="$_e2e_container"; return 0; }
        [ "$(date +%s)" -ge "$_e2e_deadline" ] && break
        sleep 1
    done
    error "The E2E app did not answer on port $_e2e_port within ${_e2e_wait} s. Its last log lines:"
    docker logs --tail 30 "$_e2e_container" >&2 2>&1 || true
    docker rm -f "$_e2e_container" >/dev/null 2>&1 || true
    return 1
}

# The compose files the test services (phpunit, e2e-runner) are defined by:
# the runtime set plus docker-compose.test.yml. Shared by test:run and the
# ai:verify spec pass, so the two never run a spec against different services.
test_compose_overlays() {
    _tco="$(compose_args)"
    if [ -z "$_tco" ]; then
        _tco="-f docker-compose.yml"
    fi
    _tco="$_tco -f docker-compose.test.yml"
    # Test-side counterpart of docker-compose.path-repos.yml. Mounts the
    # operator-local ./semitexa.pl symlink into the phpunit + e2e-runner
    # services so composer path-repo packages whose source lives outside
    # the project tree (currently semitexa/platform-ui) can be exercised by
    # `bin/semitexa test:run`. Gate matches compose_args (symlink present).
    if [ -f "$PROJECT_ROOT/docker-compose.test.path-repos.yml" ] && [ -L "$PROJECT_ROOT/semitexa.pl" ]; then
        _tco="$_tco -f docker-compose.test.path-repos.yml"
    fi
    printf '%s' "$_tco"
}

# ai:verify runs inside the app, which has no browser and no Docker, so a
# changed Playwright spec was read by no check. The specs the plan names
# (ai:verify --list-e2e) run here first, on the host, in the e2e-runner — and
# only against an app that is ALREADY running: verify never starts, recreates
# or restarts a container (--no-deps). Each outcome is filed under this run's
# id and the spec's content hash, which is what the e2e target inside reads
# (E2eSpecResultCheck); a spec with no result there stays incomplete, and
# host.txt says why when nothing ran.
cmd_ai_verify() {
    # A list is an answer, not a run: nothing is opened for it. One path per line on
    # stdout and nothing else: the proxy's own notes go to stderr (review update#77), and
    # the blank lines its port-conflict advice prints are dropped from the list.
    for _varg in "$@"; do
        case "$_varg" in --list-e2e|--list-pages)
            _vlist="$(
                info() { printf "%s[INFO]%s  %s\n" "$C_CYAN" "$C_RESET" "$*" >&2; }
                cmd_proxy ai:verify "$@"
            )" || _vlist_rc=$?
            printf '%s\n' "$_vlist" | grep -v '^[[:space:]]*$' || true
            return "${_vlist_rc:-0}" ;;
        esac
    done
    _vrun="$(date +%s)-$$"
    _vdir="$PROJECT_ROOT/var/run/verify-e2e/$_vrun"
    SEMITEXA_VERIFY_E2E_RUN="$_vrun"
    export SEMITEXA_VERIFY_E2E_RUN
    if ! mkdir -p "$_vdir" 2>/dev/null; then
        warn "Could not create $_vdir; changed E2E specs will be reported as not run."
        cmd_proxy ai:verify "$@"
        return $?
    fi
    # Other agents verify in parallel: only results nobody can still be reading go.
    find "$PROJECT_ROOT/var/run/verify-e2e" -mindepth 1 -maxdepth 1 -type d -mmin +1440 -exec rm -rf {} + 2>/dev/null || true

    # --diff-stdin reads the path list from stdin, and it is read twice here.
    _vstdin=""
    for _varg in "$@"; do
        if [ "$_varg" = "--diff-stdin" ]; then _vstdin="$_vdir/stdin"; fi
    done
    [ -z "$_vstdin" ] || cat > "$_vstdin"

    if ! has_compose || ! is_app_running; then
        printf '%s\n' "the app is not running, and verify never starts it (bin/semitexa server:start, then run ai:verify again)" > "$_vdir/host.txt"
    elif [ ! -f "$PROJECT_ROOT/docker-compose.test.yml" ]; then
        printf '%s\n' "docker-compose.test.yml is missing, so there is no e2e-runner to run it in" > "$_vdir/host.txt"
    else
        _vlist_rc=0
        if [ -n "$_vstdin" ]; then
            _vspecs="$(run_compose exec -T $(agent_env_args) app php vendor/bin/semitexa ai:verify "$@" --list-e2e < "$_vstdin" 2>/dev/null)" || _vlist_rc=$?
        else
            _vspecs="$(run_compose exec -T $(agent_env_args) app php vendor/bin/semitexa ai:verify "$@" --list-e2e < /dev/null 2>/dev/null)" || _vlist_rc=$?
        fi
        if [ "$_vlist_rc" -ne 0 ]; then
            printf '%s\n' "asking the app which specs changed failed (ai:verify --list-e2e exited $_vlist_rc)" > "$_vdir/host.txt"
            _vspecs=""
        fi
        _vcompose="$(compose_bin)"
        _voverlays="$(test_compose_overlays)"
        # One path per line, taken literally: no splitting on spaces, no globbing.
        _vifs="$IFS"
        IFS='
'
        set -f
        for _vspec in $_vspecs; do
            case "$_vspec" in
                */tests/E2E/*.spec.ts) ;;
                *) continue ;;
            esac
            [ -f "$PROJECT_ROOT/$_vspec" ] || continue
            # The file name the e2e target reads: sha256 of the path, a dash,
            # sha256 of the content (E2eSpecResultCheck::key()).
            if command -v sha256sum >/dev/null 2>&1; then
                _vsha="$(printf '%s' "$_vspec" | sha256sum | cut -d' ' -f1)-$(sha256sum "$PROJECT_ROOT/$_vspec" | cut -d' ' -f1)"
            else
                _vsha="$(printf '%s' "$_vspec" | shasum -a 256 | cut -d' ' -f1)-$(shasum -a 256 "$PROJECT_ROOT/$_vspec" | cut -d' ' -f1)"
            fi
            info "Running changed E2E spec on the host: $_vspec" >&2
            _vrc=0
            (
                # The compose command and its -f list are split on spaces.
                IFS="$_vifs"
                set +f
                env_export_compose_context
                # shellcheck disable=SC2086
                $_vcompose $_voverlays run --rm --no-deps -T e2e-runner npx --no-install playwright test --config=playwright.config.ts --reporter=line --output=/tmp/pw "$_vspec"
            ) > "$_vdir/$_vsha.log" 2>&1 < /dev/null || _vrc=$?
            printf '%s\n' "$_vrc" > "$_vdir/$_vsha.exit"
        done
        set +f
        IFS="$_vifs"

        # The pages a changed template or stylesheet shows on (ai:verify --list-pages),
        # opened in light and dark by the page check semitexa/dev ships. Filed under
        # pages/ for PageCheckResult; pages.txt says why when nothing was opened.
        _vpcfg="vendor/semitexa/dev/resources/page-check/playwright.config.ts"
        _vpages=""
        _vpages_rc=0
        if [ ! -f "$PROJECT_ROOT/$_vpcfg" ]; then
            printf '%s\n' "this semitexa/dev has no page check ($_vpcfg is missing)" > "$_vdir/pages.txt"
        elif [ -n "$_vstdin" ]; then
            _vpages="$(run_compose exec -T $(agent_env_args) app php vendor/bin/semitexa ai:verify "$@" --list-pages < "$_vstdin" 2>/dev/null)" || _vpages_rc=$?
        else
            _vpages="$(run_compose exec -T $(agent_env_args) app php vendor/bin/semitexa ai:verify "$@" --list-pages < /dev/null 2>/dev/null)" || _vpages_rc=$?
        fi
        if [ "$_vpages_rc" -ne 0 ]; then
            printf '%s\n' "asking the app which pages to open failed (ai:verify --list-pages exited $_vpages_rc)" > "$_vdir/pages.txt"
            _vpages=""
        fi
        if [ -n "$_vpages" ]; then
            info "Opening the changed pages in light and dark on the host" >&2
            _vpages_run=0
            (
                env_export_compose_context
                # shellcheck disable=SC2086
                $_vcompose $_voverlays run --rm --no-deps -T \
                    -e PAGE_CHECK_PAGES="$_vpages" \
                    -e PAGE_CHECK_OUT="/var/www/html/var/run/verify-e2e/$_vrun/pages" \
                    e2e-runner npx --no-install playwright test --config="$_vpcfg"
            ) > "$_vdir/pages.log" 2>&1 < /dev/null || _vpages_run=$?
            # A page's finding exits non-zero too: what counts is whether any page was filed.
            # The spec makes pages/ before it opens anything, so the directory proves nothing.
            if ! ls "$_vdir/pages/"*.json >/dev/null 2>&1; then
                printf '%s\n' "the page check exited $_vpages_run and filed no page; its log is var/run/verify-e2e/$_vrun/pages.log" > "$_vdir/pages.txt"
            fi
        elif [ "$_vpages_rc" -eq 0 ] && [ -f "$PROJECT_ROOT/$_vpcfg" ]; then
            printf '%s\n' "ai:verify --list-pages named no page: no public GET route with no parameter shows this change" > "$_vdir/pages.txt"
        fi
    fi

    if [ -n "$_vstdin" ]; then
        cmd_proxy ai:verify "$@" < "$_vstdin"
    else
        cmd_proxy ai:verify "$@"
    fi
}

cmd_proxy() {
    # The wrapper's own lines go to stderr: stdout is the command's, and a
    # --json caller parses it whole (tk-cli-info-line-on-stdout-with-json).
    if command -v php >/dev/null 2>&1; then
        if [ -f "$PROJECT_ROOT/vendor/bin/semitexa" ]; then
            if is_app_running; then
                if [ -t 0 ] && [ -t 1 ]; then run_compose exec $(agent_env_args) app php vendor/bin/semitexa "$@"; else run_compose exec $(agent_env_args) -T app php vendor/bin/semitexa "$@"; fi
            elif has_compose; then
                if env_runtime_file_exists; then
                    # CLI commands don't need a long-running, port-publishing
                    # app server. If SWOOLE_PORT is currently free we can still
                    # use a one-off container; if it is bound, we *also* use a
                    # one-off container (compose `run` does not publish ports),
                    # but first emit an ownership-aware advisory so the
                    # operator knows the long-running server can't start.
                    _swoole_port="$(env_val SWOOLE_PORT '')"
                    if [ -n "$_swoole_port" ] && port_in_use_on_host "$_swoole_port"; then
                        _our_compose="$(proxy_compose_project_name)"
                        _our_app_id="$(env_val SEMITEXA_APP_ID '')"
                        warn "App container is not running for this project, and SWOOLE_PORT=$_swoole_port is held by another owner."
                        # Diagnosis returns non-zero, but we continue because
                        # the CLI command does not need a published port.
                        proxy_diagnose_port_conflict "$_swoole_port" "$_our_compose" "$_our_app_id" >&2 || true
                        printf "\n" >&2
                        info "Running this command in a one-off container (no host port published)." >&2
                        proxy_run_one_off_app "$@"
                        return $?
                    fi

                    info "App container is not running; using a one-off container for this CLI command..." >&2
                    proxy_run_one_off_app "$@"
                    return $?
                else
                    info "Running locally with PHP (no Semitexa env files for Docker)..." >&2
                    php "$PROJECT_ROOT/vendor/bin/semitexa" "$@"
                fi
            else
                info "Running locally with PHP (Docker not available)..." >&2
                php "$PROJECT_ROOT/vendor/bin/semitexa" "$@"
            fi
        else
            error "vendor/bin/semitexa not found. Run: bin/semitexa install"
            exit 1
        fi
    else
        if has_compose; then
            if is_app_running; then
                if [ -t 0 ] && [ -t 1 ]; then run_compose exec $(agent_env_args) app php vendor/bin/semitexa "$@"; else run_compose exec $(agent_env_args) -T app php vendor/bin/semitexa "$@"; fi
            elif env_runtime_file_exists; then
                _swoole_port="$(env_val SWOOLE_PORT '')"
                if [ -n "$_swoole_port" ] && port_in_use_on_host "$_swoole_port"; then
                    _our_compose="$(proxy_compose_project_name)"
                    _our_app_id="$(env_val SEMITEXA_APP_ID '')"
                    warn "App container is not running and SWOOLE_PORT=$_swoole_port is held by another owner."
                    proxy_diagnose_port_conflict "$_swoole_port" "$_our_compose" "$_our_app_id" >&2 || true
                    printf "\n" >&2
                    info "Running this command in a one-off container (no host port published)." >&2
                fi
                proxy_run_one_off_app "$@"
            else
                error "App container is not running."
                info "Start with: bin/semitexa server:start" >&2
                exit 1
            fi
        else
            error "PHP is not available and Docker is not running."
            info "Either start Docker and run: bin/semitexa server:start" >&2
            info "Or install PHP locally" >&2
            exit 1
        fi
    fi
}

# ═══════════════════════════════════════════════════════════════════════
# Tests source this file to exercise individual helper functions in
# isolation (e.g. `proxy_diagnose_port_conflict_render`). When sourced with
# SEMITEXA_BIN_SOURCE_ONLY=1, skip the dispatch so no command is run.
if [ "${SEMITEXA_BIN_SOURCE_ONLY:-0}" = "1" ]; then
    return 0 2>/dev/null || exit 0
fi

agent_identity
COMMAND="${1:-}"
[ -z "$COMMAND" ] && { cmd_list; exit 0; }
shift
# Handle help BEFORE dispatching native commands (especially restart/install).
# test:run owns PHPUnit's help and listing modes, not the framework's help.
if [ "$COMMAND" != "test:run" ]; then
    for _information_arg in "$@"; do
        case "$_information_arg" in
            --) break ;;
            -V|--version)
                cmd_information vendor/bin/semitexa --version
                exit $?
                ;;
            -h|--help)
                case "$COMMAND" in
                    list|server:*|local-router:*|local-domain:*|local-app:*|install|demo:install|init|self-test|lint:skin-legacy|lint:skin-tokens)
                        printf 'Usage: bin/semitexa %s [options]\n' "$COMMAND"
                        cmd_list --shell-only
                        ;;
                    *) cmd_information vendor/bin/semitexa "$COMMAND" "$@" ;;
                esac
                exit $?
                ;;
        esac
    done
fi
case "$COMMAND" in
    server:start)    cmd_server_start "$@" ;;
    server:stop)     cmd_server_stop "$@" ;;
    server:restart)  _svc=""; while [ $# -gt 0 ]; do case "$1" in --service=*) _svc="${1#--service=}" ;; -s) shift; _svc="${1:-}" ;; *) _svc="$1" ;; esac; shift; done; cmd_server_restart "$_svc" ;;
    local-router:init) cmd_local_router_init "$@" ;;
    local-router:start) cmd_local_router_start "$@" ;;
    local-router:stop) cmd_local_router_stop "$@" ;;
    local-router:restart) cmd_local_router_restart "$@" ;;
    local-router:doctor) cmd_local_router_doctor "$@" ;;
    local-domain:mode) cmd_local_domain_mode "$@" ;;
    local-domain:add) cmd_local_domain_add "$@" ;;
    local-domain:remove) cmd_local_domain_remove "$@" ;;
    local-domain:list) cmd_local_domain_list "$@" ;;
    local-app:register) cmd_local_app_register "$@" ;;
    local-app:reconcile) cmd_local_app_reconcile "$@" ;;
    local-app:list) cmd_local_app_list "$@" ;;
    local-app:remove) cmd_local_app_remove "$@" ;;
    local-app:doctor) cmd_local_app_doctor "$@" ;;
    lint:skin-legacy) cmd_lint_skin_legacy "$@" ;;
    lint:skin-tokens) cmd_lint_skin_tokens "$@" ;;
    install)         cmd_install "$@" ;;
    demo:install)    cmd_demo_install "$@" ;;
    test:run)        cmd_test_run "$@" ;;
    ai:verify)       cmd_ai_verify "$@" ;;
    --help|-h)       cmd_list --shell-only ;;
    --version|-V)    cmd_information vendor/bin/semitexa --version ;;
    help)           if [ $# -eq 0 ]; then cmd_list --shell-only; else cmd_information vendor/bin/semitexa help "$@"; fi ;;
    list)           cmd_list "$@" ;;
    self-test)       cmd_self_test "$@" ;;
    mcp)             cmd_mcp "$@" ;;
    mcp:config)      cmd_mcp_config "$@" ;;
    init)            cmd_init "$@" ;;
    *)               cmd_proxy "$COMMAND" "$@" ;;
esac
