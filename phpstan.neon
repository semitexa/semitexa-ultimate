# PHPStan for a Semitexa project.
#
# The rules below are Semitexa's own — they ship inside semitexa/core and
# enforce the framework's architecture, not general PHP hygiene: that
# dependencies arrive through #[InjectAsReadonly] rather than a constructor,
# that a handler returns a response, that a package's absence is expressed as a
# composer requirement rather than a runtime class_exists(). Breaking one of
# them produces code that looks fine and fails at boot or under load.
#
# They shipped with the framework long before anything wired them up here. Add
# your own paths below; `src` is the whole of an ordinary project.

includes:
    # Delete this line until you have generated a baseline, or PHPStan will
    # refuse to start. See "Existing projects" at the bottom of this file.
    # - phpstan-baseline.neon

rules:
    - Semitexa\Core\PHPStan\Rules\InjectionViaConstructorRule
    - Semitexa\Core\PHPStan\Rules\ConfigOnClassTypeRule
    - Semitexa\Core\PHPStan\Rules\ConfigOnArrayTypeRule
    - Semitexa\Core\PHPStan\Rules\InjectOnScalarTypeRule
    - Semitexa\Core\PHPStan\Rules\StaticContainerAccessRule
    - Semitexa\Core\PHPStan\Rules\UnannotatedServicePropertyRule
    - Semitexa\Core\PHPStan\Rules\InjectedPropertyVisibilityRule
    - Semitexa\Core\PHPStan\Rules\ExecutionScopedWithoutAttributeRule
    - Semitexa\Core\PHPStan\Rules\DirectResponseConstructionRule
    - Semitexa\Core\PHPStan\Rules\HandlerReturnsResponseRule
    - Semitexa\Core\PHPStan\Rules\ExplicitOptionalDependencyRule
    - Semitexa\Core\PHPStan\Rules\EventListenerMissingExecutionRule
    - Semitexa\Core\PHPStan\Rules\DiscoveryCallSiteRule
    - Semitexa\Core\PHPStan\Rules\FactoryStringKeyRule
    - Semitexa\Core\PHPStan\Rules\FactoryContractRule
    - Semitexa\Core\PHPStan\Rules\FactoryClosedWorldRule
    - Semitexa\Core\PHPStan\Rules\TraitInjectionRule
    - Semitexa\Core\PHPStan\Rules\ModuleContractOwnershipRule
    - Semitexa\Core\PHPStan\Rules\DisallowErrorLogRule

parameters:
    level: max

    paths:
        - src

    excludePaths:
        - vendor
        - var

    # Registers PSR-4 for local modules (src/modules/<Name>/src). The runtime
    # does this in a build phase that PHPStan never runs, so without the shim
    # the analyser cannot resolve your own module classes.
    bootstrapFiles:
        - vendor/autoload.php
        - phpstan-bootstrap.php

# Existing projects
# -----------------
# A codebase that predates this config will not be clean on day one. Generate a
# baseline once, uncomment the include above, and then treat it as frozen:
#
#   composer phpstan -- --generate-baseline
#
# `composer phpstan:strict` then fails whenever an entry in that baseline stops
# matching a real error — which is how a baseline stays a record of known debt
# instead of a place new errors quietly land.
